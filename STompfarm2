local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local playersFolder = Workspace:WaitForChild("Players")

---------------------------------------------------------------------
-- SETTINGS
---------------------------------------------------------------------

local TELEPORT_INTERVAL = 0.1
local STOMP_INTERVAL = 0.1

---------------------------------------------------------------------
-- REMOTES
---------------------------------------------------------------------

local AdminEvent = ReplicatedStorage
    :WaitForChild("NewAdminRemotes")
    :WaitForChild("AdminAction")

local MainEvent = ReplicatedStorage
    :WaitForChild("MainRemotes")
    :WaitForChild("MainRemoteEvent")

---------------------------------------------------------------------
-- STATE
---------------------------------------------------------------------

local currentTarget = nil

local teleportTimer = 0
local stompTimer = 0

-- Becomes true whenever somebody is dead / still respawning.
local waitingForRespawn = false

---------------------------------------------------------------------
-- LOCAL CHARACTER
---------------------------------------------------------------------

local function getLocalRoot()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
end

---------------------------------------------------------------------
-- TARGET HELPERS
---------------------------------------------------------------------

local function getTargetTorso(model)
    if not model then
        return nil
    end

    -- Prefer the actual torso
    return model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
end

local function getTargetHumanoid(model)
    if not model then
        return nil
    end

    return model:FindFirstChildOfClass("Humanoid")
end

local function isTargetAlive(model)
    if not model or not model.Parent then
        return false
    end

    local humanoid = getTargetHumanoid(model)
    local torso = getTargetTorso(model)

    if not humanoid or not torso then
        return false
    end

    return humanoid.Health > 0
end

---------------------------------------------------------------------
-- GET NEXT TARGET
---------------------------------------------------------------------

local function getNextTarget()
    for _, model in ipairs(playersFolder:GetChildren()) do
        if model:IsA("Model")
            and model.Name ~= LocalPlayer.Name
        then

            ---------------------------------------------------------
            -- NEVER target stomped players
            ---------------------------------------------------------

            if model:GetAttribute("Stomped") ~= true then
                local humanoid = getTargetHumanoid(model)
                local torso = getTargetTorso(model)

                if humanoid
                    and humanoid.Health > 0
                    and torso
                then
                    return model
                end
            end
        end
    end

    return nil
end

---------------------------------------------------------------------
-- CHECK IF EVERY PLAYER HAS RESPAWNED
---------------------------------------------------------------------

local function allPlayersRespawned()
    local foundOtherPlayer = false

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            foundOtherPlayer = true

            ---------------------------------------------------------
            -- Find their current model inside workspace.Players
            ---------------------------------------------------------

            local model = playersFolder:FindFirstChild(player.Name)

            if not model or not model:IsA("Model") then
                return false
            end

            local humanoid = getTargetHumanoid(model)
            local torso = getTargetTorso(model)

            ---------------------------------------------------------
            -- Not fully respawned yet
            ---------------------------------------------------------

            if not humanoid
                or humanoid.Health <= 0
                or not torso
            then
                return false
            end
        end
    end

    return foundOtherPlayer
end

---------------------------------------------------------------------
-- KNOCK ALL
---------------------------------------------------------------------

local function knockAll()
    pcall(function()
        AdminEvent:FireServer(
            "KnockAll",
            {}
        )
    end)

    print("[AutoStomp] Everyone respawned -> KnockAll")
end

---------------------------------------------------------------------
-- STOMP
---------------------------------------------------------------------

local function stomp()
    pcall(function()
        MainEvent:FireServer(
            "Stomp"
        )
    end)
end

---------------------------------------------------------------------
-- MAIN LOOP
---------------------------------------------------------------------

RunService.Heartbeat:Connect(function(dt)

    -----------------------------------------------------------------
    -- RESPAWN CHECK
    -----------------------------------------------------------------

    if not allPlayersRespawned() then

        -- At least one person is dead / missing / respawning
        waitingForRespawn = true

    elseif waitingForRespawn then

        -------------------------------------------------------------
        -- Everyone who was dead has now fully respawned
        -------------------------------------------------------------

        waitingForRespawn = false

        -- Drop old target because models may have been replaced
        currentTarget = nil

        teleportTimer = 0
        stompTimer = 0

        -------------------------------------------------------------
        -- Knock everyone ONCE
        -------------------------------------------------------------

        knockAll()
    end

    -----------------------------------------------------------------
    -- FIND TARGET
    -----------------------------------------------------------------

    if not currentTarget then
        currentTarget = getNextTarget()

        teleportTimer = 0
        stompTimer = 0

        if not currentTarget then
            return
        end

        print("[AutoStomp] Target:", currentTarget.Name)
    end

    -----------------------------------------------------------------
    -- TARGET MODEL DISAPPEARED
    -----------------------------------------------------------------

    if not currentTarget.Parent then
        currentTarget = nil
        teleportTimer = 0
        stompTimer = 0

        return
    end

    -----------------------------------------------------------------
    -- IMPORTANT:
    -- IF THEY ARE STOMPED, IMMEDIATELY STOP TARGETING THEM
    -----------------------------------------------------------------

    if currentTarget:GetAttribute("Stomped") == true then
        print("[AutoStomp] Stomped:", currentTarget.Name)

        currentTarget = nil
        teleportTimer = 0
        stompTimer = 0

        return
    end

    -----------------------------------------------------------------
    -- CHECK TARGET HEALTH
    -----------------------------------------------------------------

    local targetHumanoid = getTargetHumanoid(currentTarget)

    if not targetHumanoid or targetHumanoid.Health <= 0 then
        currentTarget = nil
        teleportTimer = 0
        stompTimer = 0

        return
    end

    -----------------------------------------------------------------
    -- TIMERS
    -----------------------------------------------------------------

    teleportTimer += dt
    stompTimer += dt

    -----------------------------------------------------------------
    -- TELEPORT EVERY 0.1
    -----------------------------------------------------------------

    if teleportTimer >= TELEPORT_INTERVAL then
        teleportTimer = 0

        -------------------------------------------------------------
        -- CHECK STOMPED AGAIN IMMEDIATELY BEFORE TELEPORT
        -------------------------------------------------------------

        if currentTarget:GetAttribute("Stomped") == true then
            currentTarget = nil
            stompTimer = 0

            return
        end

        local myRoot = getLocalRoot()
        local torso = getTargetTorso(currentTarget)

        if not myRoot or not torso then
            return
        end

        -------------------------------------------------------------
        -- KEEP CURRENT ROTATION
        -------------------------------------------------------------

        local rx, ry, rz =
            myRoot.CFrame:ToEulerAnglesXYZ()

        -------------------------------------------------------------
        -- INSTANT TELEPORT DIRECTLY ONTO THEIR TORSO
        -- NO Y OFFSET
        -- NO TWEEN
        -------------------------------------------------------------

        myRoot.CFrame =
            CFrame.new(torso.Position)
            * CFrame.Angles(rx, ry, rz)
    end

    -----------------------------------------------------------------
    -- STOMP EVERY 0.1
    -----------------------------------------------------------------

    if stompTimer >= STOMP_INTERVAL then
        stompTimer = 0

        -------------------------------------------------------------
        -- Don't stomp after they've already been marked stomped
        -------------------------------------------------------------

        if currentTarget:GetAttribute("Stomped") ~= true then
            stomp()
        else
            currentTarget = nil
        end
    end
end)
