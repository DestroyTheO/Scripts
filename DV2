function RuntimeState:DeleteOrbReward(
	Object
)
	if not Object
		or not Object.Parent
		or Object == self.OrbFolder
		or self.OrbPendingDeletes[
			Object
		] then
		return
	end

	self.OrbPendingDeletes[Object] =
		true

	-- ClientOrbRewards can be the only replicated evidence of a drop.
	-- Give the detector a brief window to read late attributes/children,
	-- then destroy the reward as requested.
	local Delay =
		SecretWatch.Enabled
			and 0.4
			or 0

	if SecretWatch.Enabled
		and type(
			SecretWatch.ScheduleSignalInspection
		) == "function" then
		SecretWatch:
			ScheduleSignalInspection(
				Object,
				"ClientOrbRewards",
				0.05
			)
	end

	task.delay(Delay, function()
		if SecretWatch.Enabled
			and type(
				SecretWatch.InspectSignalObject
			) == "function"
			and Object.Parent then
			SecretWatch:
				InspectSignalObject(
					Object,
					"ClientOrbRewards"
				)
		end

		local Deleted =
			pcall(function()
				if Object.Parent then
					Object:Destroy()
				end
			end)

		if Deleted then
			self.OrbRewardsDeleted += 1
		end

		self.OrbPendingDeletes[Object] =
			nil
	end)
end

function RuntimeState:BindOrbRewardFolder(
	Folder
)
	if not Folder
		or not Folder.Parent
		or Folder.Name
			~= "ClientOrbRewards" then
		return
	end

	if self.OrbFolderConnection then
		pcall(function()
			self.OrbFolderConnection:
				Disconnect()
		end)

		self.OrbFolderConnection =
			nil
	end

	self.OrbFolder = Folder

	-- Delete everything already stored in the folder.
	for _, Object in ipairs(
		Folder:GetChildren()
	) do
		self:DeleteOrbReward(
			Object
		)
	end

	-- Delete each new reward immediately without polling the folder.
	self.OrbFolderConnection =
		TrackRuntimeConnection(
			Folder.ChildAdded:Connect(
				function(Object)
					self:DeleteOrbReward(
						Object
					)
				end
			)
		)
end

function RuntimeState:StartOrbRewardCleaner()
	local ExistingFolder =
		Workspace:FindFirstChild(
			"ClientOrbRewards"
		)

	if ExistingFolder then
		self:BindOrbRewardFolder(
			ExistingFolder
		)
	end

	-- Rebind automatically if the game destroys and recreates the folder.
	self.OrbWorkspaceConnection =
		TrackRuntimeConnection(
			Workspace.ChildAdded:Connect(
				function(Object)
					if Object.Name
						~= "ClientOrbRewards" then
						return
					end

					task.defer(function()
						if Object.Parent then
							self:
								BindOrbRewardFolder(
									Object
								)
						end
					end)
				end
			)
		)
end

