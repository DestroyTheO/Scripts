		if Success
			and typeof(WorldPivot)
				== "CFrame" then
			return WorldPivot
		end

		Success, WorldPivot =
			pcall(function()
				return Object.WorldPivot
			end)

		if Success
			and typeof(WorldPivot)
				== "CFrame" then
			return WorldPivot
		end
	end

	if Object:IsA("BasePart") then
		return Object.CFrame
	end

	return nil
end

function NPCSystem:GetFolder(
	FolderName
)
	local NPCS =
		Workspace:FindFirstChild("NPCS")
		or Workspace:FindFirstChild("NPCs")
		or Workspace:FindFirstChild("Npcs")

	if not NPCS then
		return nil
	end

	return NPCS:FindFirstChild(
		FolderName
	)
end

function NPCSystem:BuildItems(
	FolderName
)
	local Folder =
		self:GetFolder(
			FolderName
		)

	local Items = {}

	if not Folder then
		return {
			"No "
				.. FolderName
				.. " NPCs Found",
		}
	end

	local Candidates = {}

	for _, Object in ipairs(
		Folder:GetChildren()
	) do
		if Object:IsA("Model")
			or Object:IsA("BasePart") then
			table.insert(
				Candidates,
				Object
			)
		end
	end

	for _, Object in ipairs(
		Folder:GetDescendants()
	) do
		if (
			Object:IsA("Model")
			or Object:IsA("BasePart")
		)
			and Object.Parent ~= Folder then
			local InsideCandidate =
				false

			local Parent =
				Object.Parent

			while Parent
				and Parent ~= Folder do
				if (
					Parent:IsA("Model")
					or Parent:IsA(
						"BasePart"
					)
				)
					and self:GetWorldPivot(
						Parent
					) then
					InsideCandidate =
						true
					break
				end

				Parent = Parent.Parent
			end

			if not InsideCandidate then
				table.insert(
					Candidates,
					Object
				)
			end
		end
	end

	table.sort(
		Candidates,
		function(A, B)
			return string.lower(A.Name)
				< string.lower(B.Name)
		end
	)

	local NameCounts = {}

	for _, Object in ipairs(
		Candidates
	) do
		if self:GetWorldPivot(
			Object
		) then
			local BaseName =
				Object.Name

			NameCounts[BaseName] =
				(NameCounts[BaseName] or 0)
				+ 1

			local DisplayName =
				BaseName

			if NameCounts[BaseName] > 1 then
				DisplayName =
					BaseName
					.. " ["
					.. tostring(
						NameCounts[
							BaseName
						]
					)
					.. "]"
			end

			self.Objects[
				FolderName
					.. "::"
					.. DisplayName
			] = Object

			table.insert(
				Items,
				DisplayName
			)
		end
	end

	if #Items == 0 then
		return {
			"No "
				.. FolderName
				.. " NPCs Found",
		}
	end

	return Items
end

function NPCSystem:ResolveLive(
	FolderName,
	DisplayName
)
	local Folder =
		self:GetFolder(
			FolderName
		)

	if not Folder then
		return nil
	end

	local DisplayText =
		tostring(
			DisplayName or ""
		)

	local RequestedBaseName =
		DisplayText:gsub(
			"%s+%[%d+%]$",
			""
		)

	local RequestedIndex =
		tonumber(
			DisplayText:match(
				"%[(%d+)%]$"
			)
		) or 1

	local MatchIndex = 0

	for _, Object in ipairs(
		Folder:GetDescendants()
	) do
		if (
			Object:IsA("Model")
			or Object:IsA("BasePart")
		)
			and Object.Name
				== RequestedBaseName
			and self:GetWorldPivot(
				Object
			) then
			local NestedInsideSameNamedCandidate =
				false

			local Parent =
				Object.Parent

			while Parent
				and Parent ~= Folder do
				if (
					Parent:IsA("Model")
					or Parent:IsA(
						"BasePart"
					)
				)
					and Parent.Name
						== RequestedBaseName
					and self:GetWorldPivot(
						Parent
					) then
					NestedInsideSameNamedCandidate =
						true
					break
				end

				Parent = Parent.Parent
			end

			if not NestedInsideSameNamedCandidate then
				MatchIndex += 1

				if MatchIndex
					== RequestedIndex then
					return Object
				end
			end
		end
	end

	return nil
end

function NPCSystem:Teleport(
	FolderName,
	DisplayName
)
	local LookupKey =
		FolderName
			.. "::"
			.. DisplayName

	local NPC =
		self.Objects[
			LookupKey
		]

	if not NPC or not NPC.Parent then
		NPC =
			self:ResolveLive(
				FolderName,
				DisplayName
			)

		if NPC then
			self.Objects[
				LookupKey
			] = NPC
		end
	end

	if not NPC or not NPC.Parent then
		pcall(function()
			Window:Warning(
				"NPC Teleport",
				"Could not find "
					.. tostring(
						DisplayName
					)
					.. " in the current "
					.. tostring(
						FolderName
					)
					.. " folder.",
				4
			)
		end)

		return
	end

	local Character =
		GetCharacter()

	local Root =
		GetRoot()

	local WorldPivot =
		self:GetWorldPivot(
			NPC
		)

	if not Character
		or not Root
		or not WorldPivot then
		return
	end

	if FlyState.Enabled then
		SetFlyEnabled(false)
	end

	if IsAnyFarmEnabled() then
		if UIState.MainFollowToggleControl then
			UIState.MainFollowToggleControl:Set(
				false,
				true
			)
		end

		if UIState.MultiFarmToggleControl then
			UIState.MultiFarmToggleControl:Set(
				false,
				true
			)
		end

		if UIState.KillAllToggleControl then
			UIState.KillAllToggleControl:Set(
				false,
				true
			)
		end

		StopFarmModesWithoutReset()
	end

	Root.Anchored = false
	Root.AssemblyLinearVelocity =
		Vector3.zero
	Root.AssemblyAngularVelocity =
		Vector3.zero

	local Success =
		ApplyVerifiedCharacterPivot(
			Character,
			Root,
			WorldPivot
		)

	if not Success then
		pcall(function()
			Window:Warning(
				"NPC Teleport",
				"Pivot verification failed for "
					.. NPC.Name
					.. ".",
				4
			)
		end)

		return
	end

	pcall(function()
		Window:Success(
			"NPC Teleport",
			"Teleported to "
				.. NPC.Name
				.. ".",
			3
		)
	end)
end

