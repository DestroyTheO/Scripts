-- Use VenturaUI's current runtime lifecycle so a manual rerun or
-- Library:UnloadAll() cleans the controller instead of leaving old
-- Heartbeat, PreSimulation, inventory, and workspace listeners alive.
if type(Window.RegisterCleanup) == "function" then
	Window:RegisterCleanup(
		function()
			if ScriptToken
				== Environment.__CrimmyAutoEnemyController then
				Environment.__CrimmyAutoEnemyController +=
					1
			end

			ProfilerState.Enabled = false

			pcall(function()
				StopFarmModesWithoutReset()
			end)

			pcall(function()
				if FlyState.Enabled then
					SetFlyEnabled(false)
				end
			end)

			pcall(function()
				SecretWatch:
					DisconnectCharacterWatchers()
				DisconnectWeaponInventoryWatchers()
				StopMobScanning()
				RestoreCollisions()
				ReleaseHumanoidState()
			end)

			DisconnectRuntimeConnections()
		end,
		"Crimmy Enemy Controller Runtime"
	)
end

