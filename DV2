local function UpdateLagProfilerUI(
	Now,
	Force
)
	Now = tonumber(Now)
		or os.clock()

	if not Force
		and Now
			- ProfilerState.LastUIUpdate
			< ProfilerState.UpdateInterval then
		return
	end

	ProfilerState.LastUIUpdate = Now

	if not ProfilerState.Enabled then
		local TopText =
			"Top Lag Source: Disabled"

		local BreakdownText =
			"Exclusive Avg/Max ms — profiler disabled"

		local CountersText =
			"Frame 0 ms  |  Max Frame 0 ms  |  Slow Frames 0  |  Resolve 0  |  Reused 0  |  Cache Cleans 0  |  Removed 0  |  PivotTo 0  |  Skipped 0  |  Pivot Fallbacks 0  |  Pivot Failures 0"

		pcall(function()
			if TopText
				~= ProfilerState.LastTopText
				and UIState.ProfilerTop
				and type(
					UIState.ProfilerTop.SetText
				) == "function" then
				ProfilerState.LastTopText =
					TopText
				UIState.ProfilerTop:SetText(
					TopText
				)
			end

			if BreakdownText
				~= ProfilerState.LastBreakdownText
				and UIState.ProfilerBreakdown
				and type(
					UIState.ProfilerBreakdown.SetText
				) == "function" then
				ProfilerState.LastBreakdownText =
					BreakdownText
				UIState.ProfilerBreakdown:SetText(
					BreakdownText
				)
			end

			if CountersText
				~= ProfilerState.LastCountersText
				and UIState.ProfilerCounters
				and type(
					UIState.ProfilerCounters.SetText
				) == "function" then
				ProfilerState.LastCountersText =
					CountersText
				UIState.ProfilerCounters:SetText(
					CountersText
				)
			end
		end)

		return
	end

	local TopName = "None"
	local TopScore = 0
	local TopAverage = 0
	local TopMax = 0
	local TopLoad = 0
	local TotalSlowCalls = 0

	for _, Name in ipairs(
		ProfilerState.Order
	) do
		local Record =
			ProfilerState.Records[Name]

		local Calls =
			Record.WindowCalls

		local Average =
			Calls > 0
				and (
					Record.WindowTotalMs
					/ Calls
				)
				or 0

		Record.LastLoadMs =
			Record.WindowTotalMs
		Record.LastAverageMs =
			Average
		Record.LastMaxMs =
			Record.WindowMaxMs
		Record.LastCalls =
			Calls
		Record.LastSlowCalls =
			Record.WindowSlowCalls

		TotalSlowCalls +=
			Record.WindowSlowCalls

		-- Total measured milliseconds per update window identifies
		-- frequent moderate work as well as isolated spikes.
		local Score =
			Record.WindowTotalMs
			+ Record.WindowMaxMs
				* 0.25

		if Score > TopScore then
			TopScore = Score
			TopName = Name
			TopAverage = Average
			TopMax =
				Record.WindowMaxMs
			TopLoad =
				Record.WindowTotalMs
		end

		Record.WindowTotalMs = 0
		Record.WindowCalls = 0
		Record.WindowMaxMs = 0
		Record.WindowSlowCalls = 0
	end

	local Severity

	if TopMax >= 8
		or TopLoad >= 20 then
		Severity = "HIGH"
	elseif TopMax >= 4
		or TopLoad >= 8 then
		Severity = "MODERATE"
	elseif TopScore > 0 then
		Severity = "LOW"
	else
		Severity = "COLLECTING"
	end

	ProfilerState.TopSource =
		TopName
	ProfilerState.TopSeverity =
		Severity

	local TopText =
		"Top Lag Source: "
		.. TopName
		.. "  |  "
		.. Severity
		.. "  |  Load "
		.. FormatProfilerNumber(
			TopLoad
		)
		.. " ms/s  |  Avg "
		.. FormatProfilerNumber(
			TopAverage
		)
		.. " ms  |  Max "
		.. FormatProfilerNumber(
			TopMax
		)
		.. " ms"

	local function RecordPair(Name)
		local Record =
			ProfilerState.Records[Name]

		return FormatProfilerNumber(
			Record.LastAverageMs
		)
			.. "/"
			.. FormatProfilerNumber(
				Record.LastMaxMs
			)
	end

	local BreakdownText =
		"Exclusive Avg/Max ms — Move "
		.. RecordPair("Movement")
		.. "  |  Target "
		.. RecordPair("Target Resolve")
		.. "  |  Mob Scan "
		.. RecordPair("Mob Cache Scan")
		.. "  |  Shard "
		.. RecordPair("Shard Cache Scan")
		.. "  |  Noclip "
		.. RecordPair("Noclip")
		.. "  |  Weapon "
		.. RecordPair("Weapon Scan")
		.. "  |  UI "
		.. RecordPair("Diagnostics/UI")
		.. "  |  Cache "
		.. RecordPair("Cache Maintenance")

	local CountersText =
		"Frame "
		.. FormatProfilerNumber(
			ProfilerState.LastFrameMs
		)
		.. " ms  |  Max Frame "
		.. FormatProfilerNumber(
			ProfilerState.MaxFrameMs
		)
		.. " ms  |  Slow Frames "
		.. tostring(
			ProfilerState.SlowFrames
		)
		.. "  |  Slow Calls "
		.. tostring(
			TotalSlowCalls
		)
		.. "  |  Resolve "
		.. tostring(
			TargetState.ResolveCalls
		)
		.. "  |  Reused "
		.. tostring(
			TargetState.ResolveSkips
		)
		.. "  |  Cache Cleans "
		.. tostring(
			RuntimeState
				and RuntimeState.CachePrunes
				or 0
		)
		.. "  |  Removed "
		.. tostring(
			RuntimeState
				and RuntimeState.StaleEntriesRemoved
				or 0
		)
		.. "  |  PivotTo "
		.. tostring(
			ProfilerState.PivotCalls
		)
		.. "  |  Skipped "
		.. tostring(
			ProfilerState.PivotSkips
		)
		.. "  |  Pivot Fallbacks "
		.. tostring(
			FollowMovement.PivotFallbacks
		)
		.. "  |  Pivot Failures "
		.. tostring(
			FollowMovement.PivotFailures
		)

	pcall(function()
		if TopText
			~= ProfilerState.LastTopText
			and UIState.ProfilerTop
			and type(
				UIState.ProfilerTop.SetText
			) == "function" then
			ProfilerState.LastTopText =
				TopText
			UIState.ProfilerTop:SetText(
				TopText
			)
		end

		if BreakdownText
			~= ProfilerState.LastBreakdownText
			and UIState.ProfilerBreakdown
			and type(
				UIState.ProfilerBreakdown.SetText
			) == "function" then
			ProfilerState.LastBreakdownText =
				BreakdownText
			UIState.ProfilerBreakdown:SetText(
				BreakdownText
			)
		end

		if CountersText
			~= ProfilerState.LastCountersText
			and UIState.ProfilerCounters
			and type(
				UIState.ProfilerCounters.SetText
			) == "function" then
			ProfilerState.LastCountersText =
				CountersText
			UIState.ProfilerCounters:SetText(
				CountersText
			)
		end
	end)
end

