local function CopyMultiSelection(
	Value,
	AllowedItems
)
	local Result = {}
	local Allowed = {}
	local Added = {}

	for _, Item in ipairs(AllowedItems) do
		Allowed[Item] = true
	end

	if type(Value) ~= "table" then
		return Result
	end

	for _, Item in ipairs(Value) do
		if type(Item) == "string"
			and Allowed[Item]
			and not Added[Item] then
			Added[Item] = true
			table.insert(Result, Item)
		end
	end

	for Item, Selected in pairs(Value) do
		if type(Item) == "string"
			and Selected == true
			and Allowed[Item]
			and not Added[Item] then
			Added[Item] = true
			table.insert(Result, Item)
		end
	end

	table.sort(Result, function(A, B)
		local AIndex =
			table.find(AllowedItems, A)
			or math.huge

		local BIndex =
			table.find(AllowedItems, B)
			or math.huge

		return AIndex < BIndex
	end)

	return Result
end

