function CharacterControl:MakeUprightCFrame(
	SourceCFrame,
	FallbackCFrame
)
	if typeof(SourceCFrame)
		~= "CFrame" then
		return SourceCFrame
	end

	local FlatLook =
		Vector3.new(
			SourceCFrame.LookVector.X,
			0,
			SourceCFrame.LookVector.Z
		)

	if FlatLook.Magnitude < 0.001
		and typeof(FallbackCFrame)
			== "CFrame" then
		FlatLook =
			Vector3.new(
				FallbackCFrame.LookVector.X,
				0,
				FallbackCFrame.LookVector.Z
			)
	end

	if FlatLook.Magnitude < 0.001 then
		local FlatRight =
			Vector3.new(
				SourceCFrame.RightVector.X,
				0,
				SourceCFrame.RightVector.Z
			)

		if FlatRight.Magnitude
			>= 0.001 then
			FlatLook =
				Vector3.new(
					-FlatRight.Z,
					0,
					FlatRight.X
				)
		end
	end

	if FlatLook.Magnitude < 0.001 then
		FlatLook =
			Vector3.new(
				0,
				0,
				-1
			)
	end

	return CFrame.lookAt(
		SourceCFrame.Position,
		SourceCFrame.Position
			+ FlatLook.Unit,
		Vector3.yAxis
	)
end

function CharacterControl:KeepUpright(
	Root
)
	if not self.UprightLock
		or not Root
		or not Root.Parent then
		return false
	end

	local AngularVelocity =
		Root.AssemblyAngularVelocity

	if AngularVelocity.Magnitude
		> self.AngularVelocityTolerance then
		Root.AssemblyAngularVelocity =
			Vector3.zero
		self.AngularStops += 1
	end

	if Root.CFrame.UpVector.Y
		>= self.UprightTolerance then
		return false
	end

	local UprightCFrame =
		self:MakeUprightCFrame(
			Root.CFrame,
			Root.CFrame
		)

	local Corrected =
		pcall(function()
			Root.CFrame =
				UprightCFrame
		end)

	if Corrected then
		self.UprightCorrections += 1
	end

	return Corrected
end

