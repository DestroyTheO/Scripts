--==================================================
-- SAFE PART LOOKUP
--==================================================
local function FindValidPart(Object)
	if not Object then
		return nil
	end

	if TargetState.CachedTarget
			== Object then
		local CachedPart =
			TargetState.CachedMovementPart

		if CachedPart
			and CachedPart.Parent
			and (
				CachedPart == Object
				or CachedPart:IsDescendantOf(
					Object
				)
			) then
			return CachedPart
		end
	end

	if Object:IsA("BasePart") then
		return Object
	end

	local PreferredNames = {
		"HumanoidRootPart",
		"RootPart",
		"UpperTorso",
		"Torso",
		"LowerTorso",
		"Head",
	}

	for _, Name in ipairs(PreferredNames) do
		local Part = Object:FindFirstChild(Name, true)

		if Part and Part:IsA("BasePart") then
			return Part
		end
	end

	if Object:IsA("Model") then
		local PrimaryPart = Object.PrimaryPart

		if PrimaryPart and PrimaryPart:IsA("BasePart") then
			return PrimaryPart
		end
	end

	for _, Descendant in ipairs(Object:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			return Descendant
		end
	end

	return nil
end

local function ResolveTargetPivotOwner(
	Object
)
	if not Object or not Object.Parent then
		return nil
	end

	if Object:IsA("Model") then
		return Object
	end

	if not Object:IsA("BasePart") then
		return nil
	end

	local SearchRoot =
		Workspace:FindFirstChild(
			"Enemies"
		)

	local Current = Object.Parent
	local NearestModel = nil

	while Current
		and Current ~= SearchRoot
		and Current ~= Workspace do
		if Current:IsA("Model") then
			NearestModel =
				NearestModel or Current

			local HasHumanoid =
				Current:FindFirstChildWhichIsA(
					"Humanoid",
					true
				) ~= nil

			local HasHealth =
				Current:FindFirstChild(
					"Health",
					true
				) ~= nil
				or Current:FindFirstChild(
					"HP",
					true
				) ~= nil
				or Current:FindFirstChild(
					"HitPoints",
					true
				) ~= nil
				or type(
					Current:GetAttribute(
						"Health"
					)
				) == "number"
				or type(
					Current:GetAttribute(
						"HP"
					)
				) == "number"
				or type(
					Current:GetAttribute(
						"HitPoints"
					)
				) == "number"

			if HasHumanoid
				or HasHealth
				or Current.PrimaryPart then
				return Current
			end
		end

		Current = Current.Parent
	end

	return NearestModel
end

local function ReadModelWorldPivot(
	Model
)
	if not Model
		or not Model:IsA("Model")
		or not Model.Parent then
		return nil
	end

	local Success, WorldPivot =
		pcall(function()
			return Model:GetPivot()
		end)

	if Success
		and typeof(WorldPivot)
			== "CFrame" then
		return WorldPivot
	end

	Success, WorldPivot =
		pcall(function()
			return Model.WorldPivot
		end)

	if Success
		and typeof(WorldPivot)
			== "CFrame" then
		return WorldPivot
	end

	return nil
end

local function FindTargetHitbox(
	TargetObject,
	Force
)
	if not TargetObject
		or not TargetObject.Parent then
		return nil
	end

	if not Force
		and TargetState.CachedTarget
			== TargetObject then
		local CachedHitbox =
			TargetState.CachedHitbox

		if CachedHitbox
			and CachedHitbox.Parent
			and CachedHitbox:IsA(
				"BasePart"
			) then
			local PivotOwner =
				TargetState.CachedPivotOwner

			if not PivotOwner
				or CachedHitbox
					:IsDescendantOf(
						PivotOwner
					)
				or CachedHitbox
					== PivotOwner then
				return CachedHitbox
			end
		end
	end

	local PivotOwner =
		TargetState.CachedTarget
				== TargetObject
			and TargetState.CachedPivotOwner
			or ResolveTargetPivotOwner(
				TargetObject
			)

	local SearchObject =
		PivotOwner or TargetObject

	local BestPart = nil
	local BestScore = -math.huge

	local function ConsiderPart(
		Part
	)
		if not Part
			or not Part:IsA("BasePart")
			or not Part.Parent then
			return
		end

		local Accessory =
			Part:FindFirstAncestorWhichIsA(
				"Accessory"
			)

		if Accessory then
			return
		end

		local Name =
			string.lower(
				tostring(Part.Name)
			):gsub(
				"[%s_%-]",
				""
			)

		local Score = 0

		if Name == "hitbox" then
			Score += 100000
		elseif Name:find(
			"hitbox",
			1,
			true
		) then
			Score += 90000
		elseif Name:find(
			"hurtbox",
			1,
			true
		)
			or Name:find(
				"damagebox",
				1,
				true
			) then
			Score += 85000
		elseif Name:find(
			"collisionbox",
			1,
			true
		)
			or Name == "collider" then
			Score += 80000
		elseif Name == "humanoidrootpart" then
			Score += 70000
		elseif Name == "rootpart"
			or Name == "root" then
			Score += 65000
		elseif Name == "uppertorso"
			or Name == "torso"
			or Name == "lowertorso" then
			Score += 45000
		elseif Name == "head" then
			Score += 25000
		end

		if SearchObject:IsA("Model")
			and SearchObject.PrimaryPart
				== Part then
			Score += 60000
		end

		if TargetObject == Part then
			Score += 30000
		end

		if Part.CanTouch then
			Score += 500
		end

		if Part.CanCollide then
			Score += 250
		end

		local Size = Part.Size
		local Volume =
			math.max(
				0,
				Size.X * Size.Y * Size.Z
			)

		Score += math.min(
			Volume,
			10000
		) * 0.01

		if Score > BestScore then
			BestScore = Score
			BestPart = Part
		end
	end

	if SearchObject:IsA("BasePart") then
		ConsiderPart(SearchObject)
	else
		for _, Descendant in ipairs(
			SearchObject:GetDescendants()
		) do
			if Descendant:IsA(
				"BasePart"
			) then
				ConsiderPart(
					Descendant
				)
			end
		end
	end

	if TargetState.CachedTarget
		== TargetObject then
		TargetState.CachedHitbox =
			BestPart
		TargetState.HitboxName =
			BestPart
				and tostring(BestPart.Name)
				or "None"
	end

	return BestPart
end

local function GetObjectWorldPivot(
	Object
)
	if not Object or not Object.Parent then
		return nil
	end

	local PivotOwner =
		ResolveTargetPivotOwner(
			Object
		)

	if PivotOwner then
		local WorldPivot =
			ReadModelWorldPivot(
				PivotOwner
			)

		if WorldPivot then
			return WorldPivot
		end
	end

	if Object:IsA("BasePart") then
		return Object.CFrame
	end

	return nil
end


--==================================================
-- MOB HEALTH
--==================================================
local function ClearTargetRuntimeCache()
	TargetState.CachedTarget = nil
	TargetState.CachedHealthObject = nil
	TargetState.CachedHealthAttribute = nil
	TargetState.CachedMovementPart = nil
	TargetState.CachedPivotOwner = nil
	TargetState.CachedPivotSource = "None"
	TargetState.CachedHitbox = nil
	TargetState.HitboxName = "None"
	TargetState.EngagementTarget = nil
	TargetState.EngagementLastHealth = nil
	TargetState.EngagementStartedAt = 0
	TargetState.EngagementLastDamageAt = 0
	TargetState.EngagementLastSafetyTeleport = 0
	TargetState.EngagementDamageObserved = false
	TargetState.EngagementAboveTarget = false
	TargetState.EngagementInsideClickBox = false
	TargetState.EngagementCanClick = false
	TargetState.EngagementForceTeleport = false
	TargetState.EngagementStatus = "Idle"
end

local function CacheTargetRuntime(
	Mob,
	Force
)
	if not Mob or not Mob.Parent then
		ClearTargetRuntimeCache()
		return false
	end

	if not Force
		and TargetState.CachedTarget
			== Mob then
		local PivotOwner =
			TargetState.CachedPivotOwner

		local PivotValid =
			not PivotOwner
			or (
				PivotOwner.Parent
				and (
					PivotOwner == Mob
					or Mob:IsDescendantOf(
						PivotOwner
					)
					or PivotOwner:IsDescendantOf(
						Mob
					)
				)
			)

		local CacheRoot =
			PivotOwner or Mob

		local CachedPart =
			TargetState.CachedMovementPart

		local PartValid =
			not CachedPart
			or (
				CachedPart.Parent
				and (
					CachedPart == CacheRoot
					or CachedPart:IsDescendantOf(
						CacheRoot
					)
				)
			)

		local HealthObject =
			TargetState.CachedHealthObject

		local HealthValid =
			not HealthObject
			or (
				HealthObject.Parent
				and HealthObject:IsDescendantOf(
					CacheRoot
				)
			)

		local AttributeName =
			TargetState.CachedHealthAttribute

		local AttributeValid =
			not AttributeName
			or type(
				CacheRoot:GetAttribute(
					AttributeName
				)
			) == "number"

		if PivotValid
			and PartValid
			and HealthValid
			and AttributeValid then
			return ReadModelWorldPivot(
				PivotOwner
			) ~= nil
				or (
					CachedPart
					and CachedPart.Parent
				) ~= nil
		end
	end

	ClearTargetRuntimeCache()
	TargetState.CachedTarget = Mob

	local PivotOwner =
		ResolveTargetPivotOwner(
			Mob
		)

	TargetState.CachedPivotOwner =
		PivotOwner

	local CacheRoot =
		PivotOwner or Mob

	if PivotOwner
		and ReadModelWorldPivot(
			PivotOwner
		) then
		TargetState.CachedPivotSource =
			"Model WorldPivot"
	else
		TargetState.CachedPivotSource =
			Mob:IsA("BasePart")
				and "BasePart CFrame"
				or "None"
	end

	local Humanoid =
		CacheRoot:FindFirstChildWhichIsA(
			"Humanoid",
			true
		)

	if Humanoid then
		TargetState.CachedHealthObject =
			Humanoid
	else
		local HealthValue =
			CacheRoot:FindFirstChild(
				"Health",
				true
			)
			or CacheRoot:FindFirstChild(
				"HP",
				true
			)
			or CacheRoot:FindFirstChild(
				"HitPoints",
				true
			)

		if HealthValue
			and (
				HealthValue:IsA(
					"NumberValue"
				)
				or HealthValue:IsA(
					"IntValue"
				)
			) then
			TargetState.CachedHealthObject =
				HealthValue
		else
			for _, AttributeName in ipairs({
				"Health",
				"HP",
				"HitPoints",
			}) do
				local Value =
					CacheRoot:GetAttribute(
						AttributeName
					)

				if type(Value)
					== "number" then
					TargetState.CachedHealthAttribute =
						AttributeName
					break
				end
			end
		end
	end

	TargetState.CachedHitbox =
		FindTargetHitbox(
			Mob,
			true
		)

	TargetState.HitboxName =
		TargetState.CachedHitbox
			and tostring(
				TargetState.CachedHitbox.Name
			)
			or "None"

	TargetState.CachedMovementPart =
		TargetState.CachedHitbox
		or FindValidPart(
			CacheRoot
		)

	TargetState.TargetCacheBuilds += 1

	return (
		PivotOwner
		and ReadModelWorldPivot(
			PivotOwner
		) ~= nil
	)
		or (
			TargetState.CachedMovementPart
			and TargetState.CachedMovementPart.Parent
		) ~= nil
end


local function GetMobHealth(Mob)
	if not Mob then
		return 0
	end

	if TargetState.CachedTarget
		== Mob then
		if not CacheTargetRuntime(
			Mob,
			false
		) then
			return 0
		end

		local HealthObject =
			TargetState.CachedHealthObject

		if HealthObject
			and HealthObject.Parent then
			if HealthObject:IsA(
				"Humanoid"
			) then
				return HealthObject.Health
			end

			if HealthObject:IsA(
				"NumberValue"
			)
				or HealthObject:IsA(
					"IntValue"
				) then
				return HealthObject.Value
			end
		end

		local AttributeName =
			TargetState.CachedHealthAttribute

		if AttributeName then
			local CacheRoot =
				TargetState.CachedPivotOwner
				or Mob

			local Value =
				CacheRoot:GetAttribute(
					AttributeName
				)

			if type(Value)
				== "number" then
				return Value
			end
		end

		local CachedPart =
			TargetState.CachedMovementPart

		return CachedPart
			and CachedPart.Parent
			and math.huge
			or 0
	end

	-- Uncached candidate checks happen only during the throttled
	-- shared mob scan. The active target uses the fast path above.
	local Humanoid =
		Mob:FindFirstChildWhichIsA(
			"Humanoid",
			true
		)

	if Humanoid then
		return Humanoid.Health
	end

	local HealthValue =
		Mob:FindFirstChild(
			"Health",
			true
		)
		or Mob:FindFirstChild(
			"HP",
			true
		)
		or Mob:FindFirstChild(
			"HitPoints",
			true
		)

	if HealthValue
		and (
			HealthValue:IsA(
				"NumberValue"
			)
			or HealthValue:IsA(
				"IntValue"
			)
		) then
		return HealthValue.Value
	end

	local HealthAttribute =
		Mob:GetAttribute("Health")
		or Mob:GetAttribute("HP")
		or Mob:GetAttribute("HitPoints")

	if type(HealthAttribute)
		== "number" then
		return HealthAttribute
	end

	return FindValidPart(Mob)
		and math.huge
		or 0
end


local function UpdateTargetCombatSafety(
	Now,
	Root,
	TargetObject
)
	Now = tonumber(Now)
		or os.clock()

	if not Root
		or not Root.Parent
		or not TargetObject
		or not TargetObject.Parent then
		TargetState.EngagementCanClick =
			false
		TargetState.EngagementAboveTarget =
			false
		TargetState.EngagementInsideClickBox =
			false
		TargetState.EngagementStatus =
			"No live target"
		return false
	end

	if TargetState.EngagementTarget
		~= TargetObject then
		local InitialHealth =
			GetMobHealth(
				TargetObject
			)

		TargetState.EngagementTarget =
			TargetObject
		TargetState.EngagementLastHealth =
			type(InitialHealth) == "number"
				and InitialHealth
				or nil
		TargetState.EngagementStartedAt =
			Now
		TargetState.EngagementLastDamageAt =
			Now
		TargetState.EngagementLastSafetyTeleport =
			0
		TargetState.EngagementDamageObserved =
			false
		TargetState.EngagementAboveTarget =
			false
		TargetState.EngagementCanClick =
			false
		TargetState.EngagementForceTeleport =
			true
		TargetState.EngagementStatus =
			"Acquiring hitbox"
	end

	local Health =
		GetMobHealth(
			TargetObject
		)

	if type(Health) == "number"
		and Health <= 0 then
		TargetState.EngagementCanClick =
			false
		TargetState.EngagementAboveTarget =
			false
		TargetState.EngagementInsideClickBox =
			false
		TargetState.EngagementForceTeleport =
			false
		TargetState.EngagementStatus =
			"Target dead"
		return false
	end

	local Hitbox =
		FindTargetHitbox(
			TargetObject,
			false
		)

	if not Hitbox
		or not Hitbox.Parent then
		TargetState.EngagementCanClick =
			false
		TargetState.EngagementAboveTarget =
			false
		TargetState.EngagementInsideClickBox =
			false
		TargetState.EngagementForceTeleport =
			true
		TargetState.EngagementStatus =
			"No hitbox"
		return false
	end

	TargetState.HitboxName =
		tostring(Hitbox.Name)

	local HitboxPosition =
		Hitbox.Position

	-- The click area is an exact 10x10 square directly beneath the
	-- HumanoidRootPart. Converting the hitbox center into root-local
	-- space keeps the square centered under the player even while the
	-- character rotates.
	local LocalHitboxPosition =
		Root.CFrame:PointToObjectSpace(
			HitboxPosition
		)

	local HalfBox =
		TargetState
			.EngagementClickBoxHalfSize

	local HitboxTopY =
		HitboxPosition.Y
		+ Hitbox.Size.Y * 0.5

	local RootIsAboveHitbox =
		Root.Position.Y
			> HitboxTopY

	local InsideClickBox =
		math.abs(
			LocalHitboxPosition.X
		) <= HalfBox
		and math.abs(
			LocalHitboxPosition.Z
		) <= HalfBox
		and LocalHitboxPosition.Y < 0
		and RootIsAboveHitbox

	TargetState.EngagementInsideClickBox =
		InsideClickBox
	TargetState.EngagementAboveTarget =
		InsideClickBox

	local HealthTrackable =
		type(Health) == "number"
		and Health > 0
		and Health < math.huge

	if HealthTrackable then
		local PreviousHealth =
			TargetState
				.EngagementLastHealth

		if type(PreviousHealth)
				== "number"
			and Health
				< PreviousHealth - 0.001 then
			TargetState
				.EngagementDamageObserved =
				true
			TargetState
				.EngagementLastDamageAt =
				Now
		end

		TargetState.EngagementLastHealth =
			Health
	else
		TargetState.EngagementLastHealth =
			nil
	end

	local DamageReferenceTime =
		TargetState.EngagementDamageObserved
			and TargetState
				.EngagementLastDamageAt
			or TargetState
				.EngagementStartedAt

	local NoRecentDamage =
		HealthTrackable
		and Now - DamageReferenceTime
			>= TargetState
				.EngagementNoDamageTimeout

	local NeedsSafetyTeleport =
		not InsideClickBox
		or NoRecentDamage

	if NeedsSafetyTeleport
		and (
			TargetState
				.EngagementLastSafetyTeleport
				== 0
			or Now
				- TargetState
					.EngagementLastSafetyTeleport
				>= TargetState
					.EngagementTeleportCooldown
		) then
		TargetState.EngagementForceTeleport =
			true
		TargetState.EngagementLastSafetyTeleport =
			Now
	end

	TargetState.EngagementCanClick =
		InsideClickBox
		and not TargetState
			.EngagementForceTeleport

	if not InsideClickBox then
		TargetState.EngagementStatus =
			"Target outside 10x10 box"
	elseif NoRecentDamage then
		TargetState.EngagementStatus =
			"Health stalled - reteleporting"
	elseif TargetState.EngagementCanClick then
		TargetState.EngagementStatus =
			TargetState
				.EngagementDamageObserved
				and "Inside 10x10 box - damaging"
				or "Inside 10x10 box - testing damage"
	else
		TargetState.EngagementStatus =
			"Verifying position"
	end

	return TargetState.EngagementCanClick
end



--==================================================
-- TRANSPARENCY CHECK
--==================================================
local function IsFullyTransparent(Mob)
	if not Mob then
		return true
	end

	local FoundPart = false

	if Mob:IsA("BasePart") then
		return Mob.Transparency >= 1
	end

	for _, Descendant in ipairs(Mob:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			FoundPart = true

			if Descendant.Transparency < 1 then
				return false
			end
		end
	end

	return not FoundPart
end

--==================================================
-- MOB VALIDATION
--==================================================
local function IsMobValid(Mob)
	if not Mob or not Mob.Parent then
		return false
	end

	local SearchRoot = GetMobSearchRoot()
	local Character = GetCharacter()

	if not SearchRoot
		or not Mob:IsDescendantOf(SearchRoot) then
		return false
	end

	-- Never treat the local player's character as a mob.
	if Character
		and (
			Mob == Character
			or Mob:IsDescendantOf(Character)
		) then
		return false
	end

	if GetMobHealth(Mob) <= 0 then
		return false
	end

	-- Some valid enemies use invisible collision/root parts. Their
	-- WorldPivot is still usable, so transparency must not reject them.
	if not GetObjectWorldPivot(Mob) then
		return false
	end

	return true
end

