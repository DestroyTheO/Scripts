local function FindClosestCachedEnemy(
	Choice,
	OriginPosition
)
	local Candidates =
		TargetState.MobCacheByChoice[
			Choice
		] or {}

	local Closest = nil
	local ClosestDistance = math.huge

	for _, Object in ipairs(
		Candidates
	) do
		if IsMobValid(Object) then
			local WorldPivot =
				GetObjectWorldPivot(Object)

			if WorldPivot then
				local Distance =
					(
						WorldPivot.Position
						- OriginPosition
					).Magnitude

				if Distance < ClosestDistance then
					Closest = Object
					ClosestDistance =
						Distance
				end
			end
		end
	end

	return Closest
end

local function AdvanceMultiCycleAfterChoice(
	Choice
)
	if #FarmState.MultiTargetOrder == 0 then
		FarmState.MultiCycleIndex = 1
		return
	end

	for Index, ListedChoice in ipairs(
		FarmState.MultiTargetOrder
	) do
		if ListedChoice == Choice then
			FarmState.MultiCycleIndex =
				(Index % #FarmState.MultiTargetOrder) + 1
			return
		end
	end

	FarmState.MultiCycleIndex = 1
end

local function FindSelectedEnemyDirect()
	local Enemies =
		Workspace:FindFirstChild("Enemies")

	local Now = os.clock()
	local Root = GetRoot()
	local OriginPosition =
		Root and Root.Position
		or Vector3.zero

	local ChronyxSelected =
		IsChronyxModeSelected()

	-- Keep a valid shard without scanning regular enemies.
	if ChronyxSelected
		and TargetState.IsChronyxShard
		and IsChronyxShardValid(
			TargetState.Current
		) then
		TargetState.ScanDirty = false
		return TargetState.Current
	end

	-- Chronyx shards use their own small cached folder.
	if ChronyxSelected then
		if TargetState.ShardCacheDirty then
			RefreshChronyxShardCache(
				true
			)
		end

		local Shard =
			FindClosestChronyxShard(
				OriginPosition
			)

		if Shard then
			if TargetState.Current ~= Shard
				or not TargetState.IsChronyxShard then
				FollowMovement.LastTarget =
					nil
				FollowMovement.LastCharacter =
					nil
				FollowMovement.InitialTeleportPending =
					true
			end

			TargetState.Current = Shard
			TargetState.CurrentIndex = 1
			FarmState.CurrentMultiChoice = nil
			TargetState.IsChronyxShard =
				true
			TargetState.Waiting = false
			TargetState.WaitingCFrame = nil
			TargetState.ScanDirty = false

			return Shard
		end
	end

	TargetState.IsChronyxShard = false

	-- Keep a valid current target. No folder scan runs here.
	if TargetState.Current then
		local ActiveChoice =
			IsMultiModeEnabled()
				and FarmState.CurrentMultiChoice
				or FarmState.SelectedMobChoice

		local Definition =
			ActiveChoice
			and MobDefinitions[ActiveChoice]

		if Definition
			and MatchesSelectedEnemyName(
				TargetState.Current.Name,
				Definition
			)
			and IsMobValid(
				TargetState.Current
			) then
			TargetState.ScanDirty = false
			return TargetState.Current
		end

		if IsMultiModeEnabled()
			and FarmState.CurrentMultiChoice then
			AdvanceMultiCycleAfterChoice(
				FarmState.CurrentMultiChoice
			)
		end

		TargetState.ScanDirty = true
	end

	TargetState.Current = nil
	TargetState.CurrentIndex = 0
	ClearTargetRuntimeCache()
	FarmState.CurrentMultiChoice = nil
	TargetState.IsChronyxShard = false

	if not Enemies then
		TargetState.Waiting = true
		TargetState.ScanDirty = false
		return nil
	end

	-- Chronyx itself is a direct child and does not need a mob scan.
	if ChronyxSelected then
		local Chronyx =
			Enemies:FindFirstChild(
				"Chronyx"
			)

		if Chronyx
			and IsMobValid(Chronyx) then
			TargetState.Current = Chronyx
			TargetState.CurrentIndex = 1
			TargetState.Waiting = false
			TargetState.WaitingCFrame = nil
			TargetState.ScanDirty = false
			return Chronyx
		end

		TargetState.Waiting = true
		TargetState.ScanDirty = false
		return nil
	end

	local ShouldRefresh =
		TargetState.ScanDirty
		or Now
			- TargetState.LastMobCacheRefresh
			>= TargetState.MobCacheWaitRescanInterval

	if ShouldRefresh then
		RefreshActiveMobCache(
			Enemies,
			true
		)
	end

	if IsMultiModeEnabled() then
		local Choices =
			GetActiveEnemyChoices()

		if #Choices == 0 then
			TargetState.Waiting = true
			TargetState.ScanDirty = false
			return nil
		end

		for Offset = 0,
			#Choices - 1 do
			local Index =
				(
					(FarmState.MultiCycleIndex
						- 1 + Offset)
					% #Choices
				) + 1

			local Choice =
				Choices[Index]

			local Mob =
				FindClosestCachedEnemy(
					Choice,
					OriginPosition
				)

			if Mob then
				TargetState.Current = Mob
				TargetState.CurrentIndex = Index
				FarmState.CurrentMultiChoice =
					Choice
				FarmState.MultiCycleIndex =
					Index
				TargetState.Waiting = false
				TargetState.WaitingCFrame =
					nil
				TargetState.ScanDirty = false
				return Mob
			end
		end
	else
		local Choice =
			FarmState.SelectedMobChoice

		local Mob =
			FindClosestCachedEnemy(
				Choice,
				OriginPosition
			)

		if Mob then
			TargetState.Current = Mob
			TargetState.CurrentIndex = 1
			TargetState.Waiting = false
			TargetState.WaitingCFrame = nil
			TargetState.ScanDirty = false
			return Mob
		end
	end

	TargetState.Waiting = true
	TargetState.ScanDirty = false
	return nil
end

