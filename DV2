		UpdateRuntimeDiagnostics
	)

--==================================================
-- MOVEMENT LOOP
--==================================================
TrackRuntimeConnection(
	RunService.PreSimulation:Connect(function(DeltaTime)
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		if not TargetState.SupersededCleanupDone then
			TargetState.SupersededCleanupDone = true
			DisconnectWeaponInventoryWatchers()
			StopMobScanning()
			RestoreCollisions()
			ReleaseHumanoidState()
			DisconnectRuntimeConnections()
		end

		return
	end

	if not IsAnyFarmEnabled()
		or FlyState.Enabled then
		return
	end

	local Root = GetRoot()

	if not Root then
		return
	end

	CharacterControl:
		KeepUpright(
			Root
		)

	local Now = os.clock()
	local Elapsed =
		Now - PerformanceState.LastMovement

	if Elapsed
		< PerformanceState.MovementInterval then
		return
	end

	PerformanceState.LastMovement = Now

	local Humanoid = GetHumanoid()

	if not Humanoid
		or Humanoid.Health <= 0 then
		return
	end

	if Now - PerformanceState.LastNoclip
		>= PerformanceState.NoclipInterval then
		PerformanceState.LastNoclip = Now
		ForceNoclip()
	end

	if Now
		- PerformanceState.LastHumanoidState
		>= PerformanceState.HumanoidStateInterval then
		PerformanceState.LastHumanoidState =
			Now
		ApplyHumanoidState(Humanoid)
	end

	local Mob =
		TargetState.Current

	local NeedsResolve = false

	if not Mob or not Mob.Parent then
		NeedsResolve = true
	else
		-- This is the cached health path from v92. It does not scan
		-- descendants for the active target.
		local Health =
			GetMobHealth(Mob)

		if Health <= 0 then
			NeedsResolve = true
		elseif IsChronyxModeSelected()
			and not TargetState.IsChronyxShard
			and (
				TargetState.ShardCacheDirty
					or TargetState.ScanDirty
			) then
			-- Chronyx must immediately return to shard priority if
			-- a shard phase appears or respawns.
			NeedsResolve = true
		else
			-- Ordinary spawn/removal events do not need to replace an
			-- already living target.
			TargetState.ScanDirty = false
		end
	end

	if NeedsResolve then
		local CanResolveNow =
			Mob ~= nil
			or TargetState.ScanDirty
			or Now - TargetState.LastResolve
				>= TargetState.WaitingResolveInterval

		if CanResolveNow then
			TargetState.LastResolve = Now
			TargetState.ResolveCalls += 1
			Mob = FindSelectedEnemyDirect()

			if Mob and Mob.Parent then
				TargetState.ScanDirty = false
			end
		else
			TargetState.ResolveSkips += 1
			Mob = nil
		end
	else
		TargetState.ResolveSkips += 1
	end

	if not Mob or not Mob.Parent then
		HoldWaitingHeight(
			Root,
			Humanoid
		)
		return
	end

	TargetState.Waiting = false
	TargetState.WaitingCFrame = nil

	UpdateTargetCombatSafety(
		Now,
		Root,
		Mob
	)

	local Followed =
		MoveCharacterLikeFly(
			Root,
			Humanoid,
			Mob,
			math.max(
				tonumber(DeltaTime) or 0,
				Elapsed
			)
		)

	if not Followed then
		HoldWaitingHeight(
			Root,
			Humanoid
		)
		return
	end

	TargetState.LastHeldCFrame =
		Root.Parent and Root.CFrame
		or TargetState.LastHeldCFrame
end)
)

--==================================================
-- PLAYER FLY LOOP
--==================================================
TrackRuntimeConnection(
	RunService.PreSimulation:Connect(function(DeltaTime)
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	if not FlyState.Enabled or not IsPlayerAlive() then
		FlyState.YLevel = nil
		return
	end

	local Root = GetRoot()
	local Humanoid = GetHumanoid()
	local Camera = Workspace.CurrentCamera

	if not Root or not Humanoid then
		return
	end

	if FlyState.HumanoidState ~= "None" then
		local State =
			Enum.HumanoidStateType[
				FlyState.HumanoidState
			]

		if State then
			Humanoid:ChangeState(State)
		end
	end

	local MoveDirection

	if FlyState.MoveMode == "Direct" then
		MoveDirection = CalculateFlyMoveVector(
			Vector3.new(
				FlyInput.A + FlyInput.D,
				0,
				FlyInput.W + FlyInput.S
			)
		)
	else
		MoveDirection = Humanoid.MoveDirection
	end

	if FlyState.Mode == "Velocity" then
		Root.AssemblyLinearVelocity =
			(MoveDirection * FlyState.Speed)
			+ Vector3.new(
				0,
				Root.AssemblyLinearVelocity.Y,
				0
			)

	elseif FlyState.Mode == "Impulse" then
		local Desired = MoveDirection * FlyState.Speed

		local Difference =
			(Desired - Root.AssemblyLinearVelocity)
			* Vector3.new(1, 0, 1)

		if Difference.Magnitude > 2 then
			Root:ApplyImpulse(
				Difference * Root.AssemblyMass
			)
		end

	elseif FlyState.Mode == "CFrame" then
		Root.CFrame +=
			MoveDirection
			* FlyState.Speed
			* DeltaTime

	elseif FlyState.Mode == "Pulse" then
		local PulseTime =
			tick()
			% (
				FlyState.PulseLength
				+ FlyState.PulseDelay
			)

		if PulseTime < FlyState.PulseLength then
			Root.AssemblyLinearVelocity =
				(MoveDirection * FlyState.Speed)
				+ Vector3.new(
					0,
					Root.AssemblyLinearVelocity.Y,
					0
				)
		end

	elseif FlyState.Mode == "TP" then
		if tick() - FlyState.LastTP
			>= FlyState.TPFrequency then
			FlyState.LastTP = tick()

			Root.CFrame +=
				MoveDirection
				* FlyState.Speed
				* 0.05
		end
	end

	if not FlyState.YLevel then
		FlyState.YLevel = Root.Position.Y
	end

	FlyState.YLevel +=
		(FlyInput.Up + FlyInput.Down)
		* FlyState.Vertical
		* DeltaTime

	if FlyState.WallCheck then
		local IgnoreList = {
			GetCharacter(),
		}

		if Camera then
			table.insert(IgnoreList, Camera)
		end

		FlyRayParams.FilterDescendantsInstances =
			IgnoreList

		local Ray = Workspace:Raycast(
			Root.Position,
			Vector3.new(
				0,
				FlyState.YLevel - Root.Position.Y,
				0
			),
			FlyRayParams
		)

		if Ray then
			FlyState.YLevel =
				Ray.Position.Y + Humanoid.HipHeight
		end
	end

	Root.Velocity *= Vector3.new(1, 0, 1)

	Root.CFrame += Vector3.new(
		0,
		FlyState.YLevel - Root.Position.Y,
		0
	)
end)
)

