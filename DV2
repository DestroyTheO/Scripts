local function IsValidMenuXDSource(Source)
	if type(Source) ~= "string"
		or #Source < 1000 then
		return false,
			"returned "
				.. typeof(Source)
				.. " with "
				.. tostring(
					type(Source) == "string"
						and #Source
						or 0
				)
				.. " characters"
	end

	local LowerSource =
		string.lower(Source)

	if string.find(
		LowerSource,
		"<!doctype html",
		1,
		true
	)
		or string.find(
			LowerSource,
			"<html",
			1,
			true
		) then
		return false,
			"returned an HTML page instead of Lua"
	end

	-- Require the current runtime-aware VenturaUI build rather than
	-- silently accepting an older pinned copy.
	local RequiredMarkers = {
		"function Tab:NumberDisplay",
		"env.__VenturaUIRuntime",
		"function GUI:RegisterCleanup(callback, label)",
		"function GUI:BindToCharacter(callback, runNow)",
		"function Library:GetRuntimeCounts()",
		"function Library:CreateWindow(options)",
		"function Library:SelfTest()",
	}

	for _, Marker in ipairs(
		RequiredMarkers
	) do
		if not string.find(
			Source,
			Marker,
			1,
			true
		) then
			return false,
				"downloaded build is missing current feature: "
					.. Marker
		end
	end

	return true
end

local function BuildFreshMenuXDURL(URL)
	local Separator =
		string.find(
			URL,
			"?",
			1,
			true
		)
			and "&"
			or "?"

	return URL
		.. Separator
		.. "crimmy_ui_refresh="
		.. tostring(os.time())
		.. "_"
		.. tostring(
			math.floor(
				os.clock() * 1000000
			)
		)
end

local function TryGameHttpGet(URL)
	local FetchURL =
		BuildFreshMenuXDURL(URL)

	local Success, Response =
		pcall(function()
			return game:HttpGet(
				FetchURL
			)
		end)

	if not Success then
		return nil,
			"game:HttpGet error: "
				.. tostring(Response)
	end

	local Valid, Reason =
		IsValidMenuXDSource(Response)

	if Valid then
		return Response
	end

	return nil,
		"game:HttpGet " .. Reason
end

local function TryRequestFunction(
	RequestFunction,
	RequestName,
	URL
)
	if type(RequestFunction) ~= "function" then
		return nil,
			RequestName .. " unavailable"
	end

	local FetchURL =
		BuildFreshMenuXDURL(URL)

	local Success, Response =
		pcall(function()
			return RequestFunction({
				Url = FetchURL,
				Method = "GET",
				Headers = {
					["Cache-Control"] =
						"no-cache, no-store, max-age=0",
					["Pragma"] = "no-cache",
				},
			})
		end)

	if not Success then
		return nil,
			RequestName
				.. " error: "
				.. tostring(Response)
	end

	local Body =
		type(Response) == "table"
			and (
				Response.Body
				or Response.body
			)
			or Response

	local Valid, Reason =
		IsValidMenuXDSource(Body)

	if Valid then
		return Body
	end

	local StatusCode =
		type(Response) == "table"
			and (
				Response.StatusCode
				or Response.Status
				or Response.status_code
			)
			or nil

	return nil,
		RequestName
			.. " "
			.. Reason
			.. (
				StatusCode
					and (
						" (status "
						.. tostring(StatusCode)
						.. ")"
					)
					or ""
			)
end

local function DownloadMenuXD()
	local AttemptErrors = {}

	local SynRequest = nil
	pcall(function()
		if syn then
			SynRequest = syn.request
		end
	end)

	local RequestCandidates = {
		{
			Name = "request",
			Function = request,
		},
		{
			Name = "http_request",
			Function = http_request,
		},
		{
			Name = "syn.request",
			Function = SynRequest,
		},
	}

	for _, URL in ipairs(MenuXDURLs) do
		local Source, HttpReason =
			TryGameHttpGet(URL)

		if Source then
			return Source, URL
		end

		table.insert(
			AttemptErrors,
			URL .. " -> " .. HttpReason
		)

		for _, Candidate in ipairs(
			RequestCandidates
		) do
			local RequestSource, RequestReason =
				TryRequestFunction(
					Candidate.Function,
					Candidate.Name,
					URL
				)

			if RequestSource then
				return RequestSource, URL
			end

			if not string.find(
				RequestReason,
				" unavailable",
				1,
				true
			) then
				table.insert(
					AttemptErrors,
					URL
						.. " -> "
						.. RequestReason
				)
			end
		end
	end

	return nil,
		table.concat(
			AttemptErrors,
			" | "
		)
end

