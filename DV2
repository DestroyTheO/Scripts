-- The current main branch still declares two config helpers as outer
-- locals inside its already-large window constructor. Rewrite only
-- those known declarations onto GUI to preserve executor compatibility
-- with strict 200-register Luau builds.
local function PatchVenturaRegisterLimit(Source)
	local HasBaseLocal =
		string.find(
			Source,
			"local _baseApplyConfig_535 = GUI.ApplyConfig",
			1,
			true
		) ~= nil

	local HasProfileLocal =
		string.find(
			Source,
			"local function _profileExists(profile)",
			1,
			true
		) ~= nil

	-- Leave a future upstream build untouched once it no longer has
	-- either register-heavy declaration.
	if not HasBaseLocal
		and not HasProfileLocal then
		return Source, 0
	end

	if HasBaseLocal ~= HasProfileLocal then
		return nil,
			"only one known config helper matched; refusing a partial patch"
	end

	local Patched = Source
	local AppliedPatches = 0

	local Updated, Count =
		Patched:gsub(
			"local _baseApplyConfig_535 = GUI%.ApplyConfig",
			"GUI._baseApplyConfig_535 = GUI.ApplyConfig",
			1
		)

	Patched = Updated
	AppliedPatches += Count

	Updated, Count =
		Patched:gsub(
			"local function _profileExists%((profile)%)",
			"function GUI:_profileExists(%1)",
			1
		)

	Patched = Updated
	AppliedPatches += Count

	Updated, Count =
		Patched:gsub(
			"_baseApplyConfig_535%(GUI, data%)",
			"GUI._baseApplyConfig_535(GUI, data)",
			1
		)

	Patched = Updated
	AppliedPatches += Count

	Updated, Count =
		Patched:gsub(
			"([%s=,%(])_profileExists%(",
			"%1GUI:_profileExists("
		)

	Patched = Updated
	AppliedPatches += Count

	if string.find(
		Patched,
		"local _baseApplyConfig_535",
		1,
		true
	)
		or string.find(
			Patched,
			"local function _profileExists",
			1,
			true
		)
		or not string.find(
			Patched,
			"GUI._baseApplyConfig_535 = GUI.ApplyConfig",
			1,
			true
		)
		or not string.find(
			Patched,
			"function GUI:_profileExists(profile)",
			1,
			true
		)
		or not string.find(
			Patched,
			"GUI._baseApplyConfig_535(GUI, data)",
			1,
			true
		) then
		return nil,
			"register-limit patch could not safely rewrite the current config overlay"
	end

	return Patched, AppliedPatches
end

