local function UpdateRuntimeDiagnostics(
	Now,
	Force
)
	Now = tonumber(Now)
		or os.clock()

	if not Force
		and Now - DiagnosticsState.LastUpdate
			< DiagnosticsState.UpdateInterval then
		return
	end

	DiagnosticsState.LastUpdate = Now

	if IsChronyxModeSelected()
		or TargetState.IsChronyxShard then
		DiagnosticsState.ShardsRemaining =
			CountChronyxShards()
	else
		DiagnosticsState.ShardsRemaining = 0
	end

	local Target = TargetState.Current

	if not Target
		or not Target.Parent then
		Target = nil
	end

	local Health =
		Target
		and GetMobHealth(Target)
		or 0

	local TrackableHealth =
		type(Health) == "number"
		and Health > 0
		and Health < math.huge

	if Target
		~= DiagnosticsState.LastObservedTarget then
		DiagnosticsState.LastObservedTarget =
			Target
		DiagnosticsState.LastObservedHealth =
			TrackableHealth and Health or nil
		DiagnosticsState.LastHealthChange =
			Now

	elseif TrackableHealth then
		local PreviousHealth =
			DiagnosticsState.LastObservedHealth

		if PreviousHealth == nil
			or math.abs(
				Health - PreviousHealth
			) > 0.001 then
			DiagnosticsState.LastObservedHealth =
				Health
			DiagnosticsState.LastHealthChange =
				Now

		elseif IsAnyFarmEnabled()
			and Now
				- DiagnosticsState.LastHealthChange
				>= DiagnosticsState.StuckTimeout
			and Now
				- DiagnosticsState.LastRecovery
				>= DiagnosticsState.RecoveryCooldown then
			RecoverStuckTarget(Now)
		end
	else
		DiagnosticsState.LastObservedHealth =
			nil
		DiagnosticsState.LastHealthChange =
			Now
	end

	local SelectedLabel =
		IsMultiModeEnabled()
			and (
				FarmState.CurrentMultiChoice
				or (
					FarmState.KillAllEnabled
						and "Kill All"
						or "Multi Farm"
				)
			)
			or FarmState.SelectedMobChoice

	DiagnosticsState.SelectedLabel =
		tostring(
			SelectedLabel or "None"
		)

	DiagnosticsState.ActualTarget =
		Target
			and tostring(Target.Name)
			or "None"

	if Target
		~= DiagnosticsState.PathTarget then
		DiagnosticsState.PathTarget = Target
		DiagnosticsState.ActualPath =
			GetInstancePath(Target)
	end

	DiagnosticsState.Phase =
		GetRuntimePhase(
			DiagnosticsState.ShardsRemaining
		)

	if not IsAnyFarmEnabled() then
		DiagnosticsState.Status = "Idle"
	elseif Now
			< DiagnosticsState.RecoveryStatusUntil then
		DiagnosticsState.Status =
			"Recovering"
	elseif TargetState.Waiting
		or not Target then
		DiagnosticsState.Status =
			"Waiting"
	else
		DiagnosticsState.Status =
			"Active"
	end

	DiagnosticsState.TargetHealth =
		TrackableHealth
			and math.max(
				0,
				math.floor(
					Health + 0.5
				)
			)
			or 0

	local Tool =
		WeaponState.CurrentTool

	DiagnosticsState.WeaponName =
		Tool and Tool.Parent
			and tostring(Tool.Name)
			or "None"

	local Damage =
		tonumber(
			WeaponState.CurrentDamage
		)

	DiagnosticsState.WeaponDamage =
		Damage
			and Damage > -math.huge
			and math.max(
				0,
				math.floor(
					Damage + 0.5
				)
			)
			or 0

	UpdateDiagnosticsControls()

	if type(
		SecretWatch.UpdateStatusBar
	) == "function" then
		SecretWatch:UpdateStatusBar()
	end

	UpdateLagProfilerUI(
		Now,
		Force
	)
end

