LocalPlayer.CharacterAdded:Connect(function(Character)
	RestoreCollisions()
	LastJumpPulse = 0
	FlyState.YLevel = nil
	ResetFlyInput()

	local Humanoid =
		Character:WaitForChild("Humanoid", 10)

	local Root =
		Character:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if ResettingAfterDisable then
		local SavedCFrame =
			ReturnCFrameAfterReset

		if Humanoid then
			Humanoid.Sit = false
			Humanoid.PlatformStand = false
			Humanoid.AutoRotate = true

			pcall(function()
				Humanoid:ChangeState(
					Enum.HumanoidStateType.GettingUp
				)
			end)
		end

		if Root and SavedCFrame then
			task.wait(0.15)

			if Root.Parent then
				Root.CFrame = SavedCFrame
				Root.AssemblyLinearVelocity =
					Vector3.zero
				Root.AssemblyAngularVelocity =
					Vector3.zero
			end
		end

		ReturnCFrameAfterReset = nil
		ResettingAfterDisable = false
		return
	end

	task.wait(0.75)

	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	if FlyState.Enabled and Root then
		FlyState.YLevel = Root.Position.Y
	end

	if Enabled then
		ForceNoclip()
		EquipStrongestWeapon()

		if not FlyState.Enabled then
			ApplyHumanoidState(GetHumanoid())
			PulseJump()
		end
	elseif not FlyState.Enabled then
		ReleaseHumanoidState()
	end
end)

local function SelectEnemyChoice(Value)
	if not MobDefinitions[Value] then
		return
	end

	SelectedMobChoice = Value

	if Enabled then
		local Root = GetRoot()

		if Root then
			LastHeldCFrame = Root.CFrame
		end
	end

	CurrentMob = nil
	CurrentMobIndex = 0
	WaitingForEnemy = false
	WaitingCFrame = nil
	CachedMobList = {}
	MobScanDirty = true

	if Enabled then
		BindEnemyFolderWatchers()
	end
end

