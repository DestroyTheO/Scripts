--==================================================
-- SAFE PART LOOKUP
--==================================================
local function FindValidPart(Object)
	if not Object then
		return nil
	end

	if Object:IsA("BasePart") then
		return Object
	end

	local PreferredNames = {
		"HumanoidRootPart",
		"RootPart",
		"UpperTorso",
		"Torso",
		"LowerTorso",
		"Head",
	}

	for _, Name in ipairs(PreferredNames) do
		local Part = Object:FindFirstChild(Name, true)

		if Part and Part:IsA("BasePart") then
			return Part
		end
	end

	if Object:IsA("Model") then
		local PrimaryPart = Object.PrimaryPart

		if PrimaryPart and PrimaryPart:IsA("BasePart") then
			return PrimaryPart
		end
	end

	for _, Descendant in ipairs(Object:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			return Descendant
		end
	end

	return nil
end

--==================================================
-- MOB HEALTH
--==================================================
local function GetMobHealth(Mob)
	if not Mob then
		return 0
	end

	local Humanoid = Mob:FindFirstChildWhichIsA("Humanoid", true)

	if Humanoid then
		return Humanoid.Health
	end

	local HealthValue =
		Mob:FindFirstChild("Health", true)
		or Mob:FindFirstChild("HP", true)
		or Mob:FindFirstChild("HitPoints", true)

	if HealthValue and (
		HealthValue:IsA("NumberValue")
		or HealthValue:IsA("IntValue")
	) then
		return HealthValue.Value
	end

	local HealthAttribute =
		Mob:GetAttribute("Health")
		or Mob:GetAttribute("HP")
		or Mob:GetAttribute("HitPoints")

	if type(HealthAttribute) == "number" then
		return HealthAttribute
	end

	-- If no readable health value exists, treat it as alive while
	-- it still has a usable physical part.
	return FindValidPart(Mob) and math.huge or 0
end

--==================================================
-- TRANSPARENCY CHECK
--==================================================
local function IsFullyTransparent(Mob)
	if not Mob then
		return true
	end

	local FoundPart = false

	if Mob:IsA("BasePart") then
		return Mob.Transparency >= 1
	end

	for _, Descendant in ipairs(Mob:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			FoundPart = true

			if Descendant.Transparency < 1 then
				return false
			end
		end
	end

	return not FoundPart
end

--==================================================
-- MOB VALIDATION
--==================================================
local function IsMobValid(Mob)
	if not Mob or not Mob.Parent then
		return false
	end

	local SearchRoot = GetMobSearchRoot()
	local Character = GetCharacter()

	if not SearchRoot
		or not Mob:IsDescendantOf(SearchRoot) then
		return false
	end

	-- Never treat the local player's character as a mob.
	if Character
		and (
			Mob == Character
			or Mob:IsDescendantOf(Character)
		) then
		return false
	end

	if GetMobHealth(Mob) <= 0 then
		return false
	end

	if IsFullyTransparent(Mob) then
		return false
	end

	local RootPart = FindValidPart(Mob)

	if not RootPart or not RootPart.Parent then
		return false
	end

	return true
end

--==================================================
-- EVENT-DRIVEN MOB CACHE
--==================================================
local function DisconnectConnectionList(ConnectionList)
	for Index = #ConnectionList, 1, -1 do
		local Connection = ConnectionList[Index]

		if Connection then
			pcall(function()
				Connection:Disconnect()
			end)
		end

		ConnectionList[Index] = nil
	end
end

local function MarkMobScanDirty()
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	MobScanDirty = true
end

local function GetSelectedMobDefinition()
	return MobDefinitions[SelectedMobChoice]
end

local function FindSelectedEnemyDirect()
	local Definition = GetSelectedMobDefinition()
	local Enemies = Workspace:FindFirstChild("Enemies")

	-- Keep following the current living target every frame.
	if Definition
		and CurrentMob
		and CurrentMob.Name == Definition.InstanceName
		and IsMobValid(CurrentMob) then
		return CurrentMob
	end

	CurrentMob = nil
	CurrentMobIndex = 0

	-- When no matching enemy exists, do not repeatedly scan.
	-- A workspace.Enemies descendant event marks MobScanDirty again.
	if WaitingForEnemy and not MobScanDirty then
		return nil
	end

	if not Definition or not Enemies then
		WaitingForEnemy = true
		MobScanDirty = false
		return nil
	end

	local Root = GetRoot()
	local OriginPosition =
		Root and Root.Position or Vector3.zero

	local ClosestMob = nil
	local ClosestDistance = math.huge
	local MatchingIndex = 0
	local ClosestIndex = 0

	-- Find every separate matching mob/boss under workspace.Enemies.
	for _, Object in ipairs(Enemies:GetDescendants()) do
		if Object.Name == Definition.InstanceName
			and (
				Object:IsA("Model")
				or Object:IsA("BasePart")
				or Object:IsA("Folder")
			) then

			-- Ignore matching descendants nested inside another
			-- matching mob container.
			local NestedInsideMatch = false
			local Parent = Object.Parent

			while Parent and Parent ~= Enemies do
				if Parent.Name == Definition.InstanceName
					and (
						Parent:IsA("Model")
						or Parent:IsA("BasePart")
						or Parent:IsA("Folder")
					) then
					NestedInsideMatch = true
					break
				end

				Parent = Parent.Parent
			end

			if not NestedInsideMatch
				and IsMobValid(Object) then
				MatchingIndex += 1

				local Part = FindValidPart(Object)

				if Part then
					local Distance =
						(
							Part.Position
							- OriginPosition
						).Magnitude

					if Distance < ClosestDistance then
						ClosestDistance = Distance
						ClosestMob = Object
						ClosestIndex = MatchingIndex
					end
				end
			end
		end
	end

	MobScanDirty = false

	if not ClosestMob then
		WaitingForEnemy = true
		return nil
	end

	CurrentMob = ClosestMob
	CurrentMobIndex = ClosestIndex
	WaitingForEnemy = false
	WaitingCFrame = nil

	return ClosestMob
end

local function IsSelectedMobContainer(Object)
	local Definition = GetSelectedMobDefinition()

	return Definition
		and Object
		and Object.Name == Definition.InstanceName
		and (
			Object:IsA("Model")
			or Object:IsA("BasePart")
			or Object:IsA("Folder")
		)
end

local function IsInsideAnotherSelectedMob(
	Object,
	SearchRoot
)
	local Parent = Object.Parent

	while Parent and Parent ~= SearchRoot do
		if IsSelectedMobContainer(Parent) then
			return true
		end

		Parent = Parent.Parent
	end

	return false
end

local function AddCandidateConnection(Connection)
	if Connection then
		table.insert(
			CandidateWatchConnections,
			Connection
		)
	end
end

local function WatchHealthOrPart(Object)
	if Object:IsA("Humanoid") then
		AddCandidateConnection(
			Object.HealthChanged:Connect(
				MarkMobScanDirty
			)
		)

	elseif (
		Object:IsA("NumberValue")
		or Object:IsA("IntValue")
	) and (
		Object.Name == "Health"
		or Object.Name == "HP"
		or Object.Name == "HitPoints"
	) then
		AddCandidateConnection(
			Object.Changed:Connect(
				MarkMobScanDirty
			)
		)

	elseif Object:IsA("BasePart") then
		AddCandidateConnection(
			Object:GetPropertyChangedSignal(
				"Transparency"
			):Connect(MarkMobScanDirty)
		)
	end
end

local function WatchCandidateMob(Mob)
	AddCandidateConnection(
		Mob.AncestryChanged:Connect(
			MarkMobScanDirty
		)
	)

	AddCandidateConnection(
		Mob.DescendantAdded:Connect(function(Object)
			WatchHealthOrPart(Object)
			MarkMobScanDirty()
		end)
	)

	AddCandidateConnection(
		Mob.DescendantRemoving:Connect(
			MarkMobScanDirty
		)
	)

	for _, Object in ipairs(Mob:GetDescendants()) do
		WatchHealthOrPart(Object)
	end

	for _, AttributeName in ipairs({
		"Health",
		"HP",
		"HitPoints",
	}) do
		AddCandidateConnection(
			Mob:GetAttributeChangedSignal(
				AttributeName
			):Connect(MarkMobScanDirty)
		)
	end
end

local function FindSelectedContainerAncestor(Object)
	local SearchRoot = GetMobSearchRoot()
	local Current = Object

	while Current and Current ~= SearchRoot do
		if IsSelectedMobContainer(Current) then
			return Current
		end

		Current = Current.Parent
	end

	return nil
end

local function WorkspaceChangeCouldAffectSelection(Object)
	if not Object then
		return false
	end

	if IsSelectedMobContainer(Object) then
		return true
	end

	return FindSelectedContainerAncestor(Object) ~= nil
end

local function BindEnemyFolderWatchers()
	local SearchRoot = GetMobSearchRoot()

	if SearchRoot == BoundEnemiesFolder
		and #FolderWatchConnections > 0 then
		return SearchRoot
	end

	DisconnectConnectionList(FolderWatchConnections)
	BoundEnemiesFolder = SearchRoot

	if SearchRoot then
		table.insert(
			FolderWatchConnections,
			SearchRoot.DescendantAdded:Connect(function(Object)
				if WorkspaceChangeCouldAffectSelection(Object) then
					MarkMobScanDirty()
				end
			end)
		)

		table.insert(
			FolderWatchConnections,
			SearchRoot.DescendantRemoving:Connect(function(Object)
				if WorkspaceChangeCouldAffectSelection(Object) then
					MarkMobScanDirty()
				end
			end)
		)
	end

	return SearchRoot
end

local function StopMobScanning()
	DisconnectConnectionList(FolderWatchConnections)
	DisconnectConnectionList(CandidateWatchConnections)

	BoundEnemiesFolder = nil
	CachedMobList = {}
	MobScanDirty = true
end

local function RebuildMobCache()
	DisconnectConnectionList(CandidateWatchConnections)

	local SearchRoot =
		BindEnemyFolderWatchers()

	CachedMobList = {}

	if not SearchRoot then
		MobScanDirty = false
		return CachedMobList
	end

	local Definition = GetSelectedMobDefinition()

	if not Definition then
		MobScanDirty = false
		return CachedMobList
	end

	local Character = GetCharacter()

	-- Search the entire currently loaded workspace. This scan runs
	-- once after a relevant selected-mob event, not every frame.
	for _, Object in ipairs(
		SearchRoot:GetDescendants()
	) do
		local InsideCharacter =
			Character
			and (
				Object == Character
				or Object:IsDescendantOf(Character)
			)

		if not InsideCharacter
			and IsSelectedMobContainer(Object)
			and not IsInsideAnotherSelectedMob(
				Object,
				SearchRoot
			) then
			table.insert(CachedMobList, Object)
			WatchCandidateMob(Object)
		end
	end

	local Root = GetRoot()

	if Root then
		table.sort(CachedMobList, function(Left, Right)
			local LeftPart = FindValidPart(Left)
			local RightPart = FindValidPart(Right)

			local LeftDistance =
				LeftPart
				and (LeftPart.Position - Root.Position).Magnitude
				or math.huge

			local RightDistance =
				RightPart
				and (RightPart.Position - Root.Position).Magnitude
				or math.huge

			return LeftDistance < RightDistance
		end)
	end

	MobScanDirty = false
	return CachedMobList
end

local function GetMobList()
	if MobScanDirty then
		return RebuildMobCache()
	end

	return CachedMobList
end

local function GetDistanceToMob(
	Mob,
	OriginPosition
)
	if not Mob or not OriginPosition then
		return math.huge
	end

	local MobPart = FindValidPart(Mob)

	if not MobPart or not MobPart.Parent then
		return math.huge
	end

	return (
		MobPart.Position - OriginPosition
	).Magnitude
end

--==================================================
-- CLOSEST LIVING MOB / BOSS
--==================================================
local function FindNextLivingMob()
	local Mobs = GetMobList()
	local Root = GetRoot()

	if #Mobs == 0 or not Root then
		CurrentMob = nil
		CurrentMobIndex = 0
		WaitingForEnemy = true
		return nil
	end

	local ClosestMob = nil
	local ClosestIndex = 0
	local ClosestDistance = math.huge
	local OriginPosition = Root.Position

	for Index, Mob in ipairs(Mobs) do
		if IsMobValid(Mob) then
			local Distance =
				GetDistanceToMob(
					Mob,
					OriginPosition
				)

			if Distance < ClosestDistance then
				ClosestMob = Mob
				ClosestIndex = Index
				ClosestDistance = Distance
			end
		end
	end

	if not ClosestMob then
		CurrentMob = nil
		CurrentMobIndex = 0
		WaitingForEnemy = true
		return nil
	end

	local TargetChanged =
		CurrentMob ~= ClosestMob

	CurrentMob = ClosestMob
	CurrentMobIndex = ClosestIndex
	WaitingForEnemy = false
	WaitingCFrame = nil

	if TargetChanged then
		end

	Root.Anchored = false
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero

	return ClosestMob
end

local function RefreshCurrentMob()
	-- A workspace, health, or transparency event may reveal a closer
	-- selected enemy. Rebuild once and immediately choose the closest.
	if MobScanDirty then
		return FindNextLivingMob()
	end

	if IsMobValid(CurrentMob) then
		return CurrentMob
	end

	-- While no relevant workspace event occurs, stay at the saved
	-- waiting height without repeatedly scanning.
	if WaitingForEnemy then
		return nil
	end

	return FindNextLivingMob()
end

