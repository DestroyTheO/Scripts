local function GetCharacter()
	return LocalPlayer.Character
end

local function GetHumanoid()
	local Character = GetCharacter()

	return Character
		and Character:FindFirstChildWhichIsA("Humanoid")
end

local function GetRoot()
	local Character = GetCharacter()

	return Character
		and Character:FindFirstChild("HumanoidRootPart")
end

local function IsPlayerAlive()
	local Humanoid = GetHumanoid()

	return Humanoid and Humanoid.Health > 0
end

local function CalculateFlyMoveVector(Vector)
	local Camera = Workspace.CurrentCamera

	if not Camera then
		return Vector3.zero
	end

	local _, _, _, R00, R01, R02, _, _, R12, _, _, R22 =
		Camera.CFrame:GetComponents()

	local C
	local S

	if R12 < 1 and R12 > -1 then
		C = R22
		S = R02
	else
		C = R00
		S = -R01 * math.sign(R12)
	end

	Vector = Vector3.new(
		(C * Vector.X + S * Vector.Z),
		0,
		(C * Vector.Z - S * Vector.X)
	)

	local Magnitude = math.sqrt(C * C + S * S)

	Vector =
		Magnitude > 0
		and Vector / Magnitude
		or Vector3.zero

	return Vector.Magnitude > 0
		and Vector.Unit
		or Vector3.zero
end

--==================================================
-- STRONGEST BACKPACK WEAPON
--==================================================
local function GetHighestDamageValue(Damage)
	if type(Damage) == "number" then
		return Damage
	end

	if type(Damage) ~= "table" then
		return nil
	end

	local Highest = nil

	for _, Value in pairs(Damage) do
		if type(Value) == "number" then
			if Highest == nil or Value > Highest then
				Highest = Value
			end
		end
	end

	return Highest
end

local function ReadToolDamage(Tool)
	if not Tool or not Tool:IsA("Tool") then
		return nil
	end

	local Configuration =
		Tool:FindFirstChild("Configuration")

	if not Configuration
		or not Configuration:IsA("ModuleScript") then
		return nil
	end

	local Success, Config = pcall(require, Configuration)

	if not Success or type(Config) ~= "table" then
		return nil
	end

	return GetHighestDamageValue(Config.Damage)
end

local function FindStrongestWeapon()
	local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local Character = GetCharacter()

	local BestTool = nil
	local BestDamage = -math.huge

	local function CheckContainer(Container)
		if not Container then
			return
		end

		for _, Object in ipairs(Container:GetChildren()) do
			if Object:IsA("Tool") then
				local Damage = ReadToolDamage(Object)

				if Damage
					and (
						Damage > BestDamage
						or (
							Damage == BestDamage
							and BestTool
							and Object.Name < BestTool.Name
						)
					) then
					BestTool = Object
					BestDamage = Damage
				end
			end
		end
	end

	-- Check both places because an equipped Tool moves from Backpack
	-- into the character.
	CheckContainer(Backpack)
	CheckContainer(Character)

	return BestTool, BestDamage
end

local function EquipStrongestWeapon()
	local Humanoid = GetHumanoid()

	if not Humanoid or Humanoid.Health <= 0 then
		return
	end

	local BestTool, BestDamage =
		FindStrongestWeapon()

	CurrentBestWeapon = BestTool
	CurrentBestWeaponDamage =
		BestDamage or -math.huge

	if not BestTool then
		return
	end

	local Character = GetCharacter()

	if BestTool.Parent == Character then
		return
	end

	pcall(function()
		Humanoid:EquipTool(BestTool)
	end)
end

--==================================================
-- LIGHTWEIGHT REVERSIBLE NOCLIP
--==================================================
local function ForceNoclip()
	local Character = GetCharacter()

	if not Character then
		return
	end

	for _, Object in ipairs(Character:GetDescendants()) do
		if Object:IsA("BasePart") then
			if CollisionStates[Object] == nil then
				CollisionStates[Object] = Object.CanCollide
			end

			Object.CanCollide = false
		end
	end
end

local function RestoreCollisions()
	for Part, OriginalState in pairs(CollisionStates) do
		if typeof(Part) == "Instance"
			and Part:IsA("BasePart")
			and Part.Parent then
			pcall(function()
				Part.CanCollide = OriginalState == true
			end)
		end

		CollisionStates[Part] = nil
	end
end

Environment.__CrimmyRestoreEnemyNoclip =
	RestoreCollisions

