-- CHRONYX SHARD PRIORITY
--==================================================
local function GetChronyxShardsFolder()
	local GameMaps =
		Workspace:FindFirstChild(
			"GameMaps"
		)

	local SuperbossMaps =
		GameMaps
		and GameMaps:FindFirstChild(
			"Superboss Maps"
		)

	local ChronyxMap =
		SuperbossMaps
		and SuperbossMaps:FindFirstChild(
			"Chronyx"
		)

	return ChronyxMap
		and ChronyxMap:FindFirstChild(
			"ChronyxShards"
		)
end

local function IsChronyxShardValid(
	Shard
)
	if not Shard
		or not Shard.Parent then
		return false
	end

	local ShardsFolder =
		GetChronyxShardsFolder()

	if not ShardsFolder
		or not Shard:IsDescendantOf(
			ShardsFolder
		) then
		return false
	end

	if not (
		Shard:IsA("Model")
		or Shard:IsA("BasePart")
	) then
		return false
	end

	local Character = GetCharacter()

	if Character
		and (
			Shard == Character
			or Shard:IsDescendantOf(
				Character
			)
		) then
		return false
	end

	if GetMobHealth(Shard) <= 0 then
		return false
	end

	return GetObjectWorldPivot(Shard)
		~= nil
end

local function IsNestedChronyxShard(
	Object,
	ShardsFolder
)
	local Parent = Object.Parent

	while Parent
		and Parent ~= ShardsFolder do
		if Parent:IsA("Model")
			or Parent:IsA("BasePart") then
			return true
		end

		Parent = Parent.Parent
	end

	return false
end

local function RefreshChronyxShardCache(
	Force
)
	local Now = os.clock()

	if not Force
		and not TargetState.ShardCacheDirty then
		return TargetState.ShardCache
	end

	if not Force
		and Now
			- TargetState.LastShardRefresh
			< TargetState.ShardRefreshInterval then
		return TargetState.ShardCache
	end

	TargetState.LastShardRefresh = Now
	table.clear(TargetState.ShardCache)

	local ShardsFolder =
		GetChronyxShardsFolder()

	TargetState.ShardWatchFolder =
		ShardsFolder

	if not ShardsFolder then
		TargetState.ShardCount = 0
		TargetState.ShardCacheDirty = false
		DiagnosticsState.ShardsRemaining = 0
		return TargetState.ShardCache
	end

	for _, Object in ipairs(
		ShardsFolder:GetDescendants()
	) do
		if (
			Object:IsA("Model")
			or Object:IsA("BasePart")
		)
			and not IsNestedChronyxShard(
				Object,
				ShardsFolder
			)
			and IsChronyxShardValid(
				Object
			) then
			table.insert(
				TargetState.ShardCache,
				Object
			)
		end
	end

	TargetState.ShardCount =
		#TargetState.ShardCache
	TargetState.ShardCacheDirty = false
	DiagnosticsState.ShardsRemaining =
		TargetState.ShardCount

	return TargetState.ShardCache
end

RefreshChronyxShardCache =
	ProfileFunction(
		"Shard Cache Scan",
		RefreshChronyxShardCache
	)

local function FindClosestChronyxShard(
	OriginPosition
)
	local Shards =
		RefreshChronyxShardCache(false)

	local ClosestShard = nil
	local ClosestDistance = math.huge

	for _, Object in ipairs(Shards) do
		if IsChronyxShardValid(Object) then
			local WorldPivot =
				GetObjectWorldPivot(Object)

			if WorldPivot then
				local Distance =
					(
						WorldPivot.Position
						- OriginPosition
					).Magnitude

				if Distance < ClosestDistance then
					ClosestDistance =
						Distance
					ClosestShard = Object
				end
			end
		else
			TargetState.ShardCacheDirty =
				true
		end
	end

	return ClosestShard
end

--==================================================
-- CONNECTION CLEANUP
--==================================================
local function DisconnectConnectionList(
	ConnectionList
)
	if type(ConnectionList) ~= "table" then
		return
	end

	for Index = #ConnectionList, 1, -1 do
		local Connection =
			ConnectionList[Index]

		if Connection then
			pcall(function()
				Connection:Disconnect()
			end)
		end

		ConnectionList[Index] = nil
	end
end

local function CountChronyxShards()
	RefreshChronyxShardCache(false)
	return TargetState.ShardCount
end

local function MarkChronyxShardChanged()
	TargetState.ShardCacheDirty = true
	TargetState.ScanDirty = true
	TargetState.LastDirectScan = 0
	TargetState.LastResolve = 0

	if TargetState.ShardRefreshQueued then
		return
	end

	TargetState.ShardRefreshQueued = true

	task.delay(0.08, function()
		TargetState.ShardRefreshQueued = false

		if ScriptToken
			~= Environment.__CrimmyAutoEnemyController then
			return
		end

		RefreshChronyxShardCache(true)

		if TargetState.IsChronyxShard
			and not IsChronyxShardValid(
				TargetState.Current
			) then
			TargetState.Current = nil
			TargetState.CurrentIndex = 0
			TargetState.IsChronyxShard = false

			FollowMovement.LastTarget = nil
			FollowMovement.LastCharacter = nil
			FollowMovement.InitialTeleportPending =
				true
		end
	end)
end

local function BindChronyxShardWatchers(
	ForceRebind
)
	local ShardsFolder =
		GetChronyxShardsFolder()

	if not ForceRebind
		and TargetState.ShardWatchFolder
			== ShardsFolder
		and #TargetState.ShardConnections
			> 0 then
		return ShardsFolder
	end

	DisconnectConnectionList(
		TargetState.ShardConnections
	)

	TargetState.ShardWatchFolder =
		ShardsFolder
	TargetState.ShardCacheDirty = true

	if not ShardsFolder then
		RefreshChronyxShardCache(true)
		return nil
	end

	local function WatchHealthObject(
		Object
	)
		if Object:IsA("Humanoid") then
			table.insert(
				TargetState.ShardConnections,
				Object.HealthChanged:
					Connect(function(Health)
						if tonumber(Health)
							and Health <= 0 then
							MarkChronyxShardChanged()
						end
					end)
			)

		elseif (
			Object:IsA("NumberValue")
			or Object:IsA("IntValue")
		)
			and (
				Object.Name == "Health"
				or Object.Name == "HP"
				or Object.Name
					== "HitPoints"
			) then
			table.insert(
				TargetState.ShardConnections,
				Object.Changed:Connect(
					function(Value)
						if tonumber(Value)
							and Value <= 0 then
							MarkChronyxShardChanged()
						end
					end
				)
			)
		end
	end

	table.insert(
		TargetState.ShardConnections,
		ShardsFolder.DescendantAdded:
			Connect(function(Object)
				WatchHealthObject(Object)
				MarkChronyxShardChanged()
			end)
	)

	table.insert(
		TargetState.ShardConnections,
		ShardsFolder.DescendantRemoving:
			Connect(
				MarkChronyxShardChanged
			)
	)

	for _, Object in ipairs(
		ShardsFolder:GetDescendants()
	) do
		WatchHealthObject(Object)
	end

	RefreshChronyxShardCache(true)
	return ShardsFolder
end

local function BindChronyxHierarchyWatchers(
	ForceRebind
)
	if not ForceRebind
		and #TargetState.WorkspaceShardConnections
			> 0 then
		return
	end

	DisconnectConnectionList(
		TargetState.WorkspaceShardConnections
	)

	local function WatchNamedChild(
		Parent,
		ExpectedName
	)
		if not Parent then
			return
		end

		local function HierarchyChanged(
			Object
		)
			if not Object
				or Object.Name
					~= ExpectedName then
				return
			end

			TargetState.ShardCacheDirty = true

			task.defer(function()
				if ScriptToken
					~= Environment.__CrimmyAutoEnemyController then
					return
				end

				BindChronyxHierarchyWatchers(
					true
				)
				BindChronyxShardWatchers(
					true
				)
				MarkChronyxShardChanged()
			end)
		end

		table.insert(
			TargetState.WorkspaceShardConnections,
			Parent.ChildAdded:Connect(
				HierarchyChanged
			)
		)

		table.insert(
			TargetState.WorkspaceShardConnections,
			Parent.ChildRemoved:Connect(
				HierarchyChanged
			)
		)
	end

	local GameMaps =
		Workspace:FindFirstChild(
			"GameMaps"
		)

	local SuperbossMaps =
		GameMaps
		and GameMaps:FindFirstChild(
			"Superboss Maps"
		)

	local ChronyxMap =
		SuperbossMaps
		and SuperbossMaps:FindFirstChild(
			"Chronyx"
		)

	WatchNamedChild(
		Workspace,
		"GameMaps"
	)
	WatchNamedChild(
		GameMaps,
		"Superboss Maps"
	)
	WatchNamedChild(
		SuperbossMaps,
		"Chronyx"
	)
	WatchNamedChild(
		ChronyxMap,
		"ChronyxShards"
	)
end

local function MarkMobScanDirty()
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	TargetState.ScanDirty = true
	TargetState.LastDirectScan = 0
	TargetState.LastResolve = 0
	DiagnosticsState.LastUpdate = 0
end

local function GetSelectedMobDefinition()
	if IsMultiModeEnabled()
		and FarmState.CurrentMultiChoice then
		return MobDefinitions[FarmState.CurrentMultiChoice]
	end

	return MobDefinitions[FarmState.SelectedMobChoice]
end

local function NormalizeEnemyName(Name)
	return string.lower(
		tostring(Name or "")
			:gsub("[^%w]", "")
	)
end

local function MatchesSelectedEnemyName(
	ObjectName,
	Definition
)
	if not Definition then
		return false
	end

	local NormalizedObject =
		NormalizeEnemyName(ObjectName)

	local Names = {
		Definition.InstanceName,
	}

	if type(Definition.Aliases) == "table" then
		for _, Alias in ipairs(Definition.Aliases) do
			table.insert(Names, Alias)
		end
	end

	for _, Name in ipairs(Names) do
		local NormalizedName =
			NormalizeEnemyName(Name)

		if NormalizedObject == NormalizedName then
			return true
		end

		-- Prefix matching is opt-in. This prevents selections such as
		-- Goblin from accidentally matching Goblin Brute.
		if Definition.AllowPrefixMatch == true
			and NormalizedObject:sub(
				1,
				#NormalizedName
			) == NormalizedName then
			return true
		end
	end

	return false
end

local function GetChoiceForEnemyName(
	ObjectName
)
	for _, Choice in ipairs(MobDropdownItems) do
		if MatchesSelectedEnemyName(
			ObjectName,
			MobDefinitions[Choice]
		) then
			return Choice
		end
	end

	for _, Choice in ipairs(BossDropdownItems) do
		if MatchesSelectedEnemyName(
			ObjectName,
			MobDefinitions[Choice]
		) then
			return Choice
		end
	end

	return nil
end

local function MatchesAnyActiveEnemyName(
	ObjectName
)
	if IsMultiModeEnabled() then
		for _, Choice in ipairs(FarmState.MultiTargetOrder) do
			if MatchesSelectedEnemyName(
				ObjectName,
				MobDefinitions[Choice]
			) then
				return true
			end
		end

		return false
	end

	return MatchesSelectedEnemyName(
		ObjectName,
		MobDefinitions[FarmState.SelectedMobChoice]
	)
end

local function IsNestedEnemyContainer(
	Object,
	Enemies
)
	local Parent = Object.Parent

	while Parent and Parent ~= Enemies do
		if (
			Parent:IsA("Model")
			or Parent:IsA("BasePart")
		)
			and GetChoiceForEnemyName(
				Parent.Name
			) then
			return true
		end

		Parent = Parent.Parent
	end

	return false
end

local function FindClosestEnemyForDefinition(
	Definition,
	Enemies,
	OriginPosition
)
	if not Definition or not Enemies then
		return nil
	end

	-- Super bosses such as Chronyx are stored directly under
	-- workspace.Enemies. Resolve that exact object first so a nested
	-- part/model with the same name cannot be selected by mistake.
	if Definition.DirectEnemyChild == true then
		local DirectEnemy =
			Enemies:FindFirstChild(
				Definition.InstanceName
			)

		if DirectEnemy
			and (
				DirectEnemy:IsA("Model")
				or DirectEnemy:IsA("BasePart")
			)
			and IsMobValid(DirectEnemy) then
			return DirectEnemy
		end

		return nil
	end

	local ClosestMob = nil
	local ClosestDistance = math.huge

	for _, Object in ipairs(
		Enemies:GetDescendants()
	) do
		if MatchesSelectedEnemyName(
			Object.Name,
			Definition
		)
			and (
				Object:IsA("Model")
				or Object:IsA("BasePart")
			)
			and not IsNestedEnemyContainer(
				Object,
				Enemies
			)
			and IsMobValid(Object) then

			local WorldPivot =
				GetObjectWorldPivot(Object)

			if WorldPivot then
				local Distance =
					(
						WorldPivot.Position
						- OriginPosition
					).Magnitude

				if Distance < ClosestDistance then
					ClosestDistance = Distance
					ClosestMob = Object
				end
			end
		end
	end

	return ClosestMob
end

local function GetActiveEnemyChoices()
	if IsMultiModeEnabled() then
		RefreshMultiTargetOrder()
		return FarmState.MultiTargetOrder
	end

	return {
		FarmState.SelectedMobChoice,
	}
end

local function BuildActiveEnemyLookup(
	Choices
)
	local ExactLookup = {}
	local PrefixEntries = {}

	for _, Choice in ipairs(Choices) do
		local Definition =
			MobDefinitions[Choice]

		if Definition
			and Definition.DirectEnemyChild
				~= true then
			local Names = {
				Definition.InstanceName,
			}

			if type(Definition.Aliases)
				== "table" then
				for _, Alias in ipairs(
					Definition.Aliases
				) do
					table.insert(
						Names,
						Alias
					)
				end
			end

			for _, Name in ipairs(Names) do
				local Normalized =
					NormalizeEnemyName(Name)

				if Normalized ~= "" then
					ExactLookup[Normalized] =
						Choice

					if Definition.AllowPrefixMatch
						== true then
						table.insert(
							PrefixEntries,
							{
								Prefix =
									Normalized,
								Choice =
									Choice,
							}
						)
					end
				end
			end
		end
	end

	return ExactLookup, PrefixEntries
end

local function ResolveCachedChoiceForName(
	ObjectName,
	ExactLookup,
	PrefixEntries
)
	local Normalized =
		NormalizeEnemyName(
			ObjectName
		)

	local ExactChoice =
		ExactLookup[Normalized]

	if ExactChoice then
		return ExactChoice
	end

	for _, Entry in ipairs(
		PrefixEntries
	) do
		if Normalized:sub(
			1,
			#Entry.Prefix
		) == Entry.Prefix then
			return Entry.Choice
		end
	end

	return nil
end

local function RefreshEnemyEventLookup()
	local Choices =
		GetActiveEnemyChoices()

	local ExactLookup, PrefixEntries =
		BuildActiveEnemyLookup(
			Choices
		)

	TargetState.EventExactLookup =
		ExactLookup
	TargetState.EventPrefixEntries =
		PrefixEntries
end

local function RefreshActiveMobCache(
	Enemies,
	Force
)
	local Choices =
		GetActiveEnemyChoices()

	local ModeKey =
		table.concat(
			Choices,
			"\30"
		)

	if ModeKey
		~= TargetState.MobCacheModeKey then
		TargetState.MobCacheModeKey =
			ModeKey
		TargetState.ScanDirty = true
	end

	if not Force
		and not TargetState.ScanDirty then
		return TargetState.MobCacheByChoice
	end

	table.clear(
		TargetState.MobCacheByChoice
	)

	for _, Choice in ipairs(Choices) do
		TargetState.MobCacheByChoice[
			Choice
		] = {}
	end

	if not Enemies then
		TargetState.ScanDirty = false
		TargetState.LastMobCacheRefresh =
			os.clock()
		return TargetState.MobCacheByChoice
	end

	local ExactLookup, PrefixEntries =
		BuildActiveEnemyLookup(
			Choices
		)

	local function IsNestedActiveEnemy(
		Object
	)
		local Parent = Object.Parent

		while Parent
			and Parent ~= Enemies do
			if (
				Parent:IsA("Model")
				or Parent:IsA("BasePart")
			)
				and ResolveCachedChoiceForName(
					Parent.Name,
					ExactLookup,
					PrefixEntries
				) then
				return true
			end

			Parent = Parent.Parent
		end

		return false
	end

	local function AddCandidate(
		Object,
		AllowedChoices
	)
		if not Object
			or not (
				Object:IsA("Model")
				or Object:IsA("BasePart")
			) then
			return false
		end

		local Choice =
			ResolveCachedChoiceForName(
				Object.Name,
				ExactLookup,
				PrefixEntries
			)

		if not Choice
			or (
				AllowedChoices
				and not AllowedChoices[
					Choice
				]
			)
			or IsNestedActiveEnemy(
				Object
			)
			or not IsMobValid(Object) then
			return false
		end

		local ChoiceCache =
			TargetState.MobCacheByChoice[
				Choice
			]

		if not ChoiceCache then
			ChoiceCache = {}
			TargetState.MobCacheByChoice[
				Choice
			] = ChoiceCache
		end

		table.insert(
			ChoiceCache,
			Object
		)

		return true
	end

	-- Cheap first pass for the common layout.
	for _, Object in ipairs(
		Enemies:GetChildren()
	) do
		if AddCandidate(
			Object,
			nil
		) then
			TargetState.MobDirectCandidates +=
				1
		end
	end

	-- A mixed layout can contain direct enemies and nested enemies at
	-- the same time. Build a lookup only for active choices that the
	-- direct pass did not find.
	local MissingChoices = {}
	local MissingCount = 0

	for _, Choice in ipairs(Choices) do
		local ChoiceCache =
			TargetState.MobCacheByChoice[
				Choice
			]

		if not ChoiceCache
			or #ChoiceCache == 0 then
			MissingChoices[Choice] = true
			MissingCount += 1
		end
	end

	if MissingCount > 0 then
		TargetState.MobDescendantFallbacks +=
			1

		for _, Object in ipairs(
			Enemies:GetDescendants()
		) do
			if Object.Parent ~= Enemies
				and AddCandidate(
					Object,
					MissingChoices
				) then
				TargetState.MobDescendantCandidates +=
					1
			end
		end
	end

	TargetState.ScanDirty = false
	TargetState.LastMobCacheRefresh =
		os.clock()
	TargetState.MobCacheScanCount += 1

	return TargetState.MobCacheByChoice
end

