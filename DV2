local function RebuildMobCache()
	DisconnectConnectionList(TargetState.CandidateConnections)

	local SearchRoot =
		BindEnemyFolderWatchers()

	TargetState.CachedList = {}

	if not SearchRoot then
		TargetState.ScanDirty = false
		return TargetState.CachedList
	end

	local Definition = GetSelectedMobDefinition()

	if not Definition then
		TargetState.ScanDirty = false
		return TargetState.CachedList
	end

	local Character = GetCharacter()

	-- Search the entire currently loaded workspace. This scan runs
	-- once after a relevant selected-mob event, not every frame.
	for _, Object in ipairs(
		SearchRoot:GetDescendants()
	) do
		local InsideCharacter =
			Character
			and (
				Object == Character
				or Object:IsDescendantOf(Character)
			)

		if not InsideCharacter
			and IsSelectedMobContainer(Object)
			and not IsInsideAnotherSelectedMob(
				Object,
				SearchRoot
			) then
			table.insert(TargetState.CachedList, Object)
			WatchCandidateMob(Object)
		end
	end

	local Root = GetRoot()

	if Root then
		table.sort(TargetState.CachedList, function(Left, Right)
			local LeftPart = FindValidPart(Left)
			local RightPart = FindValidPart(Right)

			local LeftDistance =
				LeftPart
				and (LeftPart.Position - Root.Position).Magnitude
				or math.huge

			local RightDistance =
				RightPart
				and (RightPart.Position - Root.Position).Magnitude
				or math.huge

			return LeftDistance < RightDistance
		end)
	end

	TargetState.ScanDirty = false
	return TargetState.CachedList
end

local function GetMobList()
	if TargetState.ScanDirty then
		return RebuildMobCache()
	end

	return TargetState.CachedList
end

local function GetDistanceToMob(
	Mob,
	OriginPosition
)
	if not Mob or not OriginPosition then
		return math.huge
	end

	local MobPart = FindValidPart(Mob)

	if not MobPart or not MobPart.Parent then
		return math.huge
	end

	return (
		MobPart.Position - OriginPosition
	).Magnitude
end

--==================================================
-- CLOSEST LIVING MOB / BOSS
--==================================================
local function FindNextLivingMob()
	local Mobs = GetMobList()
	local Root = GetRoot()

	if #Mobs == 0 or not Root then
		TargetState.Current = nil
		TargetState.CurrentIndex = 0
		TargetState.Waiting = true
		return nil
	end

	local ClosestMob = nil
	local ClosestIndex = 0
	local ClosestDistance = math.huge
	local OriginPosition = Root.Position

	for Index, Mob in ipairs(Mobs) do
		if IsMobValid(Mob) then
			local Distance =
				GetDistanceToMob(
					Mob,
					OriginPosition
				)

			if Distance < ClosestDistance then
				ClosestMob = Mob
				ClosestIndex = Index
				ClosestDistance = Distance
			end
		end
	end

	if not ClosestMob then
		TargetState.Current = nil
		TargetState.CurrentIndex = 0
		TargetState.Waiting = true
		return nil
	end

	local TargetChanged =
		TargetState.Current ~= ClosestMob

	TargetState.Current = ClosestMob
	TargetState.CurrentIndex = ClosestIndex
	TargetState.Waiting = false
	TargetState.WaitingCFrame = nil

	Root.Anchored = false
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero

	return ClosestMob
end

local function RefreshCurrentMob()
	-- A workspace, health, or transparency event may reveal a closer
	-- selected enemy. Rebuild once and immediately choose the closest.
	if TargetState.ScanDirty then
		return FindNextLivingMob()
	end

	if IsMobValid(TargetState.Current) then
		return TargetState.Current
	end

	-- While no relevant workspace event occurs, stay at the saved
	-- waiting height without repeatedly scanning.
	if TargetState.Waiting then
		return nil
	end

	return FindNextLivingMob()
end

