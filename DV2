function PotionSystem:BuySelected()
	if self.PurchaseBusy then
		pcall(function()
			Window:Warning(
				"Potions",
				"A potion purchase queue is already running.",
				2
			)
		end)
		return
	end

	local PurchaseQueue =
		self:CopySelection(
			self.Selected
		)

	if #PurchaseQueue == 0 then
		pcall(function()
			Window:Warning(
				"Potions",
				"Select at least one potion first.",
				4
			)
		end)
		return
	end

	local Remote =
		self:GetRemote()

	if not Remote then
		pcall(function()
			Window:Warning(
				"Potions",
				"Potion purchasing is not available right now.",
				4
			)
		end)
		return
	end

	local TotalCost, _, Amount =
		self:CalculateTotal()

	local QueueSize =
		#PurchaseQueue

	local RequestSpacing

	if QueueSize >= 6 then
		RequestSpacing = 0.65
	elseif QueueSize >= 3 then
		RequestSpacing = 0.45
	else
		RequestSpacing = 0.18
	end

	if Amount >= 500 then
		RequestSpacing += 0.15
	elseif Amount >= 100 then
		RequestSpacing += 0.08
	end

	self.PurchaseBusy = true

	pcall(function()
		Window:Info(
			"Potions",
			"Queued "
				.. tostring(
					QueueSize
				)
				.. " potion type"
				.. (
					QueueSize == 1
						and ""
						or "s"
				)
				.. " with "
				.. string.format(
					"%.2f",
					RequestSpacing
				)
				.. "s spacing.",
			3
		)
	end)

	task.spawn(function()
		local SuccessfulPurchases = 0
		local FailedPurchases = 0
		local Cancelled = false

		for Index, DisplayName in ipairs(
			PurchaseQueue
		) do
			if ScriptToken
				~= Environment
					.__CrimmyAutoEnemyController then
				Cancelled = true
				break
			end

			if not Remote.Parent then
				FailedPurchases +=
					QueueSize - Index + 1
				break
			end

			RunService.Heartbeat:Wait()

			local Definition =
				self.Definitions[
					DisplayName
				]

			if Definition then
				local Success, PurchaseError =
					pcall(function()
						Remote:FireServer(
							Definition
								.RemoteName,
							Amount
						)
					end)

				if Success then
					SuccessfulPurchases +=
						1
				else
					FailedPurchases += 1

					warn(
						"[CrimmyScriptz] Potion purchase failed for "
							.. tostring(
								Definition
									.RemoteName
							)
							.. ": "
							.. tostring(
								PurchaseError
							)
					)
				end
			else
				FailedPurchases += 1
			end

			if Index < QueueSize then
				task.wait(
					RequestSpacing
				)
			end
		end

		task.wait(0.3)
		self.PurchaseBusy = false

		if Cancelled then
			return
		end

		if SuccessfulPurchases > 0 then
			pcall(function()
				Window:Success(
					"Potions",
					"Requested "
						.. self:FormatNumber(
							Amount
						)
						.. " each for "
						.. tostring(
							SuccessfulPurchases
						)
						.. " potion"
						.. (
							SuccessfulPurchases
								== 1
								and ""
								or "s"
						)
						.. ". Total cost: "
						.. self:FormatNumber(
							TotalCost
						)
						.. ".",
					5
				)
			end)
		end

		if FailedPurchases > 0 then
			pcall(function()
				Window:Warning(
					"Potions",
					tostring(
						FailedPurchases
					)
						.. " potion request"
						.. (
							FailedPurchases
								== 1
								and ""
								or "s"
						)
						.. " failed.",
					4
				)
			end)
		end
	end)
end

