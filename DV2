local function ResetCharacterAndReturn()
	if FarmState.ResettingAfterDisable then
		return
	end

	local Character = GetCharacter()
	local Root = GetRoot()
	local Humanoid = GetHumanoid()

	if not Character or not Root or not Humanoid then
		return
	end

	FarmState.ResettingAfterDisable = true
	FarmState.ReturnCFrameAfterReset = Root.CFrame

	-- Reset the current character.
	pcall(function()
		Humanoid.Health = 0
	end)

	-- Fallback for games that block direct Health changes.
	task.delay(0.15, function()
		if Character.Parent
			and Humanoid.Parent
			and Humanoid.Health > 0 then
			pcall(function()
				Character:BreakJoints()
			end)
		end
	end)
end

local function ResetFarmTargetState()
	RefreshEnemyEventLookup()

	TargetState.Current = nil
	TargetState.CurrentIndex = 0
	ClearTargetRuntimeCache()
	FarmState.CurrentMultiChoice = nil
	TargetState.IsChronyxShard = false
	FollowMovement.LastTarget = nil
	FollowMovement.LastCharacter = nil
	FollowMovement.InitialTeleportPending = true
	FollowMovement.RemainingForcedPivots =
		FollowMovement.ForcedPivotFrames
	TargetState.LastHeldCFrame = nil
	TargetState.Waiting = false
	TargetState.WaitingCFrame = nil
	table.clear(TargetState.MobCacheByChoice)
	TargetState.MobCacheModeKey = ""
	TargetState.LastMobCacheRefresh = 0
	TargetState.ScanDirty = true
	TargetState.LastDirectScan = 0
	TargetState.LastResolve = 0
	FarmState.MultiCycleIndex = 1
end

local function StopFarmModesWithoutReset()
	Enabled = false
	FarmState.MultiFarmEnabled = false
	FarmState.KillAllEnabled = false

	ResetFarmTargetState()

	FarmState.LastJumpPulse = 0
	FarmState.LastAutoClick = 0
	PerformanceState.LastMovement = 0
	PerformanceState.LastNoclip = 0
	PerformanceState.LastHumanoidState = 0
	WeaponState.LastScan = 0
	WeaponState.InventoryDirtyAt = 0
	WeaponState.CurrentTool = nil
	WeaponState.CurrentDamage = -math.huge
	WeaponState.InventoryDirty = true

	DisconnectWeaponInventoryWatchers()
	StopMobScanning()
	RestoreCollisions()
	ReleaseHumanoidState()
end

local function PrepareFarmRuntime()
	ResetFarmTargetState()
	BindEnemyFolderWatchers()
	BindWeaponInventoryWatchers()

	local Root = GetRoot()
	TargetState.LastHeldCFrame =
		Root and Root.CFrame or nil

	FarmState.LastJumpPulse = 0
	FarmState.LastAutoClick = 0
	PerformanceState.LastMovement = 0
	PerformanceState.LastNoclip = 0
	PerformanceState.LastHumanoidState = 0
	WeaponState.LastScan = 0
	WeaponState.InventoryDirtyAt = 0
	WeaponState.CurrentTool = nil
	WeaponState.CurrentDamage = -math.huge

	ForceNoclip()
	PulseJump()
	EquipStrongestWeapon(true)
	ApplyHumanoidState(GetHumanoid())
end

local function Disable()
	if FarmState.ResettingAfterDisable then
		return false
	end

	StopFarmModesWithoutReset()

	if FarmState.DisableResetOnToggleOff then
		return false
	end

	ResetCharacterAndReturn()
	return true
end

local function GetInstancePath(
	Object
)
	if not Object or not Object.Parent then
		return "None"
	end

	local Success, FullName =
		pcall(function()
			return Object:GetFullName()
		end)

	if not Success then
		return tostring(Object.Name)
	end

	FullName = tostring(FullName)

	if FullName:sub(1, 10)
		== "Workspace." then
		FullName =
			"workspace."
			.. FullName:sub(11)
	elseif FullName == "Workspace" then
		FullName = "workspace"
	end

	return FullName
end

local function GetRuntimePhase(
	ShardsRemaining
)
	if not IsAnyFarmEnabled() then
		return "Idle"
	end

	if FlyState.Enabled then
		return "Fly"
	end

	if not IsMultiModeEnabled()
		and FarmState.SelectedMobChoice
			== "Chronyx - Super Boss" then
		if TargetState.IsChronyxShard
			or ShardsRemaining > 0 then
			return "Clearing Shards"
		end

		return "Super Boss"
	end

	if FarmState.KillAllEnabled then
		return "Kill All"
	end

	if FarmState.MultiFarmEnabled then
		return "Multi Farm"
	end

	return "Farming"
end

local function RecoverStuckTarget(
	Now
)
	DiagnosticsState.LastRecovery = Now
	DiagnosticsState.RecoveryStatusUntil =
		Now + 2
	DiagnosticsState.RecoveryCount += 1

	FollowMovement.LastTarget = nil
	FollowMovement.LastCharacter = nil
	FollowMovement.InitialTeleportPending =
		true

	TargetState.ScanDirty = true
	TargetState.LastDirectScan = 0

	FarmState.LastJumpPulse = 0
	FarmState.LastAutoClick = 0

	WeaponState.LastScan = 0
	WeaponState.InventoryDirty = true

	if TargetState.IsChronyxShard
		and not IsChronyxShardValid(
			TargetState.Current
		) then
		TargetState.Current = nil
		TargetState.CurrentIndex = 0
		TargetState.IsChronyxShard = false
	end

	EquipStrongestWeapon(true)
	TargetState.EngagementCanClick = false
	TargetState.EngagementForceTeleport = true
	TargetState.EngagementStatus =
		"Recovery safety teleport"

	DiagnosticsState.LastHealthChange = Now
end

