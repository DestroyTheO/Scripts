local function ResetLagProfiler()
	table.clear(
		ProfilerState.Records
	)
	table.clear(
		ProfilerState.Stack
	)

	for _, Name in ipairs(
		ProfilerState.Order
	) do
		ProfilerState.Records[Name] = {
			WindowTotalMs = 0,
			WindowCalls = 0,
			WindowMaxMs = 0,
			WindowSlowCalls = 0,

			LastLoadMs = 0,
			LastAverageMs = 0,
			LastMaxMs = 0,
			LastCalls = 0,
			LastSlowCalls = 0,

			PeakMs = 0,
			TotalCalls = 0,
		}
	end

	ProfilerState.PivotCalls = 0
	ProfilerState.PivotSkips = 0
	TargetState.ResolveCalls = 0
	TargetState.ResolveSkips = 0
	ProfilerState.FrameSamples = 0
	ProfilerState.SlowFrames = 0
	ProfilerState.LastFrameMs = 0
	ProfilerState.MaxFrameMs = 0
	ProfilerState.TopSource = "None"
	ProfilerState.TopSeverity =
		ProfilerState.Enabled
			and "Collecting"
			or "Disabled"
	ProfilerState.LastUIUpdate = 0
	ProfilerState.LastTopText = ""
	ProfilerState.LastBreakdownText = ""
	ProfilerState.LastCountersText = ""
end

local function RecordLagProfile(
	Name,
	ElapsedMs
)
	if not ProfilerState.Enabled
		or type(ElapsedMs) ~= "number" then
		return
	end

	local Record =
		ProfilerState.Records[Name]

	if not Record then
		return
	end

	ElapsedMs =
		math.max(
			0,
			ElapsedMs
		)

	Record.WindowTotalMs +=
		ElapsedMs
	Record.WindowCalls += 1
	Record.TotalCalls += 1

	if ElapsedMs
		> Record.WindowMaxMs then
		Record.WindowMaxMs =
			ElapsedMs
	end

	if ElapsedMs > Record.PeakMs then
		Record.PeakMs = ElapsedMs
	end

	if ElapsedMs
		>= ProfilerState.SlowThresholdMs then
		Record.WindowSlowCalls += 1
	end
end

local function ProfileFunction(
	Name,
	Function
)
	return function(...)
		if not ProfilerState.Enabled then
			return Function(...)
		end

		local Frame = {
			StartedAt = os.clock(),
			ChildMs = 0,
		}

		table.insert(
			ProfilerState.Stack,
			Frame
		)

		local Results =
			table.pack(
				pcall(
					Function,
					...
				)
			)

		local ElapsedMs =
			math.max(
				0,
				(
					os.clock()
					- Frame.StartedAt
				) * 1000
			)

		table.remove(
			ProfilerState.Stack
		)

		local ParentFrame =
			ProfilerState.Stack[
				#ProfilerState.Stack
			]

		if ParentFrame then
			ParentFrame.ChildMs +=
				ElapsedMs
		end

		-- Report exclusive time. Nested mob/shard scans are no longer
		-- charged a second time to Target Resolve.
		RecordLagProfile(
			Name,
			math.max(
				0,
				ElapsedMs
					- Frame.ChildMs
			)
		)

		if Results[1] ~= true then
			error(
				Results[2],
				0
			)
		end

		return table.unpack(
			Results,
			2,
			Results.n
		)
	end
end

