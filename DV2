local function ApplyHumanoidState(Humanoid)
	if not Humanoid or Humanoid.Health <= 0 then
		return
	end

	if CharacterControl.HumanoidState == "None" then
		return
	end

	local State =
		Enum.HumanoidStateType[
			CharacterControl.HumanoidState
		]

	if State then
		Humanoid:ChangeState(State)
	end
end

local function GetDexTeleportPart(TargetObject)
	if not TargetObject then
		return nil
	end

	if TargetObject:IsA("BasePart") then
		return TargetObject
	end

	if TargetObject:IsA("Model") then
		local PrimaryPart = TargetObject.PrimaryPart

		if PrimaryPart
			and PrimaryPart:IsA("BasePart") then
			return PrimaryPart
		end
	end

	return TargetObject:FindFirstChildWhichIsA(
		"BasePart",
		true
	)
end

local function GetTargetWorldPivotCFrame(
	TargetObject
)
	if not TargetObject then
		return nil
	end

	-- Exact behavior requested:
	-- workspace.Enemies.<MobName>.WorldPivot
	if TargetObject:IsA("Model") then
		local Success, WorldPivot =
			pcall(function()
				return TargetObject.WorldPivot
			end)

		if Success and WorldPivot then
			return WorldPivot
				+ Vector3.new(
					0,
					SelectedHeightAboveEnemy,
					0
				)
		end
	end

	-- BasePart fallback for unusual enemies.
	if TargetObject:IsA("BasePart") then
		return TargetObject.CFrame
			+ Vector3.new(
				0,
				SelectedHeightAboveEnemy,
				0
			)
	end

	local Part =
		TargetObject:FindFirstChildWhichIsA(
			"BasePart",
			true
		)

	if Part then
		return Part.CFrame
			+ Vector3.new(
				0,
				SelectedHeightAboveEnemy,
				0
			)
	end

	return nil
end

local function MoveCharacterLikeFly(
	Root,
	Humanoid,
	TargetObject,
	UnusedFallbackPosition
)
	if not Root
		or not Humanoid
		or Humanoid.Health <= 0 then
		return
	end

	local Character =
		LocalPlayer.Character
		or LocalPlayer.CharacterAdded:Wait()

	if not Character then
		return
	end

	local TargetCFrame =
		GetTargetWorldPivotCFrame(
			TargetObject
		)

	if not TargetCFrame then
		return
	end

	-- Exact normal teleport pattern:
	-- character:PivotTo(CFrame.new(...))
	Root.Anchored = false
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero
	Root.Velocity = Vector3.zero
	Root.RotVelocity = Vector3.zero

	Character:PivotTo(TargetCFrame)
end

local function HoldWaitingHeight(
	Root,
	Humanoid
)
	if not Root
		or not Humanoid
		or Humanoid.Health <= 0 then
		return
	end

	WaitingForEnemy = true

	-- Capture the exact place and height only once when the selected
	-- enemies run out. Keep using that same CFrame while waiting.
	if not WaitingCFrame then
		WaitingCFrame =
			LastHeldCFrame
			or Root.CFrame
	end

	-- Anchoring makes the saved height immune to gravity, physics,
	-- knockback, and frame-order differences while no target exists.
	Root.Anchored = true
	Root.CFrame = WaitingCFrame
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero
	Root.Velocity = Vector3.zero
	Root.RotVelocity = Vector3.zero
end

local function ReleaseHumanoidState()
	local Humanoid = GetHumanoid()
	local Root = GetRoot()

	if Root then
		Root.Anchored = false
	end

	if not Humanoid then
		return
	end

	Humanoid.Sit = false
	Humanoid.PlatformStand = false
	Humanoid.AutoRotate = true

	for _, State in ipairs({
		Enum.HumanoidStateType.Seated,
		Enum.HumanoidStateType.Jumping,
		Enum.HumanoidStateType.GettingUp,
		Enum.HumanoidStateType.Running,
		Enum.HumanoidStateType.RunningNoPhysics,
		Enum.HumanoidStateType.Freefall,
		Enum.HumanoidStateType.Landed,
	}) do
		pcall(function()
			Humanoid:SetStateEnabled(State, true)
		end)
	end

	pcall(function()
		Humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end)

	task.defer(function()
		RunService.Heartbeat:Wait()

		if Enabled
			or FlyState.Enabled
			or not Humanoid.Parent
			or Humanoid.Health <= 0 then
			return
		end

		Humanoid.Sit = false
		Humanoid.PlatformStand = false

		pcall(function()
			Humanoid:ChangeState(
				Enum.HumanoidStateType.Running
			)
		end)
	end)
end

local function ResetFlyInput()
	FlyInput.W = 0
	FlyInput.S = 0
	FlyInput.A = 0
	FlyInput.D = 0
	FlyInput.Up = 0
	FlyInput.Down = 0
end

local function SetFlyEnabled(State)
	local RequestedState = State == true

	-- Fly cannot be enabled while the main enemy controller is active.
	if RequestedState and Enabled then
		FlyState.Enabled = false
		FlyState.YLevel = nil
		FlyState.LastTP = 0
		ResetFlyInput()
		return false, "MainEnabled"
	end

	FlyState.Enabled = RequestedState
	FlyState.YLevel = nil
	FlyState.LastTP = 0
	ResetFlyInput()

	if FlyState.Enabled then
		local Root = GetRoot()

		if Root then
			Root.Anchored = false
			FlyState.YLevel = Root.Position.Y
		end
	else
		local Root = GetRoot()

		if Root then
			Root.AssemblyLinearVelocity = Vector3.new(
				Root.AssemblyLinearVelocity.X,
				0,
				Root.AssemblyLinearVelocity.Z
			)
			Root.AssemblyAngularVelocity = Vector3.zero
		end

		if not Enabled then
			ReleaseHumanoidState()
		end
	end

	return true
end

local function HandleFlyKey(Input, IsDown)
	if Input.KeyCode == Enum.KeyCode.W then
		FlyInput.W = IsDown and -1 or 0
	elseif Input.KeyCode == Enum.KeyCode.S then
		FlyInput.S = IsDown and 1 or 0
	elseif Input.KeyCode == Enum.KeyCode.A then
		FlyInput.A = IsDown and -1 or 0
	elseif Input.KeyCode == Enum.KeyCode.D then
		FlyInput.D = IsDown and 1 or 0
	elseif Input.KeyCode == Enum.KeyCode.Space then
		FlyInput.Up = IsDown and 1 or 0
	elseif Input.KeyCode == Enum.KeyCode.LeftControl then
		FlyInput.Down = IsDown and -1 or 0
	end
end

UserInputService.InputBegan:Connect(function(Input, GameProcessed)
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	if GameProcessed
		or UserInputService:GetFocusedTextBox() then
		return
	end

	if Input.KeyCode == Enum.KeyCode.X then
		local RequestedState =
			not FlyState.Enabled

		local Changed, Reason =
			SetFlyEnabled(RequestedState)

		pcall(function()
			if not Changed
				and Reason == "MainEnabled" then
				Window:Warning(
					"Player Fly",
					"Disable the main enemy controller before enabling Fly.",
					3
				)
			elseif FlyState.Enabled then
				Window:Success(
					"Player Fly",
					"Fly enabled with X.",
					3
				)
			else
				Window:Info(
					"Player Fly",
					"Fly disabled with X.",
					3
				)
			end
		end)

		return
	end

	HandleFlyKey(Input, true)
end)

UserInputService.InputEnded:Connect(function(Input)
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	HandleFlyKey(Input, false)
end)

local FlyRayParams = RaycastParams.new()
FlyRayParams.RespectCanCollide = true
FlyRayParams.FilterType = Enum.RaycastFilterType.Exclude
FlyRayParams.IgnoreWater = true

local function ResetCharacterAndReturn()
	if ResettingAfterDisable then
		return
	end

	local Character = GetCharacter()
	local Root = GetRoot()
	local Humanoid = GetHumanoid()

	if not Character or not Root or not Humanoid then
		return
	end

	ResettingAfterDisable = true
	ReturnCFrameAfterReset = Root.CFrame

	-- Reset the current character.
	pcall(function()
		Humanoid.Health = 0
	end)

	-- Fallback for games that block direct Health changes.
	task.delay(0.15, function()
		if Character.Parent
			and Humanoid.Parent
			and Humanoid.Health > 0 then
			pcall(function()
				Character:BreakJoints()
			end)
		end
	end)
end

local function Disable()
	if ResettingAfterDisable then
		return false
	end

	Enabled = false
	CurrentMob = nil
	CurrentMobIndex = 0
	LastHeldCFrame = nil
	WaitingForEnemy = false
	WaitingCFrame = nil
	LastJumpPulse = 0
	LastAutoClick = 0
	LastWeaponScan = 0
	CurrentBestWeapon = nil
	CurrentBestWeaponDamage = -math.huge

	StopMobScanning()
	RestoreCollisions()
	ReleaseHumanoidState()

	if DisableResetOnToggleOff then
		return false
	end

	ResetCharacterAndReturn()
	return true
end

--==================================================
-- MOVEMENT LOOP
--==================================================
RunService.PreSimulation:Connect(function()
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		if not SupersededCleanupDone then
			SupersededCleanupDone = true
			StopMobScanning()
			RestoreCollisions()
			ReleaseHumanoidState()
		end

		return
	end

	if not Enabled then
		return
	end

	-- Fly owns character movement while enabled. Auto-clicking and
	-- weapon handling continue in the Heartbeat loop.
	if FlyState.Enabled then
		return
	end

	ForceNoclip()

	local Humanoid = GetHumanoid()
	local Root = GetRoot()

	if not Humanoid
		or Humanoid.Health <= 0
		or not Root then
		return
	end

	ApplyHumanoidState(Humanoid)

	local Mob = FindSelectedEnemyDirect()

	if not Mob or not Mob.Parent then
		HoldWaitingHeight(
			Root,
			Humanoid
		)
		return
	end

	local Character =
		LocalPlayer.Character
		or LocalPlayer.CharacterAdded:Wait()

	if not Character then
		return
	end

	local Success, WorldPivot =
		pcall(function()
			return Mob.WorldPivot
		end)

	if not Success or not WorldPivot then
		if Mob:IsA("BasePart") then
			WorldPivot = Mob.CFrame
		else
			local Part =
				Mob:FindFirstChildWhichIsA(
					"BasePart",
					true
				)

			if Part then
				WorldPivot = Part.CFrame
			end
		end
	end

	if not WorldPivot then
		HoldWaitingHeight(
			Root,
			Humanoid
		)
		return
	end

	WaitingForEnemy = false
	WaitingCFrame = nil
	Root.Anchored = false
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero

	local TargetCFrame =
		WorldPivot
		+ Vector3.new(
			0,
			SelectedHeightAboveEnemy,
			0
		)

	Character:PivotTo(TargetCFrame)
	LastHeldCFrame = TargetCFrame
end)

--==================================================
-- PLAYER FLY LOOP
--==================================================
RunService.PreSimulation:Connect(function(DeltaTime)
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	if not FlyState.Enabled or not IsPlayerAlive() then
		FlyState.YLevel = nil
		return
	end

	local Root = GetRoot()
	local Humanoid = GetHumanoid()
	local Camera = Workspace.CurrentCamera

	if not Root or not Humanoid then
		return
	end

	if FlyState.HumanoidState ~= "None" then
		local State =
			Enum.HumanoidStateType[
				FlyState.HumanoidState
			]

		if State then
			Humanoid:ChangeState(State)
		end
	end

	local MoveDirection

	if FlyState.MoveMode == "Direct" then
		MoveDirection = CalculateFlyMoveVector(
			Vector3.new(
				FlyInput.A + FlyInput.D,
				0,
				FlyInput.W + FlyInput.S
			)
		)
	else
		MoveDirection = Humanoid.MoveDirection
	end

	if FlyState.Mode == "Velocity" then
		Root.AssemblyLinearVelocity =
			(MoveDirection * FlyState.Speed)
			+ Vector3.new(
				0,
				Root.AssemblyLinearVelocity.Y,
				0
			)

	elseif FlyState.Mode == "Impulse" then
		local Desired = MoveDirection * FlyState.Speed

		local Difference =
			(Desired - Root.AssemblyLinearVelocity)
			* Vector3.new(1, 0, 1)

		if Difference.Magnitude > 2 then
			Root:ApplyImpulse(
				Difference * Root.AssemblyMass
			)
		end

	elseif FlyState.Mode == "CFrame" then
		Root.CFrame +=
			MoveDirection
			* FlyState.Speed
			* DeltaTime

	elseif FlyState.Mode == "Pulse" then
		local PulseTime =
			tick()
			% (
				FlyState.PulseLength
				+ FlyState.PulseDelay
			)

		if PulseTime < FlyState.PulseLength then
			Root.AssemblyLinearVelocity =
				(MoveDirection * FlyState.Speed)
				+ Vector3.new(
					0,
					Root.AssemblyLinearVelocity.Y,
					0
				)
		end

	elseif FlyState.Mode == "TP" then
		if tick() - FlyState.LastTP
			>= FlyState.TPFrequency then
			FlyState.LastTP = tick()

			Root.CFrame +=
				MoveDirection
				* FlyState.Speed
				* 0.05
		end
	end

	if not FlyState.YLevel then
		FlyState.YLevel = Root.Position.Y
	end

	FlyState.YLevel +=
		(FlyInput.Up + FlyInput.Down)
		* FlyState.Vertical
		* DeltaTime

	if FlyState.WallCheck then
		local IgnoreList = {
			GetCharacter(),
		}

		if Camera then
			table.insert(IgnoreList, Camera)
		end

		FlyRayParams.FilterDescendantsInstances =
			IgnoreList

		local Ray = Workspace:Raycast(
			Root.Position,
			Vector3.new(
				0,
				FlyState.YLevel - Root.Position.Y,
				0
			),
			FlyRayParams
		)

		if Ray then
			FlyState.YLevel =
				Ray.Position.Y + Humanoid.HipHeight
		end
	end

	Root.Velocity *= Vector3.new(1, 0, 1)

	Root.CFrame += Vector3.new(
		0,
		FlyState.YLevel - Root.Position.Y,
		0
	)
end)

--==================================================
-- STATE / INPUT LOOP
--==================================================
RunService.Heartbeat:Connect(function()
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		if not SupersededCleanupDone then
			SupersededCleanupDone = true
			StopMobScanning()
			RestoreCollisions()
			ReleaseHumanoidState()
		end

		return
	end

	if Enabled then
		ForceNoclip()
		EquipStrongestWeapon()

		if not FlyState.Enabled then
			ApplyHumanoidState(GetHumanoid())
		end

		local Now = os.clock()

		if not FlyState.Enabled
			and Now - LastJumpPulse >= JumpPulseInterval then
			LastJumpPulse = Now
			PulseJump()
		end

		if Now - LastAutoClick >= AutoClickInterval then
			LastAutoClick = Now
			ClickScreenCenter()
		end

		if Now - LastWeaponScan >= WeaponScanInterval then
			LastWeaponScan = Now
			EquipStrongestWeapon()
		end


	else
		-- Do not send keyboard input or change Humanoid state here.
		-- Disable() already performed the one-time cleanup.
		return
	end
end)

