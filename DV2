-- CHARACTER GETTERS
--==================================================
local function GetCharacter()
	return LocalPlayer.Character
end

local function GetHumanoid()
	local Character = GetCharacter()

	return Character
		and Character:FindFirstChildWhichIsA("Humanoid")
end

local function GetRoot()
	local Character = GetCharacter()

	return Character
		and Character:FindFirstChild("HumanoidRootPart")
end

local function IsPlayerAlive()
	local Humanoid = GetHumanoid()

	return Humanoid and Humanoid.Health > 0
end

local function CalculateFlyMoveVector(Vector)
	local Camera = Workspace.CurrentCamera

	if not Camera then
		return Vector3.zero
	end

	local _, _, _, R00, R01, R02, _, _, R12, _, _, R22 =
		Camera.CFrame:GetComponents()

	local C
	local S

	if R12 < 1 and R12 > -1 then
		C = R22
		S = R02
	else
		C = R00
		S = -R01 * math.sign(R12)
	end

	Vector = Vector3.new(
		(C * Vector.X + S * Vector.Z),
		0,
		(C * Vector.Z - S * Vector.X)
	)

	local Magnitude = math.sqrt(C * C + S * S)

	Vector =
		Magnitude > 0
		and Vector / Magnitude
		or Vector3.zero

	return Vector.Magnitude > 0
		and Vector.Unit
		or Vector3.zero
end

--==================================================
-- STRONGEST BACKPACK WEAPON
--==================================================
local function GetHighestDamageValue(Damage)
	if type(Damage) == "number" then
		return Damage
	end

	if type(Damage) ~= "table" then
		return nil
	end

	local Highest = nil

	for _, Value in pairs(Damage) do
		if type(Value) == "number" then
			if Highest == nil or Value > Highest then
				Highest = Value
			end
		end
	end

	return Highest
end

local function ReadToolDamage(Tool)
	if not Tool or not Tool:IsA("Tool") then
		return nil
	end

	local Configuration =
		Tool:FindFirstChild("Configuration")

	if not Configuration
		or not Configuration:IsA("ModuleScript") then
		return nil
	end

	local Success, Config = pcall(require, Configuration)

	if not Success or type(Config) ~= "table" then
		return nil
	end

	return GetHighestDamageValue(Config.Damage)
end

local function FindStrongestWeapon()
	local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	local Character = GetCharacter()

	local BestTool = nil
	local BestDamage = -math.huge

	local function CheckContainer(Container)
		if not Container then
			return
		end

		for _, Object in ipairs(Container:GetChildren()) do
			if Object:IsA("Tool") then
				local Damage = ReadToolDamage(Object)

				if Damage
					and (
						Damage > BestDamage
						or (
							Damage == BestDamage
							and BestTool
							and Object.Name < BestTool.Name
						)
					) then
					BestTool = Object
					BestDamage = Damage
				end
			end
		end
	end

	-- Check both places because an equipped Tool moves from Backpack
	-- into the character.
	CheckContainer(Backpack)
	CheckContainer(Character)

	return BestTool, BestDamage
end

local function DisconnectWeaponInventoryWatchers()
	for _, Connection in ipairs(
		WeaponState.Connections
	) do
		pcall(function()
			Connection:Disconnect()
		end)
	end

	table.clear(
		WeaponState.Connections
	)
end

local function MarkWeaponInventoryDirty(
	Object
)
	if Object == nil
		or Object:IsA("Tool") then
		WeaponState.InventoryDirty = true
		WeaponState.InventoryDirtyAt =
			os.clock()
	end
end

local function BindWeaponInventoryWatchers()
	DisconnectWeaponInventoryWatchers()

	local function WatchContainer(Container)
		if not Container then
			return
		end

		table.insert(
			WeaponState.Connections,
			Container.ChildAdded:Connect(
				MarkWeaponInventoryDirty
			)
		)

		table.insert(
			WeaponState.Connections,
			Container.ChildRemoved:Connect(
				MarkWeaponInventoryDirty
			)
		)
	end

	WatchContainer(
		LocalPlayer:
			FindFirstChildOfClass(
				"Backpack"
			)
	)

	WatchContainer(
		GetCharacter()
	)

	WeaponState.InventoryDirty = true
	WeaponState.InventoryDirtyAt =
		os.clock()
end

local function EquipStrongestWeapon(
	ForceScan
)
	if not WeaponState.AutoEquipEnabled then
		return
	end

	local Humanoid = GetHumanoid()

	if not Humanoid
		or Humanoid.Health <= 0 then
		return
	end

	local CurrentWeaponIsValid =
		WeaponState.CurrentTool
		and WeaponState.CurrentTool.Parent
		and WeaponState.CurrentTool:IsA("Tool")

	if ForceScan == true
		or WeaponState.InventoryDirty
		or not CurrentWeaponIsValid then
		local BestTool, BestDamage =
			FindStrongestWeapon()

		WeaponState.CurrentTool = BestTool
		WeaponState.CurrentDamage =
			BestDamage or -math.huge
		WeaponState.InventoryDirty = false
	end

	if not WeaponState.CurrentTool
		or not WeaponState.CurrentTool.Parent then
		return
	end

	local Character = GetCharacter()

	if WeaponState.CurrentTool.Parent
		== Character then
		return
	end

	pcall(function()
		Humanoid:EquipTool(
			WeaponState.CurrentTool
		)
	end)
end

EquipStrongestWeapon =
	ProfileFunction(
		"Weapon Scan",
		EquipStrongestWeapon
	)

--==================================================
-- LIGHTWEIGHT REVERSIBLE NOCLIP
--==================================================
function CharacterControl:DisconnectNoclipWatchers()
	for Index = #self.NoclipConnections, 1, -1 do
		local Connection =
			self.NoclipConnections[Index]

		if Connection then
			pcall(function()
				Connection:Disconnect()
			end)
		end

		self.NoclipConnections[Index] = nil
	end

	self.NoclipCharacter = nil
end

function CharacterControl:ApplyNoclipPart(
	Part
)
	if not Part
		or not Part:IsA("BasePart")
		or not Part.Parent then
		return false
	end

	if CollisionStates[Part] == nil then
		CollisionStates[Part] =
			Part.CanCollide
		self.NoclipTrackedCount += 1
		self.NoclipAdds += 1
	end

	if Part.CanCollide then
		Part.CanCollide = false
	end

	return true
end

function CharacterControl:RemoveNoclipPart(
	Part,
	Restore
)
	local OriginalState =
		CollisionStates[Part]

	if OriginalState == nil then
		return
	end

	if Restore
		and typeof(Part) == "Instance"
		and Part:IsA("BasePart")
		and Part.Parent then
		pcall(function()
			Part.CanCollide =
				OriginalState == true
		end)
	end

	CollisionStates[Part] = nil
	self.NoclipTrackedCount =
		math.max(
			0,
			self.NoclipTrackedCount - 1
		)
	self.NoclipRemovals += 1
end

function CharacterControl:BindNoclip(
	Character
)
	if not Character then
		return false
	end

	if self.NoclipCharacter == Character
		and #self.NoclipConnections > 0 then
		-- Five-second fallback: verify only already tracked parts. This
		-- avoids rebuilding Character:GetDescendants() repeatedly.
		for Part in pairs(
			CollisionStates
		) do
			if typeof(Part) == "Instance"
				and Part:IsA("BasePart")
				and Part.Parent
				and Part:IsDescendantOf(
					Character
				)
				and Part.CanCollide then
				Part.CanCollide = false
			end
		end

		return true
	end

	self:DisconnectNoclipWatchers()
	self.NoclipCharacter = Character

	for _, Object in ipairs(
		Character:GetDescendants()
	) do
		if Object:IsA("BasePart") then
			self:ApplyNoclipPart(Object)
		end
	end

	local AddedConnection =
		Character.DescendantAdded:
			Connect(function(Object)
				if Object:IsA("BasePart") then
					self:ApplyNoclipPart(Object)
				end
			end)

	local RemovingConnection =
		Character.DescendantRemoving:
			Connect(function(Object)
				if Object:IsA("BasePart") then
					self:RemoveNoclipPart(
						Object,
						true
					)
				end
			end)

	table.insert(
		self.NoclipConnections,
		TrackRuntimeConnection(
			AddedConnection
		)
	)

	table.insert(
		self.NoclipConnections,
		TrackRuntimeConnection(
			RemovingConnection
		)
	)

	return true
end

local function ForceNoclip()
	local Character = GetCharacter()

	if not Character then
		return
	end

	CharacterControl:BindNoclip(
		Character
	)
end

ForceNoclip =
	ProfileFunction(
		"Noclip",
		ForceNoclip
	)

local function RestoreCollisions()
	CharacterControl:
		DisconnectNoclipWatchers()

	for Part, OriginalState in pairs(
		CollisionStates
	) do
		if typeof(Part) == "Instance"
			and Part:IsA("BasePart")
			and Part.Parent then
			pcall(function()
				Part.CanCollide =
					OriginalState == true
			end)
		end

		CollisionStates[Part] = nil
	end

	CharacterControl.NoclipTrackedCount = 0
end

Environment.__CrimmyRestoreEnemyNoclip =
	RestoreCollisions

--==================================================
-- ENABLED-ONLY JUMP PULSE
-- No synthetic keyboard input is used.
--==================================================
local function PulseJump()
	if not IsAnyFarmEnabled() then
		return
	end

	local Humanoid = GetHumanoid()

	if not Humanoid
		or Humanoid.Health <= 0 then
		return
	end

	local State =
		Humanoid:GetState()

	-- Do not continuously churn the jump state while already airborne.
	if State == Enum.HumanoidStateType.Freefall
		or State == Enum.HumanoidStateType.FallingDown
		or State == Enum.HumanoidStateType.Physics then
		return
	end

	Humanoid.Jump = true
end

--==================================================
-- CENTER-SCREEN AUTO CLICK
--==================================================
local function ClickScreenCenter()
	local Camera = Workspace.CurrentCamera

	if not Camera then
		return
	end

	local ViewportSize = Camera.ViewportSize
	local CenterX = math.floor(ViewportSize.X / 2)
	local CenterY = math.floor(ViewportSize.Y / 2)

	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(
			CenterX,
			CenterY,
			0,
			true,
			game,
			0
		)

		task.wait(0.02)

		VirtualInputManager:SendMouseButtonEvent(
			CenterX,
			CenterY,
			0,
			false,
			game,
			0
		)
	end)
end

