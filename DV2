TrackRuntimeConnection(
	RunService.Heartbeat:Connect(function(DeltaTime)
	if ProfilerState.Enabled then
		local FrameMs =
			math.max(
				0,
				(tonumber(DeltaTime) or 0)
					* 1000
			)

		ProfilerState.FrameSamples += 1
		ProfilerState.LastFrameMs =
			FrameMs

		if FrameMs
			> ProfilerState.MaxFrameMs then
			ProfilerState.MaxFrameMs =
				FrameMs
		end

		if FrameMs >= 40 then
			ProfilerState.SlowFrames += 1
		end
	end

	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		if not TargetState.SupersededCleanupDone then
			TargetState.SupersededCleanupDone = true
			DisconnectWeaponInventoryWatchers()
			StopMobScanning()
			RestoreCollisions()
			ReleaseHumanoidState()
			DisconnectRuntimeConnections()
		end

		return
	end

	local Now = os.clock()

	if Now - RuntimeState.LastMaintenance
		>= RuntimeState.MaintenanceInterval then
		RuntimeState.LastMaintenance = Now
		MaintainRuntimeCaches(false)
	end

	UpdateRuntimeDiagnostics(Now, false)

	if IsAnyFarmEnabled() then
		if not FlyState.Enabled
			and Now - FarmState.LastJumpPulse >= JumpPulseInterval then
			FarmState.LastJumpPulse = Now
			PulseJump()
		end

		if TargetState.EngagementCanClick
			and Now - FarmState.LastAutoClick
				>= AutoClickInterval then
			FarmState.LastAutoClick = Now
			ClickScreenCenter()
		end

		if WeaponState.AutoEquipEnabled then
			local EventScanDue =
				WeaponState.InventoryDirty
				and Now
					- WeaponState
						.InventoryDirtyAt
					>= WeaponState
						.EventScanDelay

			local FallbackScanDue =
				Now - WeaponState.LastScan
					>= WeaponScanInterval

			if EventScanDue
				or FallbackScanDue then
				WeaponState.LastScan = Now

				if FallbackScanDue then
					WeaponState.FallbackScans +=
						1
				else
					WeaponState.EventScans +=
						1
				end

				-- Event scans only rescan when inventory actually
				-- changed. The five-second fallback forces a safety
				-- rescan in case the game changed an item silently.
				EquipStrongestWeapon(
					FallbackScanDue
				)
			end
		end

	else
		-- Do not send keyboard input or change Humanoid state here.
		-- Disable() already performed the one-time cleanup.
		return
	end
end)
)

