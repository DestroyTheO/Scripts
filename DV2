function SecretWatch:NormalizeRarity(Value)
	if Value == nil then
		return nil
	end

	local Text =
		string.upper(
			tostring(Value)
		)

	Text =
		Text:gsub(
			"^%s+",
			""
		):gsub(
			"%s+$",
			""
		)

	return Text
end

function SecretWatch:ReadRarityFromTable(
	Data
)
	if type(Data) ~= "table" then
		return nil
	end

	local DirectCandidates = {
		Data.Rarity,
		Data.rarity,
		Data.ItemRarity,
		Data.itemRarity,
		Data.Quality,
		Data.quality,
		Data.Tier,
		Data.tier,
	}

	for _, Value in ipairs(
		DirectCandidates
	) do
		if Value ~= nil then
			return self:NormalizeRarity(
				Value
			)
		end
	end

	for _, NestedName in ipairs({
		"Item",
		"Stats",
		"Metadata",
		"Data",
	}) do
		local Rarity =
			self:ReadRarityFromTable(
				Data[NestedName]
			)

		if Rarity then
			return Rarity
		end
	end

	return nil
end

function SecretWatch:ReadItemRarity(
	Item
)
	if not Item or not Item.Parent then
		return nil
	end

	for _, AttributeName in ipairs({
		"Rarity",
		"rarity",
		"ItemRarity",
		"itemRarity",
		"Quality",
		"quality",
		"Tier",
		"tier",
	}) do
		local Value =
			Item:GetAttribute(
				AttributeName
			)

		if Value ~= nil then
			return self:NormalizeRarity(
				Value
			)
		end
	end

	local NormalizedName =
		string.lower(
			tostring(Item.Name)
		):gsub(
			"[%s_%-]",
			""
		)

	if self.RarityNames[
		NormalizedName
	]
		and (
			Item:IsA("StringValue")
			or Item:IsA("IntValue")
			or Item:IsA("NumberValue")
		) then
		return self:NormalizeRarity(
			Item.Value
		)
	end

	for _, Child in ipairs(
		Item:GetChildren()
	) do
		local ChildName =
			string.lower(
				tostring(Child.Name)
			):gsub(
				"[%s_%-]",
				""
			)

		if self.RarityNames[
			ChildName
		]
			and (
				Child:IsA("StringValue")
				or Child:IsA("IntValue")
				or Child:IsA("NumberValue")
			) then
			return self:NormalizeRarity(
				Child.Value
			)
		end

		if (
			Child.Name == "Configuration"
			or Child.Name == "Config"
		)
			and Child:IsA(
				"ModuleScript"
			) then
			local Success, Data =
				pcall(
					require,
					Child
				)

			if Success then
				local Rarity =
					self:
						ReadRarityFromTable(
							Data
						)

				if Rarity then
					return Rarity
				end
			end
		end
	end

	if Item:IsA("ModuleScript")
		and (
			Item.Name == "Configuration"
			or Item.Name == "Config"
		) then
		local Success, Data =
			pcall(
				require,
				Item
			)

		if Success then
			return self:
				ReadRarityFromTable(
					Data
				)
		end
	end

	return nil
end

function SecretWatch:GetInventoryContainers()
	local Containers = {}
	local Added = {}

	local function AddContainer(
		Container
	)
		if Container
			and Container.Parent
			and not Added[Container] then
			Added[Container] = true
			table.insert(
				Containers,
				Container
			)
		end
	end

	AddContainer(
		LocalPlayer:
			FindFirstChildOfClass(
				"Backpack"
			)
	)

	AddContainer(
		GetCharacter()
	)

	local PlayerGui =
		LocalPlayer:
			FindFirstChildOfClass(
				"PlayerGui"
			)

	local PlayerScripts =
		LocalPlayer:
			FindFirstChild(
				"PlayerScripts"
			)

	for _, Object in ipairs(
		LocalPlayer:GetDescendants()
	) do
		local IsExcluded =
			(
				PlayerGui
				and Object:IsDescendantOf(
					PlayerGui
				)
			)
			or (
				PlayerScripts
				and Object:IsDescendantOf(
					PlayerScripts
				)
			)

		if IsExcluded then
			continue
		end

		local Name =
			string.lower(
				tostring(Object.Name)
			):gsub(
				"[%s_%-]",
				""
			)

		if self.ContainerNames[
			Name
		] then
			AddContainer(
				Object
			)
		end
	end

	return Containers
end

function SecretWatch:ResolveTrackedRoot(
	Object,
	Container
)
	if not Object
		or not Container then
		return nil
	end

	if Object:IsA("Tool") then
		return Object
	end

	local Current = Object
	local NearestModel = nil

	while Current
		and Current ~= Container do
		if Current:IsA("Tool") then
			return Current
		end

		if not NearestModel
			and Current:IsA("Model") then
			NearestModel = Current
		end

		for _, AttributeName in ipairs({
			"UUID",
			"UID",
			"UniqueId",
			"UniqueID",
			"ItemId",
			"ItemID",
			"Serial",
			"Guid",
		}) do
			local Value =
				Current:GetAttribute(
					AttributeName
				)

			if Value ~= nil
				and tostring(Value)
					~= "" then
				return Current
			end
		end

		local Config =
			Current:FindFirstChild(
				"Configuration"
			)
			or Current:FindFirstChild(
				"Config"
			)

		if Config
			and Config:IsA(
				"ModuleScript"
			) then
			return Current
		end

		Current = Current.Parent
	end

	if NearestModel then
		return NearestModel
	end

	Current = Object

	while Current
		and Current ~= Container do
		local Parent =
			Current.Parent

		if Parent == Container then
			return Current
		end

		if Parent then
			local ParentName =
				string.lower(
					tostring(
						Parent.Name
					)
				):gsub(
					"[%s_%-]",
					""
				)

			if ParentName ~= "stats"
				and ParentName ~= "metadata"
				and ParentName ~= "data"
				and ParentName ~= "configuration"
				and ParentName ~= "config" then
				return Parent
			end
		end

		Current = Parent
	end

	return Object
end

function SecretWatch:IsRelevantInventoryObject(
	Object
)
	if not Object then
		return false
	end

	local Character =
		GetCharacter()

	if Character
		and Object:IsDescendantOf(
			Character
		) then
		return Object:IsA("Tool")
			or Object:
				FindFirstAncestorWhichIsA(
					"Tool"
				) ~= nil
	end

	local Backpack =
		LocalPlayer:
			FindFirstChildOfClass(
				"Backpack"
			)

	if Backpack
		and (
			Object == Backpack
			or Object:IsDescendantOf(
				Backpack
			)
		) then
		return true
	end

	local PlayerGui =
		LocalPlayer:
			FindFirstChildOfClass(
				"PlayerGui"
			)

	if PlayerGui
		and Object:IsDescendantOf(
			PlayerGui
		) then
		return false
	end

	local PlayerScripts =
		LocalPlayer:
			FindFirstChild(
				"PlayerScripts"
			)

	if PlayerScripts
		and Object:IsDescendantOf(
			PlayerScripts
		) then
		return false
	end

	local Current = Object

	while Current
		and Current ~= LocalPlayer do
		local Name =
			string.lower(
				tostring(Current.Name)
			):gsub(
				"[%s_%-]",
				""
			)

		if self.ContainerNames[
			Name
		] then
			return true
		end

		Current = Current.Parent
	end

	return false
end

function SecretWatch:GetItemSignature(
	Item
)
	local UniqueValue = nil
	local Current = Item

	while Current
		and Current ~= LocalPlayer
		and Current ~= Workspace do
		for _, AttributeName in ipairs({
			"UUID",
			"UID",
			"UniqueId",
			"UniqueID",
			"ItemId",
			"ItemID",
			"Serial",
			"Guid",
		}) do
			local Value =
				Current:GetAttribute(
					AttributeName
				)

			if Value ~= nil
				and tostring(Value)
					~= "" then
				UniqueValue =
					tostring(Value)
				break
			end
		end

		if UniqueValue then
			break
		end

		Current = Current.Parent
	end

	return tostring(
		Item.ClassName
	)
		.. "|"
		.. tostring(Item.Name)
		.. (
			UniqueValue
				and (
					"|"
					.. UniqueValue
				)
				or ""
		)
end

function SecretWatch:BuildSnapshot()
	local Counts = {}
	local Names = {}
	local SeenRoots = {}
	local SeenObjects = {}
	local Total = 0
	local CandidateCount = 0
	local Character = GetCharacter()

	for _, Container in ipairs(
		self:GetInventoryContainers()
	) do
		local Objects =
			Container:GetDescendants()

		for _, Child in ipairs(
			Container:GetChildren()
		) do
			table.insert(
				Objects,
				Child
			)
		end

		for _, Object in ipairs(
			Objects
		) do
			if not SeenObjects[Object] then
				SeenObjects[Object] = true

				local Allowed =
					Container ~= Character
					or Object:IsA("Tool")
					or Object:
						FindFirstAncestorWhichIsA(
							"Tool"
						) ~= nil

				if Allowed then
					local Rarity =
						self:ReadItemRarity(
							Object
						)

					if Rarity then
						CandidateCount += 1
					end

					if Rarity == "SECRET" then
						local Root =
							self:
								ResolveTrackedRoot(
									Object,
									Container
								)
							or Object

						if not SeenRoots[Root] then
							SeenRoots[Root] =
								true

							local Signature =
								self:
									GetItemSignature(
										Root
									)

							Counts[Signature] =
								(Counts[Signature]
									or 0)
								+ 1

							Names[Signature] =
								Root.Name

							Total += 1
						end
					end
				end
			end
		end
	end

	self.CandidateCount =
		CandidateCount

	return Counts, Total, Names
end

function SecretWatch:UpdateStatusBar()
	local Text =
		"Target: "
		.. tostring(
			DiagnosticsState.ActualTarget
				or "None"
		)
		.. "  •  Phase: "
		.. tostring(
			DiagnosticsState.Phase
				or "Idle"
		)
		.. "  •  Status: "
		.. tostring(
			DiagnosticsState.Status
				or "Idle"
		)

	if DiagnosticsState.Phase
			== "Clearing Shards"
		or DiagnosticsState.ShardsRemaining
			> 0 then
		Text ..=
			"  •  Shards: "
			.. tostring(
				DiagnosticsState.ShardsRemaining
			)
	end

	Text ..=
		"  •  Secrets: "
		.. tostring(
			self.TotalCount
		)
		.. "  •  New: "
		.. tostring(
			self.NewCount
		)
		.. "  •  Secret Scan: "
		.. tostring(
			self.LastScanReason
		)
		.. "  •  Candidates: "
		.. tostring(
			self.CandidateCount
		)
		.. "  •  Signal Checks: "
		.. tostring(
			self.SignalChecks
		)
		.. "  •  Signal Source: "
		.. tostring(
			self.LastSignalSource
		)
		.. "  •  Signal: "
		.. tostring(
			self.LastSignalText
		)

	if Text
		== DiagnosticsState.LastWatermarkText then
		return
	end

	DiagnosticsState.LastWatermarkText =
		Text

	pcall(function()
		Window:SetWatermarkText(
			Text
		)
		Window:ShowTopRightBar()
	end)
end

function SecretWatch:EstablishBaseline(
	ResetNewCount
)
	local Counts, Total =
		self:BuildSnapshot()

	self.KnownMaximumCounts =
		Counts
	self.TotalCount = Total

	if ResetNewCount then
		self.NewCount = 0
	end

	self.LastScan = os.clock()
	self:UpdateStatusBar()
end

function SecretWatch:ForceReset()
	local Character = GetCharacter()
	local Humanoid = GetHumanoid()

	if not Character
		or not Humanoid then
		return
	end

	pcall(function()
		Humanoid.Health = 0
	end)

	task.delay(0.2, function()
		if Character.Parent
			and Humanoid.Parent
			and Humanoid.Health > 0 then
			pcall(function()
				Character:
					BreakJoints()
			end)
		end
	end)
end

function SecretWatch:StopEverything(
	DetectedCount,
	DetectedNames
)
	self.Enabled = false

	if UIState.SecretDetectorToggleControl then
		task.defer(function()
			UIState.SecretDetectorToggleControl:Set(
				false,
				true
			)
		end)
	end

	if UIState.MainFollowToggleControl then
		UIState.MainFollowToggleControl:Set(
			false,
			true
		)
	end

	if UIState.MultiFarmToggleControl then
		UIState.MultiFarmToggleControl:Set(
			false,
			true
		)
	end

	if UIState.KillAllToggleControl then
		UIState.KillAllToggleControl:Set(
			false,
			true
		)
	end

	if FlyState.Enabled then
		SetFlyEnabled(false)
	end

	StopFarmModesWithoutReset()
	self:UpdateStatusBar()

	local NameText =
		#DetectedNames > 0
			and table.concat(
				DetectedNames,
				", "
			)
			or "SECRET item"

	pcall(function()
		Window:Warning(
			"New SECRET Detected",
			tostring(DetectedCount)
				.. " new SECRET item(s): "
				.. NameText
				.. ". Everything was stopped and your character is resetting.",
			7
		)
	end)

	self:ForceReset()
end

function SecretWatch:Scan()
	if not self.Enabled then
		return
	end

	local Counts, Total, Names =
		self:BuildSnapshot()

	local DetectedCount = 0
	local DetectedNames = {}

	for Signature, Count in pairs(
		Counts
	) do
		local KnownMaximum =
			self.KnownMaximumCounts[
				Signature
			] or 0

		if Count > KnownMaximum then
			local AddedCount =
				Count - KnownMaximum

			DetectedCount += AddedCount

			for _ = 1, AddedCount do
				table.insert(
					DetectedNames,
					Names[Signature]
						or "SECRET"
				)
			end

		end
	end

	-- Store the current snapshot, including decreases. A later increase
	-- of the same item type is then recognized as a newly obtained item.
	self.KnownMaximumCounts =
		Counts
	self.TotalCount = Total

	if DetectedCount > 0 then
		self.NewCount +=
			DetectedCount
	end

	self:UpdateStatusBar()

	if DetectedCount > 0 then
		self:StopEverything(
			DetectedCount,
			DetectedNames
		)
	end
end

function SecretWatch:ContainsSecretWord(
	Value
)
	if Value == nil then
		return false
	end

	local Text =
		string.upper(
			tostring(Value)
		)

	return Text:find(
		"%f[%a]SECRET%f[%A]"
	) ~= nil
end

function SecretWatch:IsRewardContext(
	Object
)
	local Current = Object

	while Current
		and Current ~= LocalPlayer
		and Current ~= Workspace do
		local Name =
			string.lower(
				tostring(Current.Name)
			)

		if Name:find("reward", 1, true)
			or Name:find("drop", 1, true)
			or Name:find("loot", 1, true)
			or Name:find("roll", 1, true)
			or Name:find("summon", 1, true)
			or Name:find("hatch", 1, true)
			or Name:find("result", 1, true)
			or Name:find("popup", 1, true)
			or Name:find("notification", 1, true)
			or Name:find("obtained", 1, true)
			or Name:find("orb", 1, true) then
			return true
		end

		Current = Current.Parent
	end

	return false
end

function SecretWatch:GetSignalText(
	Object
)
	if not Object then
		return nil
	end

	if Object:IsA("TextLabel")
		or Object:IsA("TextButton")
		or Object:IsA("TextBox") then
		return Object.Text
	end

	if Object:IsA("StringValue") then
		return Object.Value
	end

	return nil
end

function SecretWatch:TriggerSignal(
	DisplayName,
	Source,
	Evidence
)
	if not self.Enabled
		or self.Triggered then
		return false
	end

	self.Triggered = true
	self.LastSignalSource =
		tostring(Source or "Unknown")
	self.LastSignalText =
		tostring(Evidence or DisplayName or "SECRET")
	self.LastScanReason =
		"Signal: "
		.. self.LastSignalSource
	self.NewCount += 1

	self:StopEverything(
		1,
		{
			tostring(
				DisplayName
					or "SECRET reward"
			),
		}
	)

	return true
end

function SecretWatch:InspectSignalObject(
	Object,
	Source
)
	if not self.Enabled
		or self.Triggered
		or not Object
		or not Object.Parent then
		return false
	end

	self.SignalChecks += 1

	local IsOrbSource =
		Source == "ClientOrbRewards"

	local function InspectCandidate(
		Candidate
	)
		if not Candidate
			or not Candidate.Parent then
			return false
		end

		local Rarity =
			self:ReadItemRarity(
				Candidate
			)

		if Rarity == "SECRET" then
			return self:TriggerSignal(
				Candidate.Name,
				Source,
				"Rarity=SECRET"
			)
		end

		for AttributeName, Value in pairs(
			Candidate:GetAttributes()
		) do
			local AttributeIsRarity =
				self.RarityNames[
					string.lower(
						tostring(
							AttributeName
						)
					):gsub(
						"[%s_%-]",
						""
					)
				] == true

			if AttributeIsRarity
				and self:ContainsSecretWord(
					Value
				) then
				return self:TriggerSignal(
					Candidate.Name,
					Source,
					tostring(AttributeName)
						.. "="
						.. tostring(Value)
				)
			end
		end

		local SignalText =
			self:GetSignalText(
				Candidate
			)

		if SignalText
			and self:ContainsSecretWord(
				SignalText
			)
			and (
				IsOrbSource
				or self:IsRewardContext(
					Candidate
				)
			) then
			return self:TriggerSignal(
				Candidate.Name,
				Source,
				SignalText
			)
		end

		if IsOrbSource
			and self:ContainsSecretWord(
				Candidate.Name
			) then
			return self:TriggerSignal(
				Candidate.Name,
				Source,
				Candidate.Name
			)
		end

		return false
	end

	if InspectCandidate(Object) then
		return true
	end

	local Checked = 0

	for _, Candidate in ipairs(
		Object:GetDescendants()
	) do
		Checked += 1

		if Checked > 500 then
			break
		end

		if InspectCandidate(
			Candidate
		) then
			return true
		end
	end

	return false
end

function SecretWatch:ScheduleSignalInspection(
	Object,
	Source,
	Delay
)
	if not self.Enabled
		or self.Triggered
		or not Object
		or self.PendingSignalObjects[
			Object
		] then
		return
	end

	self.PendingSignalObjects[Object] =
		true

	task.delay(
		math.max(
			0,
			tonumber(Delay) or 0.2
		),
		function()
			self.PendingSignalObjects[Object] =
				nil

			if self.Enabled
				and not self.Triggered
				and Object.Parent then
				self:InspectSignalObject(
					Object,
					Source
				)
			end
		end
	)
end

function SecretWatch:ObserveSignalObject(
	Object,
	Source
)
	if not Object
		or not Object.Parent
		or self.ObservedSignalObjects[
			Object
		] then
		return
	end

	local Connection = nil

	if Object:IsA("TextLabel")
		or Object:IsA("TextButton")
		or Object:IsA("TextBox") then
		Connection =
			Object:GetPropertyChangedSignal(
				"Text"
			):Connect(function()
				if self.Enabled then
					self:ScheduleSignalInspection(
						Object,
						Source,
						0.05
					)
				end
			end)
	elseif Object:IsA("StringValue")
		or Object:IsA("IntValue")
		or Object:IsA("NumberValue") then
		Connection =
			Object.Changed:Connect(
				function()
					if self.Enabled then
						self:ScheduleSignalInspection(
							Object,
							Source,
							0.05
						)
					end
				end
			)
	end

	if Connection then
		self.ObservedSignalObjects[
			Object
		] = Connection
		TrackRuntimeConnection(
			Connection
		)
	end
end

function SecretWatch:BindExistingSignalWatchers()
	local PlayerGui =
		LocalPlayer:
			FindFirstChildOfClass(
				"PlayerGui"
			)

	if not PlayerGui then
		return
	end

	for _, Object in ipairs(
		PlayerGui:GetDescendants()
	) do
		if self:IsRewardContext(
			Object
		)
			and (
				Object:IsA("TextLabel")
				or Object:IsA("TextButton")
				or Object:IsA("TextBox")
				or Object:IsA("StringValue")
			) then
			self:ObserveSignalObject(
				Object,
				"PlayerGui change"
			)
		end
	end
end

function SecretWatch:MarkDirty(
	Object
)
	if not self.Enabled
		or self.Triggered
		or not Object then
		return
	end

	local PlayerGui =
		LocalPlayer:
			FindFirstChildOfClass(
				"PlayerGui"
			)

	if PlayerGui
		and Object:IsDescendantOf(
			PlayerGui
		)
		and (
			Object:IsA("TextLabel")
			or Object:IsA("TextButton")
			or Object:IsA("TextBox")
			or Object:IsA("StringValue")
		) then
		self:ObserveSignalObject(
			Object,
			"PlayerGui change"
		)
		self:ScheduleSignalInspection(
			Object,
			"PlayerGui",
			0.25
		)
	end

	if not self:
		IsRelevantInventoryObject(
			Object
		) then
		return
	end

	self.Dirty = true
	self.LastEventAt =
		os.clock()
	self:ScheduleSignalInspection(
		Object,
		"Inventory",
		0.35
	)
end

function SecretWatch:DisconnectCharacterWatchers()
	for _, Connection in ipairs(
		self.CharacterConnections
	) do
		pcall(function()
			Connection:Disconnect()
		end)
	end

	table.clear(
		self.CharacterConnections
	)
end

function SecretWatch:BindCharacterWatchers(
	Character
)
	self:DisconnectCharacterWatchers()

	if not Character then
		return
	end

	table.insert(
		self.CharacterConnections,
		TrackRuntimeConnection(
			Character.DescendantAdded:
				Connect(function(Object)
					self:MarkDirty(
						Object
					)
				end)
		)
	)

	table.insert(
		self.CharacterConnections,
		TrackRuntimeConnection(
			Character.DescendantRemoving:
				Connect(function(Object)
					self:MarkDirty(
						Object
					)
				end)
		)
	)
end

function SecretWatch:BindEventWatchers()
	TrackRuntimeConnection(
		LocalPlayer.DescendantAdded:
			Connect(function(Object)
				self:MarkDirty(
					Object
				)
			end)
	)

	TrackRuntimeConnection(
		LocalPlayer.DescendantRemoving:
			Connect(function(Object)
				self:MarkDirty(
					Object
				)
			end)
	)

	TrackRuntimeConnection(
		LocalPlayer.CharacterAdded:
			Connect(function(Character)
				self:
					BindCharacterWatchers(
						Character
					)

				if self.Enabled then
					self.Dirty = true
					self.LastEventAt =
						os.clock()
				end
			end)
	)

	self:BindCharacterWatchers(
		GetCharacter()
	)
end

function SecretWatch:SetEnabled(State)
	self.Enabled =
		State == true

	if self.Enabled then
		self.Dirty = false
		self.Triggered = false
		self.LastEventAt = 0
		self.EventScans = 0
		self.FallbackScans = 0
		self.SignalChecks = 0
		self.LastSignalSource = "None"
		self.LastSignalText = "None"
		table.clear(
			self.PendingSignalObjects
		)
		self:EstablishBaseline(true)
		self:BindExistingSignalWatchers()

		pcall(function()
			Window:Success(
				"Secret Detector",
				"Enabled. Watching inventory and reward UI, with a five-second fallback scan.",
				5
			)
		end)
	else
		self.Dirty = false
		self:UpdateStatusBar()

		pcall(function()
			Window:Info(
				"Secret Detector",
				"Disabled.",
				3
			)
		end)
	end
end

