local function HoldWaitingHeight(
	Root,
	Humanoid
)
	if not Root
		or not Humanoid
		or Humanoid.Health <= 0 then
		return
	end

	TargetState.Waiting = true
	TargetState.EngagementCanClick = false
	TargetState.EngagementAboveTarget = false
	TargetState.EngagementInsideClickBox = false
	TargetState.EngagementStatus = "Waiting"
	FollowMovement.LastTarget = nil
	FollowMovement.LastCharacter = nil
	FollowMovement.InitialTeleportPending = true
	FollowMovement.RemainingForcedPivots =
		FollowMovement.ForcedPivotFrames

	-- Capture the exact place and height only once when the selected
	-- enemies run out. Keep using that same CFrame while waiting.
	if not TargetState.WaitingCFrame then
		TargetState.WaitingCFrame =
			CharacterControl:
				MakeUprightCFrame(
					TargetState.LastHeldCFrame
						or Root.CFrame,
					Root.CFrame
				)
	end

	-- Anchoring makes the saved height immune to gravity, physics,
	-- knockback, and frame-order differences while no target exists.
	Root.Anchored = true
	Root.CFrame = TargetState.WaitingCFrame
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero
end

local function ReleaseHumanoidState()
	local Humanoid = GetHumanoid()
	local Root = GetRoot()

	if Root then
		Root.Anchored = false
	end

	if not Humanoid then
		return
	end

	Humanoid.Sit = false
	Humanoid.PlatformStand = false
	Humanoid.AutoRotate = true

	for _, State in ipairs({
		Enum.HumanoidStateType.Seated,
		Enum.HumanoidStateType.Jumping,
		Enum.HumanoidStateType.GettingUp,
		Enum.HumanoidStateType.Running,
		Enum.HumanoidStateType.RunningNoPhysics,
		Enum.HumanoidStateType.Freefall,
		Enum.HumanoidStateType.Landed,
	}) do
		pcall(function()
			Humanoid:SetStateEnabled(State, true)
		end)
	end

	pcall(function()
		Humanoid:ChangeState(
			Enum.HumanoidStateType.GettingUp
		)
	end)

	task.defer(function()
		RunService.Heartbeat:Wait()

		if Enabled
			or FlyState.Enabled
			or not Humanoid.Parent
			or Humanoid.Health <= 0 then
			return
		end

		Humanoid.Sit = false
		Humanoid.PlatformStand = false

		pcall(function()
			Humanoid:ChangeState(
				Enum.HumanoidStateType.Running
			)
		end)
	end)
end

local function ResetFlyInput()
	FlyInput.W = 0
	FlyInput.S = 0
	FlyInput.A = 0
	FlyInput.D = 0
	FlyInput.Up = 0
	FlyInput.Down = 0
end

local function SetFlyEnabled(State)
	local RequestedState = State == true

	-- Fly cannot be enabled while the main enemy controller is active.
	if RequestedState
		and IsAnyFarmEnabled() then
		FlyState.Enabled = false
		FlyState.YLevel = nil
		FlyState.LastTP = 0
		ResetFlyInput()
		return false, "MainEnabled"
	end

	FlyState.Enabled = RequestedState
	FlyState.YLevel = nil
	FlyState.LastTP = 0
	ResetFlyInput()

	if FlyState.Enabled then
		local Root = GetRoot()

		if Root then
			Root.Anchored = false
			FlyState.YLevel = Root.Position.Y
		end
	else
		local Root = GetRoot()

		if Root then
			Root.AssemblyLinearVelocity = Vector3.new(
				Root.AssemblyLinearVelocity.X,
				0,
				Root.AssemblyLinearVelocity.Z
			)
			Root.AssemblyAngularVelocity = Vector3.zero
		end

		if not IsAnyFarmEnabled() then
			ReleaseHumanoidState()
		end
	end

	return true
end

local function HandleFlyKey(Input, IsDown)
	if Input.KeyCode == Enum.KeyCode.W then
		FlyInput.W = IsDown and -1 or 0
	elseif Input.KeyCode == Enum.KeyCode.S then
		FlyInput.S = IsDown and 1 or 0
	elseif Input.KeyCode == Enum.KeyCode.A then
		FlyInput.A = IsDown and -1 or 0
	elseif Input.KeyCode == Enum.KeyCode.D then
		FlyInput.D = IsDown and 1 or 0
	elseif Input.KeyCode == Enum.KeyCode.Space then
		FlyInput.Up = IsDown and 1 or 0
	elseif Input.KeyCode == Enum.KeyCode.LeftControl then
		FlyInput.Down = IsDown and -1 or 0
	end
end

TrackRuntimeConnection(
	UserInputService.InputBegan:Connect(function(Input, GameProcessed)
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	if GameProcessed
		or UserInputService:GetFocusedTextBox() then
		return
	end

	if Input.KeyCode == Enum.KeyCode.X then
		local RequestedState =
			not FlyState.Enabled

		local Changed, Reason =
			SetFlyEnabled(RequestedState)

		pcall(function()
			if not Changed
				and Reason == "MainEnabled" then
				Window:Warning(
					"Player Fly",
					"Disable the main enemy controller before enabling Fly.",
					3
				)
			elseif FlyState.Enabled then
				Window:Success(
					"Player Fly",
					"Fly enabled with X.",
					3
				)
			else
				Window:Info(
					"Player Fly",
					"Fly disabled with X.",
					3
				)
			end
		end)

		return
	end

	HandleFlyKey(Input, true)
end)
)

TrackRuntimeConnection(
	UserInputService.InputEnded:Connect(function(Input)
	if ScriptToken
		~= Environment.__CrimmyAutoEnemyController then
		return
	end

	HandleFlyKey(Input, false)
end)
)

