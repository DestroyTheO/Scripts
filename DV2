local function ApplyHumanoidState(Humanoid)
	if not Humanoid or Humanoid.Health <= 0 then
		return
	end

	Humanoid.AutoRotate = false

	if CharacterControl.HumanoidState == "None" then
		return
	end

	local State =
		Enum.HumanoidStateType[
			CharacterControl.HumanoidState
		]

	if State then
		Humanoid:ChangeState(State)
	end
end

local function GetDexTeleportPart(TargetObject)
	if not TargetObject then
		return nil
	end

	if TargetObject:IsA("BasePart") then
		return TargetObject
	end

	if TargetObject:IsA("Model") then
		local PrimaryPart = TargetObject.PrimaryPart

		if PrimaryPart
			and PrimaryPart:IsA("BasePart") then
			return PrimaryPart
		end
	end

	return TargetObject:FindFirstChildWhichIsA(
		"BasePart",
		true
	)
end

local function ApplyMobPositionOffset(
	WorldPivot
)
	if not WorldPivot then
		return nil
	end

	local Distance = math.clamp(
		tonumber(FarmState.SelectedMobDistance)
			or MinimumMobDistance,
		MinimumMobDistance,
		MaximumMobDistance
	)

	local OffsetX = 0
	local OffsetZ = 0

	if FarmState.SelectedMobPosition == "Left" then
		OffsetX = -Distance

	elseif FarmState.SelectedMobPosition == "Right" then
		OffsetX = Distance

	elseif FarmState.SelectedMobPosition == "Behind" then
		-- Positive local Z is behind the WorldPivot.
		OffsetZ = Distance

	elseif FarmState.SelectedMobPosition == "In Front" then
		-- Negative local Z follows the WorldPivot LookVector.
		OffsetZ = -Distance
	end

	-- Horizontal placement is local to the mob's WorldPivot, while
	-- height remains true world-up even if a model has a tilted pivot.
	local HorizontalCFrame =
		WorldPivot
		* CFrame.new(
			OffsetX,
			0,
			OffsetZ
		)

	return HorizontalCFrame
		+ Vector3.new(
			0,
			FarmState.SelectedHeightAboveEnemy,
			0
		)
end

local function GetTargetWorldPivotCFrame(
	TargetObject
)
	if not TargetObject
		or not TargetObject.Parent then
		return nil
	end

	local Hitbox =
		FindTargetHitbox(
			TargetObject,
			false
		)

	if Hitbox
		and Hitbox.Parent then
		local Height =
			math.max(
				1,
				tonumber(
					FarmState
						.SelectedHeightAboveEnemy
				) or 24
			)

		local Position =
			Hitbox.Position
			+ Vector3.new(
				0,
				Hitbox.Size.Y * 0.5
					+ Height,
				0
			)

		local Look =
			Hitbox.CFrame.LookVector

		local HorizontalLook =
			Vector3.new(
				Look.X,
				0,
				Look.Z
			)

		local TargetCFrame

		if HorizontalLook.Magnitude
			> 0.001 then
			TargetCFrame =
				CFrame.lookAt(
					Position,
					Position
						+ HorizontalLook.Unit
				)
		else
			TargetCFrame =
				CFrame.new(Position)
		end

		TargetState.LastPivotSource =
			"Target Hitbox: "
			.. tostring(Hitbox.Name)

		return TargetCFrame
	end

	local PivotOwner =
		TargetState.CachedTarget
				== TargetObject
			and TargetState.CachedPivotOwner
			or ResolveTargetPivotOwner(
				TargetObject
			)

	if PivotOwner then
		local WorldPivot =
			ReadModelWorldPivot(
				PivotOwner
			)

		if WorldPivot then
			TargetState.LastPivotSource =
				"Model WorldPivot fallback"
			TargetState.WorldPivotUses += 1

			return ApplyMobPositionOffset(
				WorldPivot
			)
		end
	end

	local Part =
		TargetObject:IsA("BasePart")
				and TargetObject
			or (
				TargetState.CachedTarget
						== TargetObject
					and TargetState
						.CachedMovementPart
					or FindValidPart(
						TargetObject
					)
			)

	if Part
		and Part.Parent then
		TargetState.LastPivotSource =
			"Part CFrame fallback"
		TargetState.PartPivotFallbacks +=
			1

		return ApplyMobPositionOffset(
			Part.CFrame
		)
	end

	TargetState.LastPivotSource =
		"No pivot available"

	return nil
end


local function ApplyVerifiedCharacterPivot(
	Character,
	Root,
	TargetCFrame
)
	if not Character
		or not Root
		or not Root.Parent
		or typeof(TargetCFrame)
			~= "CFrame" then
		return false
	end

	TargetCFrame =
		CharacterControl:
			MakeUprightCFrame(
				TargetCFrame,
				Root.CFrame
			)

	local CurrentPivot =
		Character:GetPivot()

	-- Preserve the exact Root-to-model-pivot relationship for the
	-- fallback. Assigning Root.CFrame directly to TargetCFrame can
	-- otherwise offset rigs whose model pivot is not the HRP.
	local RootRelativeToPivot =
		CurrentPivot:ToObjectSpace(
			Root.CFrame
		)

	Root.Anchored = false

	if ProfilerState.Enabled then
		ProfilerState.PivotCalls += 1
	end

	local PivotCallWorked =
		pcall(function()
			Character:PivotTo(
				TargetCFrame
			)
		end)

	local ResultPivot =
		Character:GetPivot()

	local PivotError =
		(
			TargetCFrame.Position
			- ResultPivot.Position
		).Magnitude

	FollowMovement.LastPivotError =
		PivotError

	-- A successful pcall does not guarantee that the character moved.
	-- Verify the result and drive the HumanoidRootPart to the equivalent
	-- exact model-pivot destination when PivotTo was ignored.
	if not PivotCallWorked
		or PivotError
			> FollowMovement.PivotVerifyDistance then
		FollowMovement.PivotFallbacks += 1

		local DesiredRootCFrame =
			CharacterControl:
				MakeUprightCFrame(
					TargetCFrame
						* RootRelativeToPivot,
					Root.CFrame
				)

		local FallbackWorked =
			pcall(function()
				Root.CFrame =
					DesiredRootCFrame
			end)

		if not FallbackWorked then
			FollowMovement.PivotFailures += 1
			return false
		end

		ResultPivot =
			Character:GetPivot()

		PivotError =
			(
				TargetCFrame.Position
				- ResultPivot.Position
			).Magnitude

		FollowMovement.LastPivotError =
			PivotError

		if PivotError
			> FollowMovement.PivotVerifyDistance then
			FollowMovement.PivotFailures += 1
			return false
		end
	end

	Root.AssemblyLinearVelocity =
		Vector3.zero
	Root.AssemblyAngularVelocity =
		Vector3.zero

	CharacterControl:
		KeepUpright(
			Root
		)

	return true
end

local function MoveCharacterLikeFly(
	Root,
	Humanoid,
	TargetObject,
	DeltaTime
)
	if not Root
		or not Humanoid
		or Humanoid.Health <= 0 then
		return false
	end

	local Character = GetCharacter()

	if not Character
		or Character ~= Root.Parent then
		return false
	end

	if not CacheTargetRuntime(
		TargetObject,
		false
	) then
		return false
	end

	local TargetCFrame =
		GetTargetWorldPivotCFrame(
			TargetObject
		)

	if not TargetCFrame then
		return false
	end

	Root.Anchored = false
	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero

	local IsChronyxSequence =
		TargetState.IsChronyxShard
		or (
			not IsMultiModeEnabled()
			and FarmState.SelectedMobChoice
				== "Chronyx - Super Boss"
		)

	-- Regular mobs and normal bosses use verified instant positioning.
	-- Force several consecutive pivots after acquiring a target so an
	-- old waiting anchor or a one-frame server correction cannot cancel
	-- the first teleport.
	if not IsChronyxSequence then
		local TargetChanged =
			FollowMovement.LastTarget
				~= TargetObject
			or FollowMovement.LastCharacter
				~= Character

		if TargetChanged then
			FollowMovement.RemainingForcedPivots =
				FollowMovement.ForcedPivotFrames
		end

		local CurrentCFrame =
			Character:GetPivot()

		local Distance =
			(
				TargetCFrame.Position
				- CurrentCFrame.Position
			).Magnitude

		local MustForcePivot =
			FollowMovement.RemainingForcedPivots
				> 0
			or TargetState
				.EngagementForceTeleport

		if not MustForcePivot
			and Distance
				<= FollowMovement.PivotSkipDistance then
			if ProfilerState.Enabled then
				ProfilerState.PivotSkips += 1
			end

			FollowMovement.LastTarget =
				TargetObject
			FollowMovement.LastCharacter =
				Character
			FollowMovement.InitialTeleportPending =
				true

			return true
		end

		local WasSafetyTeleport =
			TargetState
				.EngagementForceTeleport

		local Teleported =
			ApplyVerifiedCharacterPivot(
				Character,
				Root,
				TargetCFrame
			)

		if Teleported
			and WasSafetyTeleport then
			TargetState
				.EngagementForceTeleport =
				false
			TargetState
				.EngagementSafetyTeleports +=
				1
		end

		if Teleported
			and FollowMovement.RemainingForcedPivots
				> 0 then
			FollowMovement.RemainingForcedPivots -=
				1
		end

		FollowMovement.LastTarget =
			TargetObject
		FollowMovement.LastCharacter =
			Character
		FollowMovement.InitialTeleportPending =
			true

		return Teleported
	end

	local NeedsInitialTeleport =
		FollowMovement.InitialTeleportPending
		or FollowMovement.LastTarget
			~= TargetObject
		or FollowMovement.LastCharacter
			~= Character
		or TargetState
			.EngagementForceTeleport

	if NeedsInitialTeleport then
		-- Chronyx sequence: one verified hard teleport, then smooth
		-- following remains unchanged.
		local Teleported =
			ApplyVerifiedCharacterPivot(
				Character,
				Root,
				TargetCFrame
			)

		if not Teleported then
			return false
		end

		if TargetState
			.EngagementForceTeleport then
			TargetState
				.EngagementForceTeleport =
				false
			TargetState
				.EngagementSafetyTeleports +=
				1
		end

		FollowMovement.LastTarget =
			TargetObject
		FollowMovement.LastCharacter =
			Character
		FollowMovement.InitialTeleportPending =
			false

		return true
	end

	local CurrentCFrame =
		Character:GetPivot()

	local Offset =
		TargetCFrame.Position
		- CurrentCFrame.Position

	local Distance = Offset.Magnitude

	if Distance
		<= FollowMovement.PivotSkipDistance then
		if ProfilerState.Enabled then
			ProfilerState.PivotSkips += 1
		end

		return true
	end

	local FrameTime =
		math.clamp(
			tonumber(DeltaTime) or 0,
			1 / 240,
			1 / 15
		)

	local MaximumStep =
		FollowMovement.Speed
		* FrameTime

	local NextPosition

	if Distance <= FollowMovement.SnapDistance then
		NextPosition =
			TargetCFrame.Position
	elseif Distance > 0 then
		NextPosition =
			CurrentCFrame.Position
			+ Offset.Unit
				* math.min(
					Distance,
					MaximumStep
				)
	else
		NextPosition =
			CurrentCFrame.Position
	end

	local TargetRotation =
		TargetCFrame
		- TargetCFrame.Position

	local NextCFrame =
		CFrame.new(NextPosition)
		* TargetRotation

	local Moved =
		ApplyVerifiedCharacterPivot(
			Character,
			Root,
			NextCFrame
		)

	return Moved
end

