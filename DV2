	wheel = false,
	callbackThrottle = 0.05,

	valueFormatter = function(Value)
		local Studs =
			math.floor(
				(tonumber(Value) or 24)
					+ 0.5
			)

		return tostring(Studs)
			.. (
				Studs == 1
					and " stud"
					or " studs"
			)
	end,

	callback = function(Value)
		FarmState.SelectedHeightAboveEnemy =
			math.clamp(
				math.floor(
					(tonumber(Value) or 24)
						+ 0.5
				),
				MinimumHeight,
				MaximumHeight
			)
	end,
})

