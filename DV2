function PotionSystem:FormatNumber(
	Value
)
	local Number =
		math.floor(
			tonumber(Value) or 0
		)

	local Sign = ""

	if Number < 0 then
		Sign = "-"
		Number = math.abs(Number)
	end

	local Formatted =
		tostring(Number)

	while true do
		local Updated, Replacements =
			Formatted:gsub(
				"^(%d+)(%d%d%d)",
				"%1,%2"
			)

		Formatted = Updated

		if Replacements == 0 then
			break
		end
	end

	return Sign .. Formatted
end

function PotionSystem:CopySelection(
	Value
)
	local Result = {}
	local Added = {}

	if type(Value) ~= "table" then
		return Result
	end

	for _, DisplayName in ipairs(
		Value
	) do
		if type(DisplayName) == "string"
			and self.Definitions[
				DisplayName
			]
			and not Added[
				DisplayName
			] then
			Added[DisplayName] =
				true

			table.insert(
				Result,
				DisplayName
			)
		end
	end

	for DisplayName, Selected in pairs(
		Value
	) do
		if type(DisplayName) == "string"
			and Selected == true
			and self.Definitions[
				DisplayName
			]
			and not Added[
				DisplayName
			] then
			Added[DisplayName] =
				true

			table.insert(
				Result,
				DisplayName
			)
		end
	end

	table.sort(
		Result,
		function(A, B)
			local AIndex =
				table.find(
					self.Names,
					A
				) or math.huge

			local BIndex =
				table.find(
					self.Names,
					B
				) or math.huge

			return AIndex < BIndex
		end
	)

	return Result
end

function PotionSystem:CalculateTotal()
	local PricePerSet = 0

	for _, DisplayName in ipairs(
		self.Selected
	) do
		local Definition =
			self.Definitions[
				DisplayName
			]

		if Definition then
			PricePerSet +=
				Definition.Price
		end
	end

	local Amount =
		math.clamp(
			math.floor(
				tonumber(
					self.Amount
				) or 1
			),
			self.Minimum,
			self.Maximum
		)

	return PricePerSet * Amount,
		PricePerSet,
		Amount
end

function PotionSystem:UpdateTotalDisplay()
	local TotalCost =
		self:CalculateTotal()

	if UIState.PotionTotalDisplay
		and type(
			UIState
