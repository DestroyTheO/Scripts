local function IsSelectedMobContainer(Object)
	return Object
		and MatchesAnyActiveEnemyName(
			Object.Name
		)
		and (
			Object:IsA("Model")
			or Object:IsA("BasePart")
		)
end

local function IsInsideAnotherSelectedMob(
	Object,
	SearchRoot
)
	local Parent = Object.Parent

	while Parent and Parent ~= SearchRoot do
		if IsSelectedMobContainer(Parent) then
			return true
		end

		Parent = Parent.Parent
	end

	return false
end

local function AddCandidateConnection(Connection)
	if Connection then
		table.insert(
			TargetState.CandidateConnections,
			Connection
		)
	end
end

local function WatchHealthOrPart(Object)
	if Object:IsA("Humanoid") then
		AddCandidateConnection(
			Object.HealthChanged:Connect(
				MarkMobScanDirty
			)
		)

	elseif (
		Object:IsA("NumberValue")
		or Object:IsA("IntValue")
	) and (
		Object.Name == "Health"
		or Object.Name == "HP"
		or Object.Name == "HitPoints"
	) then
		AddCandidateConnection(
			Object.Changed:Connect(
				MarkMobScanDirty
			)
		)

	end
end

local function WatchCandidateMob(Mob)
	AddCandidateConnection(
		Mob.AncestryChanged:Connect(
			MarkMobScanDirty
		)
	)

	AddCandidateConnection(
		Mob.DescendantAdded:Connect(function(Object)
			WatchHealthOrPart(Object)
			MarkMobScanDirty()
		end)
	)

	AddCandidateConnection(
		Mob.DescendantRemoving:Connect(
			MarkMobScanDirty
		)
	)

	for _, Object in ipairs(Mob:GetDescendants()) do
		WatchHealthOrPart(Object)
	end

	for _, AttributeName in ipairs({
		"Health",
		"HP",
		"HitPoints",
	}) do
		AddCandidateConnection(
			Mob:GetAttributeChangedSignal(
				AttributeName
			):Connect(MarkMobScanDirty)
		)
	end
end

local function FindSelectedContainerAncestor(Object)
	local SearchRoot = GetMobSearchRoot()
	local Current = Object

	while Current and Current ~= SearchRoot do
		if IsSelectedMobContainer(Current) then
			return Current
		end

		Current = Current.Parent
	end

	return nil
end

local function WorkspaceChangeCouldAffectSelection(Object)
	if not Object then
		return false
	end

	if IsSelectedMobContainer(Object) then
		return true
	end

	return FindSelectedContainerAncestor(Object) ~= nil
end

local function BindEnemyFolderWatchers()
	local SearchRoot = GetMobSearchRoot()

	RefreshEnemyEventLookup()

	if IsChronyxModeSelected() then
		BindChronyxHierarchyWatchers(false)
		BindChronyxShardWatchers(false)
	else
		DisconnectConnectionList(
			TargetState.ShardConnections
		)
		DisconnectConnectionList(
			TargetState.WorkspaceShardConnections
		)
		TargetState.ShardWatchFolder = nil
		TargetState.ShardCacheDirty = true
		table.clear(TargetState.ShardCache)
		TargetState.ShardCount = 0
	end

	if SearchRoot
			== TargetState.BoundEnemiesFolder
		and #TargetState.FolderConnections
			> 0 then
		return SearchRoot
	end

	DisconnectConnectionList(
		TargetState.FolderConnections
	)

	TargetState.BoundEnemiesFolder =
		SearchRoot

	if SearchRoot then
		local function RelevantEnemyChanged(
			Object
		)
			if not Object
				or not (
					Object:IsA("Model")
					or Object:IsA("BasePart")
				) then
				return
			end

			-- Ignore ordinary limbs/effects. The active-name lookup is
			-- precomputed, so nested spawn events do not loop through
			-- every mob and boss definition.
			if ResolveCachedChoiceForName(
				Object.Name,
				TargetState.EventExactLookup,
				TargetState.EventPrefixEntries
			) then
				MarkMobScanDirty()
			end
		end

		table.insert(
			TargetState.FolderConnections,
			SearchRoot.DescendantAdded:
				Connect(
					RelevantEnemyChanged
				)
		)

		table.insert(
			TargetState.FolderConnections,
			SearchRoot.DescendantRemoving:
				Connect(
					RelevantEnemyChanged
				)
		)
	end

	return SearchRoot
end

local function StopMobScanning()
	DisconnectConnectionList(
		TargetState.FolderConnections
	)
	DisconnectConnectionList(
		TargetState.CandidateConnections
	)
	DisconnectConnectionList(
		TargetState.ShardConnections
	)
	DisconnectConnectionList(
		TargetState.WorkspaceShardConnections
	)

	TargetState.BoundEnemiesFolder = nil
	TargetState.ShardWatchFolder = nil
	TargetState.CachedList = {}
	table.clear(TargetState.MobCacheByChoice)
	table.clear(TargetState.EventExactLookup)
	table.clear(TargetState.EventPrefixEntries)
	TargetState.MobCacheModeKey = ""
	TargetState.LastMobCacheRefresh = 0
	TargetState.LastResolve = 0
	table.clear(TargetState.ShardCache)
	TargetState.ShardCount = 0
	TargetState.ShardCacheDirty = true
	TargetState.ShardRefreshQueued = false
	TargetState.ScanDirty = true
end

local function MaintainRuntimeCaches(
	FullClear
)
	local Removed = 0
	local Enemies =
		Workspace:FindFirstChild(
			"Enemies"
		)

	local ShardsFolder =
		GetChronyxShardsFolder()

	local function PruneObjectList(
		List,
		ExpectedRoot
	)
		if type(List) ~= "table" then
			return
		end

		for Index = #List, 1, -1 do
			local Object = List[Index]
			local Keep =
				typeof(Object) == "Instance"
				and Object.Parent ~= nil

			if Keep and ExpectedRoot then
				local Success, IsInside =
					pcall(function()
						return Object
							:IsDescendantOf(
								ExpectedRoot
							)
					end)

				Keep =
					Success
					and IsInside == true
			end

			if not Keep then
				table.remove(
					List,
					Index
				)
				Removed += 1
			end
		end
	end

	local function PruneConnections(
		List
	)
		if type(List) ~= "table" then
			return
		end

		for Index = #List, 1, -1 do
			local Connection =
				List[Index]

			local Success, Connected =
				pcall(function()
					return Connection
						and Connection.Connected
				end)

			if not Success
				or Connected ~= true then
				table.remove(
					List,
					Index
				)
				Removed += 1
			end
		end
	end

	if FullClear then
		for _, List in pairs(
			TargetState.MobCacheByChoice
		) do
			if type(List) == "table" then
				Removed += #List
			end
		end

		table.clear(
			TargetState.MobCacheByChoice
		)
		TargetState.MobCacheModeKey = ""
		TargetState.LastMobCacheRefresh = 0
		TargetState.MobDirectCandidates = 0
		TargetState.MobDescendantFallbacks = 0
		TargetState.MobDescendantCandidates = 0
		TargetState.ScanDirty = true
		TargetState.LastResolve = 0

		Removed +=
			#TargetState.ShardCache

		table.clear(
			TargetState.ShardCache
		)
		TargetState.ShardCount = 0
		TargetState.ShardCacheDirty = true
	else
		if Enemies then
			for Choice, List in pairs(
				TargetState.MobCacheByChoice
			) do
				PruneObjectList(
					List,
					Enemies
				)

				if #List == 0 then
					TargetState.MobCacheByChoice[
						Choice
					] = nil
				end
			end
		else
			for _, List in pairs(
				TargetState.MobCacheByChoice
			) do
				if type(List) == "table" then
					Removed += #List
				end
			end

			table.clear(
				TargetState.MobCacheByChoice
			)
			TargetState.MobCacheModeKey =
				""
			TargetState.LastMobCacheRefresh =
				0
		end

		if ShardsFolder then
			PruneObjectList(
				TargetState.ShardCache,
				ShardsFolder
			)
		else
			Removed +=
				#TargetState.ShardCache

			table.clear(
				TargetState.ShardCache
			)
			TargetState.ShardCacheDirty =
				true
		end

		TargetState.ShardCount =
			#TargetState.ShardCache
	end

	-- Legacy cache/watch data is not used by the active resolver.
	Removed += #TargetState.CachedList
	table.clear(
		TargetState.CachedList
	)

	DisconnectConnectionList(
		TargetState.CandidateConnections
	)

	local LiveNoclipParts = 0

	for Part in pairs(
		CollisionStates
	) do
		if typeof(Part) ~= "Instance"
			or not Part.Parent then
			CollisionStates[Part] = nil
			Removed += 1
		else
			LiveNoclipParts += 1
		end
	end

	CharacterControl.NoclipTrackedCount =
		LiveNoclipParts

	PruneConnections(
		TargetState.FolderConnections
	)
	PruneConnections(
		TargetState.ShardConnections
	)
	PruneConnections(
		TargetState.WorkspaceShardConnections
	)
	PruneConnections(
		WeaponState.Connections
	)
	PruneConnections(
		RuntimeState.Connections
	)

	local CachedTarget =
		TargetState.CachedTarget

	if CachedTarget
		and (
			not CachedTarget.Parent
			or (
				not TargetState.IsChronyxShard
				and (
					not Enemies
					or not CachedTarget
						:IsDescendantOf(
							Enemies
						)
				)
			)
		) then
		ClearTargetRuntimeCache()
		TargetState.Current = nil
		TargetState.LastResolve = 0
		TargetState.ScanDirty = true
		Removed += 1
	end

	RuntimeState.CachePrunes += 1
	RuntimeState.StaleEntriesRemoved +=
		Removed

	DiagnosticsState.LastControlSignature =
		""

	return Removed
end

