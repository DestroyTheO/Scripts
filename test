    if event.UserInputType~=Enum.UserInputType.Keyboard then return end
    local key=event.KeyCode
    local ctrl=input:IsKeyDown(Enum.KeyCode.LeftControl) or input:IsKeyDown(Enum.KeyCode.RightControl)
    if key==Enum.KeyCode.K and ctrl then
        if barHidden then setBarHidden(false) end
        setMenuOpen(false)
        bar:CaptureFocus()
        return
    end
    if bar:IsFocused() then
        if key==Enum.KeyCode.Down and #suggestOptions>0 then
            focusedIndex=focusedIndex%#suggestOptions+1
            redrawSuggestions()
        elseif key==Enum.KeyCode.Up and #suggestOptions>0 then
            focusedIndex=(focusedIndex-2+#suggestOptions)%#suggestOptions+1
            redrawSuggestions()
        elseif key==Enum.KeyCode.Tab and #suggestOptions>0 then
            acceptSuggestion(focusedIndex)
        elseif key==Enum.KeyCode.Escape then
            dismissedSuggestions=true
            suggestPanel.Visible=false
            bar:ReleaseFocus()
        end
        return
    end
    if key==Enum.KeyCode.RightShift and not processed then
        if barHidden then
            setBarHidden(false)
            setMenuOpen(true)
        else
            setMenuOpen(not isMenuOpen)
        end
    elseif key==Enum.KeyCode.Escape and isMenuOpen then
        setMenuOpen(false)
    end
end)

