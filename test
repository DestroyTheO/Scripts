-- Matching, alias, player name and number completions.
local function trim(v)
    return (v or ""):match("^%s*(.-)%s*$") or ""
end
local function parseInput(textValue)
    -- Preserve trailing whitespace: "goto " and "speed " reveal argument suggestions.
    local textInput=(textValue or ""):lower():match("^%s*(.*)$") or ""
    local prefix=textInput:match("^([:;!?/%.])") or ""
    if prefix~="" then
        textInput=textInput:sub(2):match("^%s*(.*)$") or ""
    end
    local first, rest=textInput:match("^(%S+)%s*(.*)$")
    local hasArg=first~=nil and textInput:find("%s")~=nil
    return prefix, first or "", trim(rest), hasArg
end
local function getSuggestions(textValue)
    local prefix, verb, arg, hasArg=parseInput(textValue)
    if verb=="" then return {} end
    local entry=cmdIndex[verb]
    local list={}
    if hasArg and entry and entry.arg=="player" then
        local found={}
        for _, player in ipairs(players:GetPlayers()) do
            if player~=localp then
                local name=player.Name:lower()
                local display=player.DisplayName:lower()
                local score
                if arg=="" then score=10
                elseif name==arg or display==arg then score=0
                elseif name:sub(1,#arg)==arg then score=1
                elseif display:sub(1,#arg)==arg then score=2
                elseif name:find(arg,1,true) then score=3
                elseif display:find(arg,1,true) then score=4 end
                if score then
                    table.insert(found,{score=score,label=player.DisplayName,detail="@"..player.Name,
                        badge="PLAYER",value=prefix..verb.." "..player.Name})
                end
            end
        end
        table.sort(found,function(a,b)
            if a.score==b.score then return a.label:lower()<b.label:lower() end
            return a.score<b.score
        end)
        for i=1,math.min(maxSuggestions,#found) do table.insert(list,found[i]) end
        return list
    end
    if hasArg and entry and entry.arg=="number" then
        local numbers
        if entry.name=="walkspeed" then
            numbers={16,24,32,50,75}
        elseif entry.name=="jumpheight" then
            numbers={5.5,10,20,30,50}
        elseif entry.name=="fov" then
            numbers={60,70,80,90,100}
        else
            numbers={10,25,50,75,100}
        end
        for _, number in ipairs(numbers) do
            local formatted=tostring(number)
            if arg=="" or formatted:sub(1,#arg)==arg then
                table.insert(list,{score=10,label=verb.." "..formatted,
                    detail="Use "..formatted.." as the "..entry.arg,badge="VALUE",
                    value=prefix..verb.." "..formatted})
            end
        end
        return list
    end
    if hasArg then return {} end
    for _, c in ipairs(catalog) do
        local score=100
        local matchingAlias=nil
        if c.name==verb then score=0
        elseif c.name:sub(1,#verb)==verb then score=1
        elseif c.name:find(verb,1,true) then score=5 end
        for _, alias in ipairs(c.aliases) do
            if alias==verb and score>0 then score=0; matchingAlias=alias
            elseif alias:sub(1,#verb)==verb and score>2 then score=2; matchingAlias=alias
            elseif alias:find(verb,1,true) and score>6 then score=6; matchingAlias=alias end
        end
        if score<100 then
            local target=c.name
            local displayName=c.name..(c.arg and "  <"..c.arg..">" or "")
            table.insert(list,{
                score=score, label=displayName,
                detail=c.description, badge=matchingAlias and ("/"..matchingAlias) or c.category:upper(),
                value=prefix..target..(c.arg and " " or ""),
            })
        end
    end
    table.sort(list,function(a,b)
        if a.score==b.score then return a.label<b.label end
        return a.score<b.score
    end)
    while #list>maxSuggestions do table.remove(list) end
    return list
end

local function redrawSuggestions()
    local visible=#suggestOptions>0 and bar:IsFocused() and not isMenuOpen and not dismissedSuggestions
    suggestPanel.Visible=visible
    if not visible then return end
    focusedIndex=math.clamp(focusedIndex,1,#suggestOptions)
    local panelHeight=8+#suggestOptions*43
    -- Dropdown is always the same width as the command bar.
    local viewport=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize
    local width=viewport and getBarWidth(viewport.X) or BAR_WIDTH
    suggestPanel.Size=UDim2.fromOffset(width,panelHeight)
    -- Suggestions rise directly above the original bottom command bar.
    suggestPanel.Position=UDim2.new(.112,70,1,-84-panelHeight-8)
    for i,entry in ipairs(suggestRows) do
        local option=suggestOptions[i]
        entry.frame.Visible=option~=nil
        if option then
            entry.name.Text=option.label
            entry.detail.Text=option.detail
            entry.shortcut.Text=option.badge
            entry.frame.BackgroundColor3=i==focusedIndex and C.rowHover or C.surface
        end
    end
end
local function refreshSuggestions()
    dismissedSuggestions=false
    suggestOptions=getSuggestions(bar.Text)
    focusedIndex=1
    redrawSuggestions()
end
local function acceptSuggestion(index)
    local option=suggestOptions[index or focusedIndex]
    if not option then return false end
    bar.Text=option.value
    bar:CaptureFocus()
    task.defer(function()
        if bar.Parent then bar.CursorPosition=#bar.Text+1 end
    end)
    return true
end
for i,entry in ipairs(suggestRows) do
    entry.frame.Activated:Connect(function()
        acceptSuggestion(i)
    end)
end
