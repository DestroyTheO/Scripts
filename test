local function counttp()
    if ignore then
        return true
    end
    if tpblocked then
        return false
    end

    tps += 1
    tpgen += 1

    local gen = tpgen

    task.delay(tpreset, function()
        if tpgen == gen and not tpblocked then
            tps = 0
        end
    end)

    if tps >= tplimit then
        tpblocked = true
        notify("TP Limit", "TP limit reached! Wait 20 seconds.", 5)

        task.delay(20, function()
            tps = 0
            tpblocked = false
            tpgen += 1
        end)

        return false
    end

    return true
end

