local function createesp(plr)
    removeesp(plr)

    if not espbool or plr == localp then return end

    local ch = plr.Character
    if not ch then return end

    local hm = ch:FindFirstChildOfClass("Humanoid")
    local head = ch:FindFirstChild("Head")
