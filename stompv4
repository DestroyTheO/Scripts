local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local playersFolder = Workspace:WaitForChild("Players")

local Y_OFFSET = 1
local STOMP_INTERVAL = 0.1

local AdminEvent = ReplicatedStorage
    :WaitForChild("NewAdminRemotes")
    :WaitForChild("AdminAction")

local MainEvent = ReplicatedStorage
    :WaitForChild("MainRemotes")
    :WaitForChild("MainRemoteEvent")

local currentTarget = nil
local teleportedToCurrent = false
local stompTimer = 0

-- KOStompPad that existed when we started this target
local targetStompPad = nil
local hadStompPad = false

------------------------------------------------------------
-- NIL INSTANCE HELPER
------------------------------------------------------------

local function getNil(name, class)
    if not getnilinstances then
        return nil
    end

    for _, v in next, getnilinstances() do
        if v.ClassName == class and v.Name == name then
            return v
        end
    end

    return nil
end

------------------------------------------------------------
-- CHARACTER HELPERS
------------------------------------------------------------

local function getLocalRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
end

local function getTargetTorso(model)
    if not model then
        return nil
    end

    return model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(model)
    if not model then
        return nil
    end

    return model:FindFirstChildOfClass("Humanoid")
end

------------------------------------------------------------
-- TARGET VALIDATION
------------------------------------------------------------

local function validTarget(model)
    if not model or not model.Parent then
        return false
    end

    if model.Name == LocalPlayer.Name then
        return false
    end

    if model:GetAttribute("Stomped") == true then
        return false
    end

    local humanoid = getHumanoid(model)
    local torso = getTargetTorso(model)

    return humanoid
        and humanoid.Health > 0
        and torso ~= nil
end

local function getNextTarget()
    for _, model in ipairs(playersFolder:GetChildren()) do
        if model:IsA("Model")
            and model.Name ~= LocalPlayer.Name
            and model:GetAttribute("Stomped") ~= true
        then
            if validTarget(model) then
                return model
            end
        end
    end

    return nil
end

------------------------------------------------------------
-- STATE
------------------------------------------------------------

local function clearTarget()
    currentTarget = nil
    teleportedToCurrent = false
    stompTimer = 0

    targetStompPad = nil
    hadStompPad = false
end

local function selectNextTarget()
    clearTarget()

    currentTarget = getNextTarget()

    if not currentTarget then
        return
    end

    -- Save whatever KOStompPad currently exists
    targetStompPad = getNil("KOStompPad", "Part")
    hadStompPad = targetStompPad ~= nil

    print("[AutoStomp] Target:", currentTarget.Name)
end

------------------------------------------------------------
-- TELEPORT ONCE
------------------------------------------------------------

local function teleportOnce(model)
    local root = getLocalRoot()
    local torso = getTargetTorso(model)

    if not root or not torso then
        return false
    end

    if model:GetAttribute("Stomped") == true then
        return false
    end

    local rx, ry, rz = root.CFrame:ToEulerAnglesXYZ()

    root.CFrame =
        CFrame.new(torso.Position + Vector3.new(0, Y_OFFSET, 0))
        * CFrame.Angles(rx, ry, rz)

    return true
end

------------------------------------------------------------
-- STOMP
------------------------------------------------------------

local function stomp()
    pcall(function()
        MainEvent:FireServer("Stomp")
    end)
end

------------------------------------------------------------
-- MAIN LOOP
------------------------------------------------------------

RunService.Heartbeat:Connect(function(dt)

    --------------------------------------------------------
    -- FIND INITIAL / NEXT TARGET
    --------------------------------------------------------

    if not currentTarget then
        selectNextTarget()

        if not currentTarget then
            return
        end
    end

    --------------------------------------------------------
    -- TARGET VANISHED
    --------------------------------------------------------

    if not currentTarget.Parent then
        selectNextTarget()
        return
    end

    --------------------------------------------------------
    -- ALREADY STOMPED -> NEXT
    --------------------------------------------------------

    if currentTarget:GetAttribute("Stomped") == true then
        print("[AutoStomp] Stomped:", currentTarget.Name)

        selectNextTarget()
        return
    end

    --------------------------------------------------------
    -- KOStompPad DISAPPEARED -> NEXT
    --------------------------------------------------------

    local currentPad = getNil("KOStompPad", "Part")

    -- Only use disappearance as a signal if a pad
    -- actually existed for this target.
    if hadStompPad and currentPad == nil then
        print("[AutoStomp] KOStompPad disappeared -> next target")

        selectNextTarget()
        return
    end

    --------------------------------------------------------
    -- DEAD -> NEXT
    --------------------------------------------------------

    local humanoid = getHumanoid(currentTarget)

    if not humanoid or humanoid.Health <= 0 then
        selectNextTarget()
        return
    end

    --------------------------------------------------------
    -- TELEPORT ABOVE TORSO ONLY ONCE
    --------------------------------------------------------

    if not teleportedToCurrent then
        if teleportOnce(currentTarget) then
            teleportedToCurrent = true

            -- Refresh pad after arriving at target
            task.defer(function()
                local pad = getNil("KOStompPad", "Part")

                if pad then
                    targetStompPad = pad
                    hadStompPad = true
                end
            end)
        else
            selectNextTarget()
            return
        end
    end

    --------------------------------------------------------
    -- STOMP
    --------------------------------------------------------

    stompTimer += dt

    if stompTimer >= STOMP_INTERVAL then
        stompTimer = 0

        if currentTarget:GetAttribute("Stomped") ~= true then
            stomp()
        else
            selectNextTarget()
        end
    end
end)
