--// =====================================
--// NUMBER FORMATTER
--// =====================================

local function FormatNumber(Number)
    Number = tonumber(Number) or 0

    local Suffixes = {
        {1e18, "qi"},
        {1e15, "q"},
        {1e12, "t"},
        {1e9, "b"},
        {1e6, "m"},
        {1e3, "k"}
    }

    for _, Data in ipairs(Suffixes) do
        local Size = Data[1]
        local Suffix = Data[2]

        if math.abs(Number) >= Size then
            local Result = Number / Size

            if Result >= 100 then
                Result = string.format("%.0f", Result)
            elseif Result >= 10 then
                Result = string.format("%.1f", Result)
            else
                Result = string.format("%.2f", Result)
            end

            Result = Result:gsub("%.?0+$", "")

            return Result .. Suffix
        end
    end

    return tostring(math.floor(Number))
end

