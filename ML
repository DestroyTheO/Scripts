--// AUTO REP

local AutoRep = false
local AutoRepThread = nil

MainTab:Toggle({
    name = "Auto Rep",
    description = "Continuously performs reps",
    default = false,
    onText = "ACTIVE",
    offText = "OFF",

    callback = function(Value)
        AutoRep = Value

        if Value and not AutoRepThread then
            AutoRepThread = task.spawn(function()
                while AutoRep do
                    local MuscleEvent =
                        LocalPlayer:FindFirstChild("muscleEvent")

                    if MuscleEvent then
                        MuscleEvent:FireServer("rep")
                    end

                    task.wait()
                end

                AutoRepThread = nil
            end)
        end
    end
})

