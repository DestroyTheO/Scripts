--// AUTO MASS REBIRTH

local AutoMassRebirth = false
local AutoMassRebirthThread = nil

MainTab:Toggle({
    name = "Auto Mass Rebirth",
    description = "Continuously requests 500 rebirths",
    default = false,
    onText = "ACTIVE",
    offText = "OFF",

    callback = function(Value)
        AutoMassRebirth = Value

        if Value and not AutoMassRebirthThread then
            AutoMassRebirthThread = task.spawn(function()
                while AutoMassRebirth do
                    local REvents =
                        ReplicatedStorage:FindFirstChild("rEvents")

                    local RebirthRemote =
                        REvents and REvents:FindFirstChild("rebirthRemote")

                    if RebirthRemote then
                        pcall(function()
                            RebirthRemote:InvokeServer(
                                "massRebirthRequest",
                                500
                            )
                        end)
                    end

                    task.wait()
                end

                AutoMassRebirthThread = nil
            end)
        end
    end
})

