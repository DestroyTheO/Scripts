---------------------------------------------------------------------

local playerGui = LocalPlayer:WaitForChild("PlayerGui")

if Config.MainGuiName ~= "" and playerGui:FindFirstChild(Config.MainGuiName) then
    StartMainScript()
    return
end

CreateGUI()
