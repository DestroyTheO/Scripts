local function StartMainScript()
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")

    if Config.OldGuiName ~= "" and playerGui:FindFirstChild(Config.OldGuiName) then
        playerGui[Config.OldGuiName]:Destroy()
        task.wait(0.1)
    end

    _G[Config.Secret] = true

    print("[KeySystem] Loading main script...")
    print("[KeySystem] URL:", Config.MainScriptURL)

    local success, err = pcall(function()
        local source = game:HttpGet(Config.MainScriptURL)

        if not source or source == "" then
            error("Main script source was empty.")
        end

        print("[KeySystem] Main script downloaded. Size:", #source)

        local fn, compileErr = loadstring(source)
        if not fn then
            error("Compile error: " .. tostring(compileErr))
        end

        fn()
    end)

    if not success then
        warn("[KeySystem] Failed to load main script:", err)
    else
        print("[KeySystem] Main script loaded successfully.")
    end
end

