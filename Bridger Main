---------------------------------------------------------------------
-- Executor Helpers
---------------------------------------------------------------------

local requestFunc =
    request
    or http_request
    or syn_request
    or (fluxus and fluxus.request)
    or (http and http.request)

local setClipboard =
    setclipboard
    or toclipboard
    or function() end

local getHWID =
    gethwid
    or function()
        return RbxAnalyticsService:GetClientId()
    end

local function safeRequest(options)
    if not requestFunc then
        return nil, "HTTP requests are not supported by this executor."
    end

    local success, response = pcall(function()
        return requestFunc(options)
    end)

    if success and response then
        return response
    end

    return nil, "Connection error."
end

local function jsonEncode(data)
    return HttpService:JSONEncode(data)
end

local function jsonDecode(data)
    local success, result = pcall(function()
        return HttpService:JSONDecode(data)
    end)

    if success then
        return result
    end

    return nil
end

local function digest(text)
    text = tostring(text)

    if crypt and crypt.hash then
        local ok, result = pcall(function()
            return crypt.hash(text, "sha256")
        end)
        if ok and result then return result end
    end

    if syn and syn.crypt and syn.crypt.hash then
        local ok, result = pcall(function()
            return syn.crypt.hash(text, "sha256")
        end)
        if ok and result then return result end
    end

    if hash then
        local ok, result = pcall(function()
            return hash("sha256", text)
        end)
        if ok and result then return result end
    end

    warn("[KeySystem] No SHA256 hash function found.")
    return text
end

---------------------------------------------------------------------
-- PlatoBoost Core
---------------------------------------------------------------------

local useNonce = true
local cachedLink = ""
local cachedTime = 0
local host = "https://api.platoboost.com"

local function checkConnectivity()
    local response = safeRequest({
        Url = host .. "/public/connectivity",
        Method = "GET"
    })

    if not response or (response.StatusCode ~= 200 and response.StatusCode ~= 429) then
        host = "https://api.platoboost.net"
    end
end

checkConnectivity()

local function generateNonce()
    local chars = {}
    for _ = 1, 16 do
        chars[#chars + 1] = string.char(math.random(97, 122))
    end
    return table.concat(chars)
end

local function cacheLink()
    if cachedTime + 600 > os.time() and cachedLink ~= "" then
        return true, cachedLink
    end

    local response, err = safeRequest({
        Url = host .. "/public/start",
        Method = "POST",
        Body = jsonEncode({
            service = Config.ServiceId,
            identifier = digest(getHWID())
        }),
        Headers = {
            ["Content-Type"] = "application/json"
        }
    })

    if response and response.StatusCode == 200 then
        local decoded = jsonDecode(response.Body)
        if decoded and decoded.success and decoded.data and decoded.data.url then
            cachedLink = decoded.data.url
            cachedTime = os.time()
            return true, cachedLink
        end
        return false, decoded and decoded.message or "Failed to create key link."
    end

    return false, err or "Server unreachable."
end

local function redeemKey(key)
    local nonce = generateNonce()

    local body = {
        identifier = digest(getHWID()),
        key = key
    }

    if useNonce then
        body.nonce = nonce
    end

    local response, err = safeRequest({
        Url = host .. "/public/redeem/" .. tostring(Config.ServiceId),
        Method = "POST",
        Body = jsonEncode(body),
        Headers = {
            ["Content-Type"] = "application/json"
        }
    })

    if response and response.StatusCode == 200 then
        local decoded = jsonDecode(response.Body)

        if decoded and decoded.success and decoded.data and decoded.data.valid then
            if useNonce then
                local expectedHash = digest("true" .. "-" .. nonce .. "-" .. Config.PlatoSecret)
                if decoded.data.hash ~= expectedHash then
                    return false, "Integrity check failed."
                end
            end

            if writefile then
                pcall(function()
                    writefile(Config.KeyFileName, key)
                end)
            end

            return true, "Success."
        end

        return false, decoded and decoded.message or "Invalid key."
    end

    return false, err or "Server error."
end

