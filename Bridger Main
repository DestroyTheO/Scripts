            CloseGui()
        end
    end)

    -- ============================================================
    -- BUTTON LOGIC
    -- ============================================================
    ClearBtn.MouseButton1Click:Connect(function()
        InputBox.Text = ""
        SetStatus("input cleared.", Theme.TextDim)
    end)

    local busy = false

    VerifyBtn.MouseButton1Click:Connect(function()
        if busy then return end
        local key = InputBox.Text:gsub("^%s+", ""):gsub("%s+$", "")

        if key == "" then
            SetStatus("error: no key provided.", Theme.Warn)
            -- Shake input
            local origPos = InputWrap.Position
            for i = 1, 3 do
                Tween(InputWrap, 0.05, { Position = origPos + UDim2.fromOffset(-4, 0) })
                task.wait(0.05)
                Tween(InputWrap, 0.05, { Position = origPos + UDim2.fromOffset(4, 0) })
                task.wait(0.05)
            end
            Tween(InputWrap, 0.05, { Position = origPos })
            return
        end

        busy = true
        SetButtonText(VerifyBtn, "[ VERIFYING... ]")
        SetStatus("transmitting handshake to server...", Theme.Cyan)

        task.spawn(function()
            local success, msg = redeemKey(key)

            if success then
                SetButtonText(VerifyBtn, "[ ACCESS GRANTED ]")
                SetStatus("authenticated. loading payload...", Theme.Success)

                task.wait(0.6)
                CloseGui()
                task.wait(0.32)
                StartMainScript()
            else
                busy = false
                SetButtonText(VerifyBtn, "[ AUTHENTICATE ]")
                SetStatus("denied: " .. tostring(msg or "invalid key."), Theme.Error)

                local origPos = InputWrap.Position
                for i = 1, 3 do
                    Tween(InputWrap, 0.05, { Position = origPos + UDim2.fromOffset(-5, 0) })
                    task.wait(0.05)
                    Tween(InputWrap, 0.05, { Position = origPos + UDim2.fromOffset(5, 0) })
                    task.wait(0.05)
                end
                Tween(InputWrap, 0.05, { Position = origPos })
            end
        end)
    end)

    GetKeyBtn.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true
        SetButtonText(GetKeyBtn, "FETCHING...")
        SetStatus("requesting key link...", Theme.Cyan)

        task.spawn(function()
            local success, link = cacheLink()

            if success then
                setClipboard(link)
                SetStatus("link copied → " .. string.sub(link, 1, 38) .. "...", Theme.Success)
            else
                SetStatus("error: " .. tostring(link), Theme.Error)
            end

            task.wait(0.4)
            SetButtonText(GetKeyBtn, "GET KEY ↗")
            busy = false
        end)
    end)

    -- ============================================================
    -- AUTO-LOGIN WITH SAVED KEY
    -- ============================================================
    if isfile and readfile and isfile(Config.KeyFileName) then
        local savedKey = readfile(Config.KeyFileName)
        if savedKey and savedKey ~= "" then
            SetStatus("saved credential found. validating...", Theme.Cyan)

            task.spawn(function()
                local success = redeemKey(savedKey)
                if success then
                    SetStatus("auto-login success. loading...", Theme.Success)
                    task.wait(0.5)
                    CloseGui()
                    task.wait(0.32)
                    StartMainScript()
                else
                    SetStatus("saved credential expired.", Theme.Warn)
                end
            end)
        end
    end
end

