end

function Controller:BindChestESP()
	self:DisconnectChestESPConnections()

	local folder = self:GetChestFolder()
	if not folder then return end

	table.insert(self.ChestESPConnections, folder.ChildAdded:Connect(function(child)
		task.wait(0.05)
		if self.ChestESPEnabled then
			self:CreateTextESP(child, self.ChestESPObjects, "Chest")
		end
	end))

	table.insert(self.ChestESPConnections, folder.ChildRemoved:Connect(function(child)
		self:RemoveTextESP(child, self.ChestESPObjects)
	end))
end

function Controller:BindEntityESP()
	self:DisconnectEntityESPConnections()

	local folder = self:GetEntityFolder()
	if not folder then return end

	table.insert(self.EntityESPConnections, folder.ChildAdded:Connect(function(child)
		self.lastEntityCacheUpdate = 0
		task.wait(0.05)
		if self.EntityESPEnabled and not self:IsSelfObject(child) and not self:IsBlacklistedEntity(child) then
			self:CreateTextESP(child, self.EntityESPObjects, "Entity")
		end
	end))

	table.insert(self.EntityESPConnections, folder.ChildRemoved:Connect(function(child)
		self.lastEntityCacheUpdate = 0
		self:RemoveTextESP(child, self.EntityESPObjects)
	end))
end




function Controller:GetRootFallback()
	if self.RootPart and self.RootPart.Parent then
		return self.RootPart
	end

	if not self.Character then
		return nil
	end

	return self.Character:FindFirstChild("HumanoidRootPart")
		or self.Character:FindFirstChild("UpperTorso")
		or self.Character:FindFirstChild("Torso")
end

function Controller:ComputeLeftCFrameFrom(cf)
	local leftPosition = cf.Position - (cf.RightVector * self.PositionEnforcerMoveDistance)
	local rotationOnly = cf - cf.Position
	return CFrame.new(leftPosition) * rotationOnly
end

function Controller:TeleportToEnforcerCFrame(cf)
	if not cf then
		return
	end

	if self.Character and self.Character.Parent then
		pcall(function()
			self.Character:PivotTo(cf)
		end)
	end

	local root = self:GetRootFallback()
	if root then
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end)
	end
end

function Controller:PauseEffectsForPositionReturn()
	if self.PositionEnforcerPausedEffects then
		return
	end

	self.PositionEnforcerPausedEffects = {
		AutoFishingEnabled = self.AutoFishingEnabled,
		FlyEnabled = self.FlyEnabled,
		AutoTreeEnabled = self.AutoTreeEnabled,
		AutoTreeNoclipEnabled = self.AutoTreeNoclipEnabled,
	}

	if self.AutoFishingEnabled then
		pcall(function()
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)

		self.interactState.holding = false
		self.interactState.gui = nil
		self.cachedHoldEGui = nil
		self.usingBaitAfterCatch = false
		self.fishingState.recastQueued = false
		self.awaitingBobberAfterCast = false
		self.clickedRecently = false
		self.CastInProgress = false
		self.CastLockUntil = 0
		self:ResetFishingState()
		self.AutoFishingEnabled = false
		self:SetFishingVisualizerVisible(false)
		self:SetBobberDetectionBoxVisible(false)
	end

	if self.FlyEnabled then
		self.FlyEnabled = false
		self.FlyYLevel = nil
	end

	if self.AutoTreeEnabled then
		self.AutoTreeEnabled = false
		self.AutoTreeTarget = nil
		self.AutoTreeTargetBark = nil
		self.AutoTreeUsingFallback = false
		self.AutoTreeFallbackTargetCFrame = nil
		self.AutoTreeIsMoving = false
		self.AutoTreeArrivedAtTarget = 0
	end

	if self:IsAlive() then
		pcall(function()
			self.RootPart.AssemblyLinearVelocity = Vector3.zero
			self.RootPart.AssemblyAngularVelocity = Vector3.zero
		end)
	end

	self:SetStatus("Position return: paused effects")
	self:RefreshToggleButtons()
end

function Controller:RestoreEffectsAfterPositionReturn()
	local paused = self.PositionEnforcerPausedEffects
	if not paused then
		return
	end

	self.PositionEnforcerPausedEffects = nil

	if paused.AutoTreeEnabled then
		self.AutoTreeEnabled = true
		self:SetCharacterNoclip(true)
		self:PickAutoTreeTarget(true)
	else
		if paused.AutoTreeNoclipEnabled then
			self:SetCharacterNoclip(false)
		end
	end

	if paused.FlyEnabled then
		self.FlyEnabled = true
		if self:IsAlive() then
			self.FlyYLevel = self.RootPart.Position.Y
		end
	end

	if paused.AutoFishingEnabled then
		self.AutoFishingEnabled = true
		self.clickedRecently = false
		self.fishingState.recastQueued = false
		self.awaitingBobberAfterCast = false
		self.lastRecastTime = 0
		self.lastValidFishingAction = os.clock()

		task.defer(function()
			task.wait(0.25)
			if self.AutoFishingEnabled and self:IsAlive() then
				self:StartFishingCycle()
			end
		end)
	end

	self:SetStatus("Position return: restored effects")
	self:RefreshToggleButtons()
end

function Controller:StartPositionReturnTo(cf)
	if not cf then
		return
	end

	self.PositionEnforcerReturnTarget = cf
	self.PositionEnforcerReturning = true
	self:PauseEffectsForPositionReturn()
end

function Controller:MoveToEnforcerCFrame(cf, dt)
	if not cf or not self:IsAlive() then
		return false
	end

	local root = self:GetRootFallback()
	if not root then
		return false
	end

	local targetPosition = cf.Position
	local offset = targetPosition - root.Position
	local horizontal = Vector3.new(offset.X, 0, offset.Z)
	local vertical = offset.Y
	local distance = offset.Magnitude
	local horizontalDistance = horizontal.Magnitude

	if distance <= self.PositionEnforcerTweenStopDistance then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		local finalCFrame = CFrame.lookAt(targetPosition, targetPosition + cf.LookVector)

		if self.Character and self.Character.Parent then
			pcall(function()
				self.Character:PivotTo(finalCFrame)
			end)
		else
			root.CFrame = finalCFrame
		end

		self.PositionEnforcerReturning = false
		self.PositionEnforcerReturnTarget = nil
		self:RestoreEffectsAfterPositionReturn()
		return true
	end

	local dtSafe = math.max(dt or 0.016, 0.016)
	local horizontalStep = math.min(horizontalDistance, self.PositionEnforcerTweenSpeed * dtSafe)
	local verticalStep = math.clamp(vertical, -self.PositionEnforcerTweenVerticalSpeed * dtSafe, self.PositionEnforcerTweenVerticalSpeed * dtSafe)

	local move = Vector3.new(0, verticalStep, 0)

	if horizontalDistance > 0.01 then
		move += horizontal.Unit * horizontalStep
	end

	local nextPosition = root.Position + move
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.lookAt(nextPosition, nextPosition + cf.LookVector)

	self.PositionEnforcerReturning = true
	self.PositionEnforcerReturnTarget = cf
	return false
end

function Controller:ReturnToEnforcerCFrame(cf, dt)
	if not cf then
		return
	end

	if self.PositionEnforcerUseTween then
		self:MoveToEnforcerCFrame(cf, dt)
	else
		self:TeleportToEnforcerCFrame(cf)
	end
end

function Controller:GetCurrentEnforcerCFrame()
	return self.PositionEnforcerMovedToB and self.PositionEnforcerSavedB or self.PositionEnforcerSavedA
end

function Controller:GetEnforcerDistanceFromSaved(cf)
	local root = self:GetRootFallback()

	if not root or not cf then
		return math.huge
	end

	return (root.Position - cf.Position).Magnitude
end


