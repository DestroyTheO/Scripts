function Controller:GetBobberBoxYLevel()
	local root = self.RootPart
	if not root then
		return nil
	end

	return root.Position.Y - 1
end


function Controller:UpdateBobberDetectionBox()
	if not self.BobberDetectionBoxEnabled or not self.AutoFishingEnabled or not self:IsAlive() then
		self:SetBobberDetectionBoxVisible(false)
		return
	end

	local now = os.clock()
	if now - self.lastFishingVisualizerUpdate < self.FishingVisualizerUpdateRate then
		return
	end
	self.lastFishingVisualizerUpdate = now

	self:CreateBobberDetectionBox()

	local objects = self.BobberDetectionBoxObjects
	if not objects.Anchors then
		return
	end

	local root = self.RootPart
	local range = self.MAX_BOBBER_DISTANCE
	local yLevel = self:GetBobberBoxYLevel()

	if not yLevel then
		self:SetBobberDetectionBoxVisible(false)
		return
	end

	local center = root.Position
	local right = root.CFrame.RightVector
	local forward = root.CFrame.LookVector

	local corners = {
		center + (-right * range) + (-forward * range),
		center + (right * range) + (-forward * range),
		center + (right * range) + (forward * range),
		center + (-right * range) + (forward * range),
	}

	if not self.BobberDetectionBoxLastPositions then
		self.BobberDetectionBoxLastPositions = {}
	end

	for i, pos in ipairs(corners) do
		local targetPosition = Vector3.new(pos.X, yLevel, pos.Z)
		local finalPosition = targetPosition

		if self.BobberDetectionBoxSmooth and self.BobberDetectionBoxLastPositions[i] then
			finalPosition = self.BobberDetectionBoxLastPositions[i]:Lerp(targetPosition, self.BobberDetectionBoxSmoothAlpha)
		end

		self.BobberDetectionBoxLastPositions[i] = finalPosition
		objects.Anchors[i].CFrame = CFrame.new(finalPosition)
	end

	local color = self:HasNearbyCurrentBobber() and self.FishingVisualizerWaitingColor or self.BobberDetectionBoxColor

	if objects.Beams then
		for _, beam in ipairs(objects.Beams) do
			beam.Color = ColorSequence.new(color)
		end
	end

	self:SetBobberDetectionBoxVisible(true)
end


function Controller:GetFishingVisualizerColor()
	if not self.AutoFishingEnabled then
		return self.FishingVisualizerBlockedColor, "AUTO FISH OFF"
	end

	if self.awaitingBobberAfterCast then
		return self.FishingVisualizerWaitingColor, "WAITING BOBBER"
	end

	if self.fishingState.minigameActive then
		return self.FishingVisualizerWaitingColor, "MINIGAME ACTIVE"
	end

	if self.interactState.holding or self.interactState.gui then
		return self.FishingVisualizerWaitingColor, "INTERACTING"
	end

	if self.clickedRecently then
		return self.FishingVisualizerWaitingColor, "CASTING"
	end

	if self:HasNearbyCurrentBobber() then
		return self.FishingVisualizerWaitingColor, "BOBBER IN BOX"
	end

	if not self:IsCharacterStableForCast() then
		return self.FishingVisualizerBlockedColor, "NOT STABLE"
	end

	if not self:FindTool("FishingRod") then
		return self.FishingVisualizerBlockedColor, "ROD MISSING"
	end

	return self.FishingVisualizerSafeColor, "CAST LINE"
end

function Controller:UpdateFishingVisualizer()
	if not self.AutoFishingEnabled then
		self:SetFishingVisualizerVisible(false)
		self:SetBobberDetectionBoxVisible(false)
		return
	end

	self:UpdateBobberDetectionBox()
	self:SetFishingVisualizerVisible(false)
end


function Controller:CalculateFlyMoveVector(vec)
	local cam = Camera or workspace.CurrentCamera
	if not cam then
		return Vector3.zero
	end

	local _, _, _, r00, r01, r02, _, _, r12, _, _, r22 = cam.CFrame:GetComponents()
	local c, s

	if r12 < 1 and r12 > -1 then
		c = r22
		s = r02
	else
		c = r00
		s = -r01 * math.sign(r12)
	end

	local out = Vector3.new((c * vec.X + s * vec.Z), 0, (c * vec.Z - s * vec.X))
	local mag = math.sqrt(c * c + s * s)

	out = mag > 0 and out / mag or Vector3.zero
	return out.Magnitude > 0 and out.Unit or Vector3.zero
end

function Controller:GetDirectFlyInputVector()
	local x = 0
	local z = 0

	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		z -= 1
	end

	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		z += 1
	end

	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		x -= 1
	end

	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		x += 1
	end

	return self:CalculateFlyMoveVector(Vector3.new(x, 0, z))
end

function Controller:SetFlyEnabled(state)
	self.FlyEnabled = state and true or false

	if not self.FlyEnabled then
		self.FlyYLevel = nil

		if self:IsAlive() then
			pcall(function()
				self.RootPart.AssemblyLinearVelocity = Vector3.zero
				self.RootPart.AssemblyAngularVelocity = Vector3.zero
			end)
		end

		self:SetStatus("Fly OFF")
		self:Notify("Fly OFF")
	else
		if self:IsAlive() then
			self.FlyYLevel = self.RootPart.Position.Y
		end

		self:SetStatus("Fly ON")
		self:Notify("Fly ON")
	end
end

function Controller:ToggleFly()
	self:SetFlyEnabled(not self.FlyEnabled)
end

function Controller:UpdateFly(dt)
	if not self.FlyEnabled then
		self.FlyYLevel = nil
		return
	end

	if not self:IsAlive() then
		self.FlyYLevel = nil
		return
	end

	local root = self.RootPart
	local hum = self.Humanoid

	if not root or not hum then
		return
	end

	local moveDir

	if self.FlyMoveMode == "Direct" then
		moveDir = self:GetDirectFlyInputVector()
	else
		moveDir = hum.MoveDirection
	end

	if self.FlyMode == "Velocity" then
		root.AssemblyLinearVelocity =
			(moveDir * self.FlySpeed) +
			Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)

	elseif self.FlyMode == "Impulse" then
		local desired = moveDir * self.FlySpeed
		local diff = (desired - root.AssemblyLinearVelocity) * Vector3.new(1, 0, 1)

		if diff.Magnitude > 2 then
			root:ApplyImpulse(diff * root.AssemblyMass)
		end

	elseif self.FlyMode == "CFrame" then
		root.CFrame += moveDir * self.FlySpeed * dt

	elseif self.FlyMode == "Pulse" then
		local t = tick() % (self.FlyPulseLength + self.FlyPulseDelay)

		if t < self.FlyPulseLength then
			root.AssemblyLinearVelocity =
				(moveDir * self.FlySpeed) +
				Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
		end

	elseif self.FlyMode == "TP" then
		if tick() - self.FlyLastTP >= self.FlyTPFrequency then
			self.FlyLastTP = tick()
			root.CFrame += moveDir * self.FlySpeed * 0.05
		end
	end

	if not self.FlyYLevel then
		self.FlyYLevel = root.Position.Y
	end

	local verticalInput = 0

	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		verticalInput += 1
	end

	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
		verticalInput -= 1
	end

	self.FlyYLevel += verticalInput * self.FlyVertical * dt

	if self.FlyWallCheck then
		self.FlyRayParams.FilterDescendantsInstances = { self.Character, Camera }

		local verticalDelta = self.FlyYLevel - root.Position.Y
		if math.abs(verticalDelta) > 0.001 then
			local ray = workspace:Raycast(root.Position, Vector3.new(0, verticalDelta, 0), self.FlyRayParams)

			if ray then
				self.FlyYLevel = ray.Position.Y + hum.HipHeight
			end
		end
	end

	root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
	root.CFrame += Vector3.new(0, self.FlyYLevel - root.Position.Y, 0)

	pcall(function()
		hum:ChangeState(Enum.HumanoidStateType.Running)
	end)
end



function Controller:GetForestTreesFolder()
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end

	return map:FindFirstChild("ForestTrees")
end

function Controller:GetTreeBark(tree)
	if not tree then
		return nil
	end

	if tree:IsA("BasePart") and tree.Name == "TreeBark" then
		return tree
	end

	local direct = tree:FindFirstChild("TreeBark")
	if direct and direct:IsA("BasePart") then
		return direct
	end

	local deep = tree:FindFirstChild("TreeBark", true)
	if deep and deep:IsA("BasePart") then
		return deep
	end

	return nil
end

function Controller:IsValidTree(tree)
	if not tree or not tree.Parent then
		return false
	end

	local bark = self:GetTreeBark(tree)

	if not bark or not bark.Parent or not bark:IsDescendantOf(workspace) then
		return false
	end

	if bark:IsA("BasePart") and bark.Transparency >= 1 then
		return false
	end

	return true
end

function Controller:GetNearestFallbackTreeCFrame()
	if not self:IsAlive() or not self.AutoTreeFallbackCFrames or #self.AutoTreeFallbackCFrames == 0 then
		return nil, math.huge, nil
	end

	local bestIndex = nil
	local bestCFrame = nil
	local bestDistance = math.huge
	local rootPosition = self.RootPart.Position

	for index, cf in ipairs(self.AutoTreeFallbackCFrames) do
		local distance = (cf.Position - rootPosition).Magnitude

		if distance < bestDistance then
			bestDistance = distance
			bestCFrame = cf
			bestIndex = index
		end
	end

	return bestCFrame, bestDistance, bestIndex
end

function Controller:FindTreeNearCFrame(cf)
	if not cf then
		return nil, nil, math.huge
	end

	local folder = self:GetForestTreesFolder()
	if not folder then
		return nil, nil, math.huge
	end

	local bestTree = nil
	local bestBark = nil
	local bestDistance = math.huge

	for _, tree in ipairs(folder:GetChildren()) do
		local bark = self:GetTreeBark(tree)

		if bark and bark.Parent and bark:IsDescendantOf(workspace) and bark.Transparency < 1 then
			local distance = (bark.Position - cf.Position).Magnitude

			if distance < bestDistance then
				bestDistance = distance
				bestTree = tree
				bestBark = bark
			end
		end
	end

	if bestDistance <= self.AutoTreeFallbackLinkDistance then
		return bestTree, bestBark, bestDistance
	end

	return nil, nil, bestDistance
end

function Controller:FindSpawnedTreeCFrameFromCurrent()
	if not self.AutoTreeFallbackCFrames or #self.AutoTreeFallbackCFrames == 0 then
		return nil
	end

	if os.clock() - self.AutoTreeLastCFrameSpawnCheck < self.AutoTreeCFrameSpawnCheckRate then
		return self:GetCurrentFallbackTreeCFrame()
	end

	self.AutoTreeLastCFrameSpawnCheck = os.clock()

	local count = #self.AutoTreeFallbackCFrames
	local tries = 0

	while tries < count do
		local cf = self:GetCurrentFallbackTreeCFrame()
		local tree, bark = self:FindTreeNearCFrame(cf)

		if tree and bark then
			self.AutoTreeFallbackLinkedTree = tree
			self.AutoTreeFallbackLinkedBark = bark
			return cf
		end

		self:AdvanceFallbackTreeCFrame()
		tries += 1
	end

	self.AutoTreeFallbackLinkedTree = nil
	self.AutoTreeFallbackLinkedBark = nil
	return self:GetCurrentFallbackTreeCFrame()
end

function Controller:BindFallbackTreeToCurrentCFrame()
	local cf = self:GetCurrentFallbackTreeCFrame()

	self.AutoTreeFallbackLinkedTree = nil
	self.AutoTreeFallbackLinkedBark = nil

	if not cf then
		return
	end

	local tree, bark = self:FindTreeNearCFrame(cf)

	self.AutoTreeFallbackLinkedTree = tree
	self.AutoTreeFallbackLinkedBark = bark
end

function Controller:IsFallbackLinkedTreeAlive()
	if not self.AutoTreeFallbackLinkedTree or not self.AutoTreeFallbackLinkedBark then
		return false
	end

	if not self.AutoTreeFallbackLinkedTree.Parent then
		return false
	end

	local bark = self.AutoTreeFallbackLinkedBark

	if not bark.Parent or not bark:IsDescendantOf(workspace) then
		return false
	end

	if bark:IsA("BasePart") and bark.Transparency >= 1 then
		return false
	end

	return true
end

function Controller:GetCurrentFallbackTreeCFrame()
	if not self.AutoTreeFallbackCFrames or #self.AutoTreeFallbackCFrames == 0 then
		return nil
	end

	if self.AutoTreeFallbackIndex > #self.AutoTreeFallbackCFrames then
		self.AutoTreeFallbackIndex = 1
	end

	return self.AutoTreeFallbackCFrames[self.AutoTreeFallbackIndex]
end

function Controller:AdvanceFallbackTreeCFrame()
	if not self.AutoTreeFallbackCFrames or #self.AutoTreeFallbackCFrames == 0 then
		return
	end

	local count = #self.AutoTreeFallbackCFrames

	if count <= 1 then
		self.AutoTreeFallbackIndex = 1
		self.AutoTreeFallbackDirection = 1
		return
	end

	self.AutoTreeFallbackIndex += self.AutoTreeFallbackDirection

	if self.AutoTreeFallbackIndex >= count then
		self.AutoTreeFallbackIndex = count
		self.AutoTreeFallbackDirection = -1
	elseif self.AutoTreeFallbackIndex <= 1 then
		self.AutoTreeFallbackIndex = 1
		self.AutoTreeFallbackDirection = 1
	end
end

function Controller:GetNearestTree()
	if not self:IsAlive() then
		return nil, nil, math.huge
	end

	local folder = self:GetForestTreesFolder()
	if not folder then
		return nil, nil, math.huge
	end

	local bestTree = nil
	local bestBark = nil
	local bestScore = math.huge
	local bestDistance = math.huge
	local rootPosition = self.RootPart.Position

	for _, tree in ipairs(folder:GetChildren()) do
		local bark = self:GetTreeBark(tree)

		if bark and bark.Parent and bark:IsDescendantOf(workspace) and bark.Transparency < 1 then
			local offset = bark.Position - rootPosition
			local distance = offset.Magnitude
			local verticalPenalty = math.abs(offset.Y) * 0.35
			local score = distance + verticalPenalty

			if score < bestScore then
				bestScore = score
				bestDistance = distance
				bestTree = tree
				bestBark = bark
			end
		end
	end

	return bestTree, bestBark, bestDistance
end

function Controller:SetCharacterNoclip(state)
	self.AutoTreeNoclipEnabled = state and true or false

	if not self.Character then
		return
	end

	for _, obj in ipairs(self.Character:GetDescendants()) do
		if obj:IsA("BasePart") then
			if self.AutoTreeNoclipEnabled then
				if self.AutoTreeNoClipOriginal[obj] == nil then
					self.AutoTreeNoClipOriginal[obj] = {
						CanCollide = obj.CanCollide,
						CanTouch = obj.CanTouch,
						CanQuery = obj.CanQuery,
					}
				end

				obj.CanCollide = false
				obj.CanTouch = false
				obj.CanQuery = false
			else
				local old = self.AutoTreeNoClipOriginal[obj]

				if old then
					obj.CanCollide = old.CanCollide
					obj.CanTouch = old.CanTouch
					obj.CanQuery = old.CanQuery
				else
					obj.CanCollide = true
					obj.CanTouch = true
					obj.CanQuery = true
				end
			end
		end
	end

	if not self.AutoTreeNoclipEnabled then
		table.clear(self.AutoTreeNoClipOriginal)
	end
end

function Controller:MaintainAutoTreeNoclip()
	if not self.AutoTreeEnabled then
		return
	end

	if os.clock() - self.AutoTreeLastNoclip < self.AutoTreeNoclipRate then
		return
	end

	self.AutoTreeLastNoclip = os.clock()
	self:SetCharacterNoclip(true)
end

function Controller:MaintainAutoTreeAntiPhysics()
	if not self.AutoTreeEnabled then
		return
	end

	if os.clock() - self.AutoTreeLastAntiPhysics < self.AutoTreeAntiPhysicsRate then
		return
	end

	self.AutoTreeLastAntiPhysics = os.clock()

	if not self:IsAlive() then
		return
	end

	local root = self.RootPart
	local hum = self.Humanoid

	if not root or not hum then
		return
	end

	if self.AutoTreeAntiKnockback then
		local velocity = root.AssemblyLinearVelocity
		local horizontal = Vector3.new(velocity.X, 0, velocity.Z)

		if horizontal.Magnitude > self.AutoTreeMaxVelocity or math.abs(velocity.Y) > self.AutoTreeMaxVelocity then
			root.AssemblyLinearVelocity = Vector3.zero
		end

		if root.AssemblyAngularVelocity.Magnitude > self.AutoTreeMaxAngularVelocity then
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	if self.AutoTreeAntiFly then
		pcall(function()
			hum.PlatformStand = false
			hum.Sit = false
			hum.AutoRotate = true
		end)

		local state = hum:GetState()

		if state == Enum.HumanoidStateType.Ragdoll
			or state == Enum.HumanoidStateType.FallingDown
			or state == Enum.HumanoidStateType.Physics
			or state == Enum.HumanoidStateType.PlatformStanding
			or state == Enum.HumanoidStateType.Seated then
			pcall(function()
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)

			task.defer(function()
				if self.AutoTreeEnabled and self:IsAlive() then
					pcall(function()
						self.Humanoid:ChangeState(Enum.HumanoidStateType.Running)
					end)
				end
			end)
		end
	end
end

function Controller:ClearAutoTreeTarget(reason)
	self.AutoTreeTarget = nil
	self.AutoTreeTargetBark = nil
	self.AutoTreeUsingFallback = false
	self.AutoTreeFallbackTargetCFrame = nil
	self.AutoTreeIsMoving = false
	self.AutoTreeArrivedAtTarget = 0
	self.AutoTreeLastScan = 0
	self.AutoTreeLastTargetRefresh = 0
	self.AutoTreeLastBrokenAt = os.clock()

	if reason and os.clock() - self.AutoTreeLastStatus >= self.AutoTreeStatusRate then
		self.AutoTreeLastStatus = os.clock()
		self:SetStatus(reason)
	end
end

function Controller:GetWoodQuantity()
	local backpack = self.Backpack or self.Player:FindFirstChild("Backpack")
	if not backpack then
		return 0
	end

	local wood = backpack:FindFirstChild("Wood")
	if not wood then
		return 0
	end

	local quantity = wood:FindFirstChild("Quantity")
	if quantity and quantity:IsA("ValueBase") then
		return tonumber(quantity.Value) or 0
	end

	return 0
end

function Controller:BindWoodQuantityWatcher()
	if self.WoodQuantityConnection then
		self.WoodQuantityConnection:Disconnect()
		self.WoodQuantityConnection = nil
	end

	local backpack = self.Backpack or self.Player:FindFirstChild("Backpack")
	if not backpack then
		return
	end

	local function hookWood(wood)
		if not wood or wood.Name ~= "Wood" then
			return
		end

		local quantity = wood:FindFirstChild("Quantity")

		if not quantity or not quantity:IsA("ValueBase") then
			return
		end

		if self.WoodQuantityConnection then
			self.WoodQuantityConnection:Disconnect()
			self.WoodQuantityConnection = nil
		end

		self.WoodQuantityConnection = quantity:GetPropertyChangedSignal("Value"):Connect(function()
			if self.AutoSellWoodEnabled and self.AutoSellWoodInstant and (tonumber(quantity.Value) or 0) >= self.AutoSellWoodMinimum then
				self:AutoTreeSellWood(true)
			end
		end)

		if self.AutoSellWoodEnabled and self.AutoSellWoodInstant and (tonumber(quantity.Value) or 0) >= self.AutoSellWoodMinimum then
			self:AutoTreeSellWood(true)
		end
	end

	local existingWood = backpack:FindFirstChild("Wood")
	if existingWood then
		hookWood(existingWood)
	end

	table.insert(self.BackpackConnections, backpack.ChildAdded:Connect(function(child)
		if child.Name == "Wood" then
			task.wait(0.05)
			hookWood(child)
		end
	end))
end

function Controller:AutoTreeSellWood(force)
	if not self.AutoSellWoodEnabled then
		return
	end

	local woodAmount = self:GetWoodQuantity()

	if self.AutoSellWoodInstant and woodAmount < self.AutoSellWoodMinimum then
		return
	end

	if not force and os.clock() - self.AutoTreeLastSell < self.AutoTreeSellRate then
		return
	end

	if force and os.clock() - self.AutoTreeLastSell < self.AutoTreeSellRate then
		return
	end

	self.AutoTreeLastSell = os.clock()

	local replicatedStorage = game:GetService("ReplicatedStorage")
	local remotes = replicatedStorage:FindFirstChild("Remotes")
	local dialogueRemote = remotes and remotes:FindFirstChild("DialogueRemote")

	local npcFolder = workspace:FindFirstChild("NPC")
	local chuck = npcFolder and npcFolder:FindFirstChild("ChuckB")

	if not dialogueRemote or not chuck then
		return
	end

	pcall(function()
		dialogueRemote:FireServer("Action", "SellAll_Wood", chuck)
	end)

	self:SetStatus("Sold wood [" .. tostring(woodAmount) .. "]")
end

function Controller:AutoTreeUseAxe()
	if self.AutoTreeIsMoving then
		return
	end

	if self.AutoTreeArrivedAtTarget <= 0 then
		return
	end

	if os.clock() - self.AutoTreeArrivedAtTarget < self.AutoTreeArriveSettleTime then
		return
	end

	if os.clock() - self.AutoTreeLastSwing < self.AutoTreeSwingRate then
		return
	end

	self.AutoTreeLastSwing = os.clock()

	self:EquipTool(self.AutoTreeToolName)

	local replicatedStorage = game:GetService("ReplicatedStorage")
	local remotes = replicatedStorage:FindFirstChild("Remotes")
	local useTool = remotes and remotes:FindFirstChild("UseTool")

	if not useTool then
		self:SetStatus("UseTool remote missing")
		return
	end

	task.spawn(function()
		pcall(function()
			useTool:FireServer(self.AutoTreeToolName, "Swing")
		end)

		task.wait(self.AutoTreeReleaseDelay)

		pcall(function()
			useTool:FireServer(self.AutoTreeToolName, "Release")
		end)
	end)
end

function Controller:MoveToAutoTreeTarget(dt)
	if not self:IsAlive() or not self.AutoTreeTargetBark then
		return false
	end

	local bark = self.AutoTreeTargetBark

	if not bark.Parent or not bark:IsDescendantOf(workspace) or bark.Transparency >= 1 then
		self:ClearAutoTreeTarget("Tree broke, finding next")
		return false
	end

	local root = self.RootPart
	local targetPosition = bark.Position + self.AutoTreeTargetOffset
	local offset = targetPosition - root.Position
	local horizontal = Vector3.new(offset.X, 0, offset.Z)
	local vertical = offset.Y
	local distance = offset.Magnitude
	local horizontalDistance = horizontal.Magnitude

	if distance <= self.AutoTreeStopDistance or horizontalDistance <= self.AutoTreeStopDistance then
		if self.AutoTreeIsMoving or self.AutoTreeArrivedAtTarget <= 0 then
			self.AutoTreeArrivedAtTarget = os.clock()
		end

		self.AutoTreeIsMoving = false

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		local holdPosition = targetPosition
		local lookAt = Vector3.new(bark.Position.X, holdPosition.Y, bark.Position.Z) + bark.CFrame.LookVector

		if (lookAt - holdPosition).Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(holdPosition, lookAt)
		else
			root.CFrame = CFrame.new(holdPosition)
		end

		return true
	end

	self.AutoTreeIsMoving = true
	self.AutoTreeArrivedAtTarget = 0

	self.AutoTreeIsMoving = true
	self.AutoTreeArrivedAtTarget = 0

	local dtSafe = math.max(dt or 0.016, 0.016)
	local horizontalStep = math.min(horizontalDistance, self.AutoTreeMoveSpeed * dtSafe)
	local verticalStep = math.clamp(vertical, -self.AutoTreeVerticalSpeed * dtSafe, self.AutoTreeVerticalSpeed * dtSafe)

	local move = Vector3.new(0, verticalStep, 0)

	if horizontalDistance > 0.01 then
		move += horizontal.Unit * horizontalStep
	end

	local nextPosition = root.Position + move
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.lookAt(nextPosition, Vector3.new(bark.Position.X, nextPosition.Y, bark.Position.Z))

	return false
end

function Controller:MoveToFallbackTreePoint(dt)
	if not self:IsAlive() or not self.AutoTreeFallbackTargetCFrame then
		return false
	end

	local root = self.RootPart
	local targetPosition = self.AutoTreeFallbackTargetCFrame.Position + self.AutoTreeTargetOffset
	local offset = targetPosition - root.Position
	local horizontal = Vector3.new(offset.X, 0, offset.Z)
	local vertical = offset.Y
	local distance = offset.Magnitude
	local horizontalDistance = horizontal.Magnitude

	if distance <= self.AutoTreeFallbackReachDistance or horizontalDistance <= self.AutoTreeFallbackReachDistance then
		if self.AutoTreeIsMoving or self.AutoTreeArrivedAtTarget <= 0 then
			self.AutoTreeArrivedAtTarget = os.clock()
		end

		self.AutoTreeIsMoving = false

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		local holdPosition = targetPosition
		root.CFrame = CFrame.lookAt(holdPosition, holdPosition + self.AutoTreeFallbackTargetCFrame.LookVector)

		return true
	end

	local dtSafe = math.max(dt or 0.016, 0.016)
	local horizontalStep = math.min(horizontalDistance, self.AutoTreeMoveSpeed * dtSafe)
	local verticalStep = math.clamp(vertical, -self.AutoTreeVerticalSpeed * dtSafe, self.AutoTreeVerticalSpeed * dtSafe)

	local move = Vector3.new(0, verticalStep, 0)

	if horizontalDistance > 0.01 then
		move += horizontal.Unit * horizontalStep
	end

	local nextPosition = root.Position + move
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = CFrame.lookAt(nextPosition, Vector3.new(targetPosition.X, nextPosition.Y, targetPosition.Z))

	return false
end

function Controller:PickAutoTreeTarget(force)
	if self.AutoTreeCFrameOnly then
		local cf

		self.AutoTreeTarget = nil
		self.AutoTreeTargetBark = nil

		if self.AutoTreeCheckCFrameSpawn then
			cf = self:FindSpawnedTreeCFrameFromCurrent()
		else
			cf = self:GetCurrentFallbackTreeCFrame()
		end

		if cf then
			self.AutoTreeUsingFallback = true
			self.AutoTreeFallbackTargetCFrame = cf

			if not self.AutoTreeFallbackLinkedTree or not self.AutoTreeFallbackLinkedBark then
				self:BindFallbackTreeToCurrentCFrame()
			end

			if os.clock() - self.AutoTreeLastStatus >= self.AutoTreeStatusRate then
				self.AutoTreeLastStatus = os.clock()

				if self:IsFallbackLinkedTreeAlive() then
					self:SetStatus("Tree point " .. tostring(self.AutoTreeFallbackIndex) .. " spawned")
				else
					self:SetStatus("Checking tree CFrames for spawns")
				end
			end
		else
			self.AutoTreeUsingFallback = false
			self.AutoTreeFallbackTargetCFrame = nil
			self.AutoTreeFallbackLinkedTree = nil
			self.AutoTreeFallbackLinkedBark = nil

			if os.clock() - self.AutoTreeLastStatus >= self.AutoTreeStatusRate then
				self.AutoTreeLastStatus = os.clock()
				self:SetStatus("No tree CFrames found")
			end
		end

		return
	end

	if self.AutoTreeTarget and not self:IsValidTree(self.AutoTreeTarget) then
		self:ClearAutoTreeTarget("Tree broke, finding next")
	end

	if not force and self.AutoTreeTarget and self:IsValidTree(self.AutoTreeTarget) and self.AutoTreeTargetBark and self.AutoTreeTargetBark.Parent then
		return
	end

	if not force and os.clock() - self.AutoTreeLastScan < self.AutoTreeScanRate then
		return
	end

	self.AutoTreeLastScan = os.clock()

	local tree, bark, distance = self:GetNearestTree()
	self.AutoTreeTarget = tree
	self.AutoTreeTargetBark = bark

	if tree and bark then
		self.AutoTreeUsingFallback = false

		if os.clock() - self.AutoTreeLastStatus >= self.AutoTreeStatusRate then
			self.AutoTreeLastStatus = os.clock()
			self:SetStatus("Tree target: " .. tostring(tree.Name) .. " [" .. tostring(math.floor(distance + 0.5)) .. " studs]")
		end
	else
		if self.AutoTreeUseFallbackCFrames then
			local cf = self:GetCurrentFallbackTreeCFrame()

			if cf then
				self.AutoTreeUsingFallback = true
				self.AutoTreeFallbackTargetCFrame = cf

				if os.clock() - self.AutoTreeLastStatus >= self.AutoTreeStatusRate then
					self.AutoTreeLastStatus = os.clock()
					self:SetStatus("Tree fallback point: " .. tostring(self.AutoTreeFallbackIndex) .. "/" .. tostring(#self.AutoTreeFallbackCFrames))
				end

				return
			end
		end

		if os.clock() - self.AutoTreeLastStatus >= self.AutoTreeStatusRate then
			self.AutoTreeLastStatus = os.clock()
			self:SetStatus("No trees found")
		end
	end
end

