function Controller:PushLog(text)
	text = tostring(text or "")
	if text == "" then return end

	local now = os.clock()
	if self.lastLoggedStatus == text and now - self.lastLoggedAt < 0.8 then
		return
	end

	self.lastLoggedStatus = text
	self.lastLoggedAt = now

	local stamp = os.date("%H:%M:%S")
	table.insert(self.ActionLog, 1, "[" .. stamp .. "] " .. text)

	while #self.ActionLog > self.MAX_ACTION_LOG do
		table.remove(self.ActionLog)
	end
end

function Controller:SetStatus(text)
	self.status.lastAction = text
	self:PushLog(text)
end

function Controller:GetActionLogText()
	if #self.ActionLog == 0 then
		return "No actions yet"
	end

	return table.concat(self.ActionLog, "\n")
end

function Controller:Notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Fishing Controller",
			Text = text,
			Duration = 3
		})
	end)
end

function Controller:DisconnectAll()
	for _, connection in ipairs(self.Connections) do
		if connection then connection:Disconnect() end
	end
	table.clear(self.Connections)

	if self.PositionEnforcerDragConnection then
		self.PositionEnforcerDragConnection:Disconnect()
		self.PositionEnforcerDragConnection = nil
	end
end

function Controller:DisconnectBackpackConnections()
	for _, connection in ipairs(self.BackpackConnections) do
