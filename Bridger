function Controller:IsAlive()
	return self.Character
		and self.Character.Parent
		and self.Humanoid
		and self.Humanoid.Parent
		and self.RootPart
		and self.RootPart.Parent
		and self.Humanoid.Health > 0
end

function Controller:CacheCharacter()
	self.Character = self.Player.Character or self.Player.CharacterAdded:Wait()
	self.Humanoid = self.Character:WaitForChild("Humanoid")
	self.RootPart = self.Character:WaitForChild("HumanoidRootPart")
	self.SafeCFrame = self.RootPart.CFrame
	self.LastGrounded = tick()
end

function Controller:CacheBackpack()
	self.Backpack = self.Player:WaitForChild("Backpack")
end

function Controller:SetBadStatesDisabled()
	if not self.Humanoid then return end

	for state in pairs(self.BlockedStates) do
		pcall(function()
			self.Humanoid:SetStateEnabled(state, false)
		end)
	end
end

function Controller:RemoveForces(forceFullSweep)
	if not self.Character then return end

	local now = os.clock()
	if not forceFullSweep and now - self.lastForceSweep < self.forceSweepInterval then
		return
	end

	self.lastForceSweep = now

	for _, obj in ipairs(self.Character:GetDescendants()) do
		if self.ForceRemovers[obj.ClassName] then
			pcall(function() obj:Destroy() end)
		elseif obj:IsA("BallSocketConstraint") or obj:IsA("HingeConstraint") then
			pcall(function() obj.Enabled = false end)
		end
	end
end

function Controller:ForceStand()
	if not self:IsAlive() then return end

	local hum = self.Humanoid
	local root = self.RootPart

	if hum.PlatformStand then hum.PlatformStand = false end
	if hum.Sit then hum.Sit = false end

	pcall(function()
		hum.AutoRotate = true
	end)

	local state = hum:GetState()
	if self.BlockedStates[state] then
		pcall(function()
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)

		task.defer(function()
			if self:IsAlive() then
				pcall(function()
					hum:ChangeState(Enum.HumanoidStateType.Running)
				end)
			end
		end)
	end

	local pos = root.Position
	root.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(root.Orientation.Y), 0)
end

function Controller:IsGrounded()
	if not self:IsAlive() then return false end

	local hum = self.Humanoid
	local state = hum:GetState()

	if state == Enum.HumanoidStateType.Running
		or state == Enum.HumanoidStateType.RunningNoPhysics
		or state == Enum.HumanoidStateType.Landed
		or state == Enum.HumanoidStateType.Climbing then
		return true
	end

	return hum.FloorMaterial ~= Enum.Material.Air
end

function Controller:UpdateSafePosition()
	if not self:IsAlive() then return end

	if self:IsGrounded() then
		self.LastGrounded = tick()
		self.SafeCFrame = self.RootPart.CFrame
	end
end

function Controller:ClampMovement()
	if not self:IsAlive() then return end

	local root = self.RootPart
	local vel = root.AssemblyLinearVelocity
	local ang = root.AssemblyAngularVelocity

	local horizontal = Vector3.new(vel.X, 0, vel.Z)
	local y = vel.Y

	if horizontal.Magnitude > self.MaxHorizontalVelocity then
		horizontal = horizontal.Unit * self.MaxHorizontalVelocity
	end

	if y > self.MaxUpVelocity then
		y = self.MaxUpVelocity
	elseif y < -self.MaxDownVelocity then
		y = -self.MaxDownVelocity
	end

	root.AssemblyLinearVelocity = Vector3.new(horizontal.X, y, horizontal.Z)

	if ang.Magnitude > self.MaxAngularVelocity then
		root.AssemblyAngularVelocity = Vector3.zero
	end
end

function Controller:HardAntiKnockback()
	if not self:IsAlive() then return end

	local root = self.RootPart
	local vel = root.AssemblyLinearVelocity
	local horizontal = Vector3.new(vel.X, 0, vel.Z)

	if horizontal.Magnitude > self.MaxHorizontalVelocity * 0.9 then
		root.AssemblyLinearVelocity = Vector3.new(0, math.clamp(vel.Y, -18, 18), 0)
		root.AssemblyAngularVelocity = Vector3.zero
		self:SetStatus("Anti knockback correcting")
	end
end

function Controller:AntiFall()
	if not self:IsAlive() then return end

	local root = self.RootPart
	local vel = root.AssemblyLinearVelocity

	if vel.Y < -self.MaxDownVelocity then
		root.AssemblyLinearVelocity = Vector3.new(vel.X * 0.2, -2, vel.Z * 0.2)
	end

	local airborneFor = tick() - self.LastGrounded
	if airborneFor > self.GroundMemory and root.Position.Y <= self.ReturnFallY then
		if self.SafeCFrame then
			root.CFrame = self.SafeCFrame + Vector3.new(0, self.SafeHeightOffset, 0)
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero

			pcall(function()
				self.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end)

			self:SetStatus("Anti fall recovery")
		end
	end
end

function Controller:BlockBadDescendants(desc)
	if self.ForceRemovers[desc.ClassName] then
		pcall(function() desc:Destroy() end)
		return
	end

	if desc:IsA("BallSocketConstraint") or desc:IsA("HingeConstraint") then
		pcall(function() desc.Enabled = false end)
	end
end

function Controller:ResetFishingState()
	self.fishingState.currentBobber = nil
	self.fishingState.biteTriggered = false
	self.fishingState.minigameSeen = false
	self.fishingState.minigameActive = false
	self.fishingState.waitingForCatchFinish = false
	self.fishingState.recastQueued = false
end

function Controller:GetScreenCenter()
	local vp = Camera.ViewportSize
	return vp.X * 0.5, vp.Y * 0.5
end

function Controller:IsBobberPart(part)
	if not part or not part:IsA("BasePart") then return false end
	if not part:IsDescendantOf(workspace) then return false end
	if part.BrickColor ~= self.BOBBER_BRICK_COLOR then return false end

	return part:FindFirstChild("Beam") ~= nil or part:FindFirstChild("Trail") ~= nil
end

function Controller:IsBobberNearMe(part)
	if not self:IsBobberPart(part) then return false end
	if not self.RootPart then return false end

	local offset = part.Position - self.RootPart.Position
	local distance = offset.Magnitude

	if distance > self.MAX_BOBBER_DISTANCE then return false end
	if distance <= 0.001 then return true end

	local direction = offset.Unit
	local look = self.RootPart.CFrame.LookVector
	local dot = look:Dot(direction)

	return dot >= self.BOBBER_FRONT_DOT_MIN
end

function Controller:GetNearbyPartsInBox()
	if not self.RootPart then return {} end

	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { self.Character }

	return workspace:GetPartBoundsInBox(self.RootPart.CFrame, self.BOBBER_BOX_SIZE, overlap)
end

function Controller:GetBobberScore(part)
	if not self.RootPart then return math.huge end

	local offset = part.Position - self.RootPart.Position
	local distance = offset.Magnitude

	if distance <= 0.001 then return 0 end

	local direction = offset.Unit
	local look = self.RootPart.CFrame.LookVector
	local dot = look:Dot(direction)

	return distance - (dot * 5)
end

function Controller:FindNearestNearbyBobber()
	if not self:IsAlive() or not self.RootPart then return nil end

	local bestPart = nil
	local bestScore = math.huge

	for _, obj in ipairs(self:GetNearbyPartsInBox()) do
		if obj:IsA("BasePart") and self:IsBobberNearMe(obj) then
			local score = self:GetBobberScore(obj)

			if score < bestScore then
				bestScore = score
				bestPart = obj
			end
		end
	end

	return bestPart
end

function Controller:OnCastAttempt()
	self.lastCastAttemptTime = os.clock()
	self.awaitingBobberAfterCast = true
	self:SetStatus("Cast sent, waiting for bobber")
end

function Controller:OnBobberSeen(part)
	self.fishingState.currentBobber = part
	self.awaitingBobberAfterCast = false
	self.lastBobberSeenTime = os.clock()
	self.lastValidFishingAction = os.clock()
end

function Controller:RefreshNearbyBobber()
	if os.clock() - self.lastBobberScan < self.BobberScanRate then
		return
	end

	self.lastBobberScan = os.clock()

	local nearest = self:FindNearestNearbyBobber()

	if nearest then
		self:OnBobberSeen(nearest)
		return
	end

	if self.fishingState.currentBobber and not self:HasNearbyCurrentBobber() then
		self.fishingState.currentBobber = nil
	end
end

function Controller:HasNearbyCurrentBobber()
	local bobber = self.fishingState.currentBobber
	if not bobber then return false end
	if not bobber.Parent or not bobber:IsDescendantOf(workspace) then return false end

	return self:IsBobberNearMe(bobber)
end

function Controller:ClearFarBobberIfNeeded()
	local bobber = self.fishingState.currentBobber
	if not bobber then return end

	if not bobber.Parent or not bobber:IsDescendantOf(workspace) then
		self.fishingState.currentBobber = nil
		return
	end

	if not self:IsBobberNearMe(bobber) then
		self.fishingState.currentBobber = nil
		self.fishingState.biteTriggered = false
	end
end

function Controller:TapClick()
	if self.clickedRecently or not self.AutoFishingEnabled then
		return false
	end

	self.clickedRecently = true
	self.lastCastAttemptTime = os.clock()

	task.spawn(function()
		pcall(function()
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			local cx, cy = self:GetScreenCenter()
			VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
			VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
		end)

		task.wait(self.CLICK_COOLDOWN)
		self.clickedRecently = false
	end)

	return true
end

function Controller:HoldCastMouse()
	if not self.AutoFishingEnabled then
		return false
	end

	if self.CastInProgress or os.clock() < self.CastLockUntil then
		return false
	end

	local startWait = os.clock()
	while self.clickedRecently and self.AutoFishingEnabled and os.clock() - startWait < self.MaxCastStartWait do
		task.wait(0.03)
	end

	if self.clickedRecently or not self.AutoFishingEnabled then
		return false
	end

	self.CastInProgress = true
	self.clickedRecently = true
	self:OnCastAttempt()
	self.lastValidFishingAction = os.clock()
	self.lastSuccessfulCastTime = os.clock()
	self.CastLockUntil = os.clock() + self.CastHardCooldown

	task.spawn(function()
		pcall(function()
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

			local cx, cy = self:GetScreenCenter()

			VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
			task.wait(self.RECAST_HOLD_TIME)
			VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
		end)

		task.wait(self.CLICK_COOLDOWN)
		self.clickedRecently = false
		self.CastInProgress = false
	end)

	return true
end

function Controller:PressMashKey(keyCode)
	if not self.AutoFishingEnabled then return end

	VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
	task.wait(self.MASH_KEY_HOLD)
	VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

function Controller:StartHoldingE()
	if not self.AutoFishingEnabled then return end
	if self.interactState.holding then return end
	if os.clock() < self.interactLockoutUntil then return end
	if os.clock() - self.lastInteractHoldTime < self.INTERACT_RETRIGGER_DELAY then return end

	self.interactHoldToken += 1
	local token = self.interactHoldToken

	self.interactState.holding = true
	self.lastInteractHoldTime = os.clock()
	self:SetStatus("Holding E interact")

	task.spawn(function()
		pcall(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
		end)

		local start = os.clock()

		while os.clock() - start < self.INTERACT_HOLD_TIME do
			if not self.AutoFishingEnabled then break end
			if token ~= self.interactHoldToken then break end
			if not self.interactState.gui then break end
			task.wait(0.05)
		end

		pcall(function()
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)

		if token ~= self.interactHoldToken then return end

		self.interactState.holding = false
		self.interactLockoutUntil = os.clock() + self.INTERACT_CLEAR_LOCKOUT

		if self.AutoFishingEnabled then
			self:SetStatus("Finished holding E")
		end
	end)
end

function Controller:StopHoldingE()
	local wasActive = self.interactState.holding or self.interactState.gui ~= nil

	self.interactHoldToken += 1

	pcall(function()
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
	end)

	self.interactState.holding = false
	self.interactState.gui = nil
	self.cachedHoldEGui = nil
	self.interactLockoutUntil = os.clock() + self.INTERACT_CLEAR_LOCKOUT

	if not self.AutoFishingEnabled or not wasActive then return end

	self:SetStatus("Interaction cleared, normal recast")

	task.spawn(function()
		task.wait(0.75)

		if not self.AutoFishingEnabled then return end
		if self.interactState.holding or self.interactState.gui then return end
		if self.fishingState.minigameActive then return end
		if self:HasNearbyCurrentBobber() then return end
		if self.clickedRecently or self.usingBaitAfterCatch then return end
		if not self:CanRecast() then return end

		self.lastRecastTime = os.clock()
		self:SetStatus("Interaction recast")
		self:ResetFishingState()
		self:StartReliableCast("interaction recast")
	end)
end

function Controller:TryStuckCastRecovery()
	if not self.AutoFishingEnabled then return end
	if self.CastInProgress or os.clock() < self.CastLockUntil then return end
	if self.clickedRecently then return end
	if self.usingBaitAfterCatch then return end
	if self.interactState.holding then return end
	if self.interactState.gui then return end
	if self.fishingState.minigameActive then return end
	if self.fishingState.recastQueued then return end

	if self:HasNearbyCurrentBobber() then
		self.awaitingBobberAfterCast = false
		self.lastBobberSeenTime = os.clock()
		self.lastValidFishingAction = os.clock()
		return
	end

	if self.awaitingBobberAfterCast then
		local timeSinceCast = os.clock() - self.lastCastAttemptTime

		if timeSinceCast < self.NO_BOBBER_RETRY_TIME then return end

		if self:CanRecast() then
			self:SetStatus("No bobber found, recasting")
			self:QueueRecast("no bobber found")
		end

		return
	end

	local idleTime = os.clock() - self.lastValidFishingAction

	if idleTime >= self.IDLE_RECAST_TIME and self:CanRecast() then
		self:SetStatus("Fishing idle, recasting")
		self:QueueRecast("idle recovery")
	end
end

function Controller:IsGuiActuallyVisible(guiObject)
	if not guiObject then return false end

	local current = guiObject
	while current and current ~= PlayerGui do
		if current:IsA("GuiObject") and not current.Visible then
			return false
		end
		current = current.Parent
	end

	return true
end

function Controller:FindHoldEGui()
	for _, obj in ipairs(PlayerGui:GetDescendants()) do
		if self:IsHoldETextObject(obj) and self:IsGuiActuallyVisible(obj) then
			return obj
		end
	end

	return nil
end

function Controller:IsHoldETextObject(obj)
	if not obj then
		return false
	end

	if not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then
		return false
	end

	local text = tostring(obj.Text or ""):upper()
	text = text:gsub("%s+", " ")

	return text:find("HOLD E")
		or text:find("HOLD %[E%]")
		or text:find("E TO INTERACT")
		or text:find("INTERACT")
		or text:find("OPEN")
		or text:find("CHEST")
end

function Controller:TryStartInstantInteract(obj)
	if not self.AutoFishingEnabled then
		return
	end

	if self.interactState.holding then
		return
	end

	if os.clock() < self.interactLockoutUntil then
		return
	end

	if not self:IsHoldETextObject(obj) then
		return
	end

	task.defer(function()
		if not self.AutoFishingEnabled then
			return
		end

		if not obj or not obj.Parent then
			return
		end

		if not self:IsGuiActuallyVisible(obj) then
			return
		end

		if self.interactState.holding then
			return
		end

		self.cachedHoldEGui = obj
		self.interactState.gui = obj
		self:StartHoldingE()
	end)
end

function Controller:GetCachedHoldEGui()
	local now = os.clock()

	if self.cachedHoldEGui and self.cachedHoldEGui.Parent and self:IsGuiActuallyVisible(self.cachedHoldEGui) then
		if self:IsHoldETextObject(self.cachedHoldEGui) then
			return self.cachedHoldEGui
		end
	end

	if now - self.lastHoldGUIScan < self.HoldGUIScanRate then
		return self.cachedHoldEGui
	end

	self.lastHoldGUIScan = now
	self.cachedHoldEGui = self:FindHoldEGui()
	return self.cachedHoldEGui
end

function Controller:CanRecast()
	if self.CastInProgress then return false end
	if os.clock() < self.CastLockUntil then return false end
	if self.clickedRecently then return false end
	if self.usingBaitAfterCatch then return false end
	if self.interactState.holding then return false end
	if self.fishingState.minigameActive then return false end
	if self:HasNearbyCurrentBobber() then return false end

	return (os.clock() - self.lastRecastTime) >= self.RECAST_COOLDOWN
end

function Controller:IsCharacterStableForCast()
	if not self:IsAlive() then return false end

	local hum = self.Humanoid
	local root = self.RootPart

	if hum.Health <= 0 then return false end

	local state = hum:GetState()
	if self.BadStatesForCast[state] then return false end
	if hum.PlatformStand or hum.Sit then return false end

	local vel = root.AssemblyLinearVelocity
	local horizontal = Vector3.new(vel.X, 0, vel.Z)

	if horizontal.Magnitude > self.MAX_VELOCITY_FOR_CAST then return false end
	if math.abs(vel.Y) > 6 then return false end

	return true
end

function Controller:WaitUntilCharacterStable()
	local startTime = os.clock()
	local stableSince = nil

	while os.clock() - startTime < self.STABILITY_TIMEOUT do
		if self:IsCharacterStableForCast() then
			if not stableSince then
				stableSince = os.clock()
			end

			if os.clock() - stableSince >= self.STABLE_TIME_REQUIRED then
				return true
			end
		else
			stableSince = nil
		end

		task.wait(0.05)
	end

	return false
end

function Controller:RecountFish()
	local cod = 0
	local snapper = 0
	local bass = 0

	if self.Backpack and self.Backpack.Parent then
		for _, item in ipairs(self.Backpack:GetChildren()) do
			local quantityObj = item:FindFirstChild("Quantity")
			local amount = 0

			if quantityObj and quantityObj:IsA("ValueBase") then
				amount = tonumber(quantityObj.Value) or 0
			end

			if item.Name == "Cod" then
				cod += amount
			elseif item.Name == "Snapper" then
				snapper += amount
			elseif item.Name == "Bass" then
				bass += amount
			end
		end
	end

	self.FishCounts.Cod = cod
	self.FishCounts.Snapper = snapper
	self.FishCounts.Bass = bass
	self.FishCounts.Total = cod + snapper + bass
end

function Controller:BindBackpackWatcher()
	self:DisconnectBackpackConnections()
	self:CacheBackpack()
	self:RecountFish()
	self:BindWoodQuantityWatcher()

	local function watchItem(item)
		if not self.FishNames[item.Name] then return end

		local quantityObj = item:FindFirstChild("Quantity")
		if quantityObj and quantityObj:IsA("ValueBase") then
			table.insert(self.BackpackConnections, quantityObj:GetPropertyChangedSignal("Value"):Connect(function()
				self:RecountFish()
			end))
		end
	end

	for _, item in ipairs(self.Backpack:GetChildren()) do
		watchItem(item)
	end

	table.insert(self.BackpackConnections, self.Backpack.ChildAdded:Connect(function(child)
		if self.FishNames[child.Name] then
			watchItem(child)
			self:RecountFish()
		end
	end))

	table.insert(self.BackpackConnections, self.Backpack.ChildRemoved:Connect(function(child)
		if self.FishNames[child.Name] then
			self:RecountFish()
		end
	end))
end

function Controller:GetDialogueRemoteAndDaniel()
	local replicatedStorage = game:GetService("ReplicatedStorage")
	local remotes = replicatedStorage:FindFirstChild("Remotes")
	if not remotes then return nil, nil end

	local dialogueRemote = remotes:FindFirstChild("DialogueRemote")
	if not dialogueRemote then return nil, nil end

	local npcFolder = workspace:FindFirstChild("NPC")
	if not npcFolder then return nil, nil end

	local daniel = npcFolder:FindFirstChild("Daniel")
	if not daniel then return nil, nil end

	return dialogueRemote, daniel
end

function Controller:SellFishIfNeeded()
	if not self.AutoSellEnabled then return end
	if os.clock() - self.lastSellCheck < self.SELL_CHECK_COOLDOWN then return end

	self.lastSellCheck = os.clock()
	self:RecountFish()

	if self.FishCounts.Total <= 0 then return end

	local dialogueRemote, daniel = self:GetDialogueRemoteAndDaniel()
	if not dialogueRemote or not daniel then return end

	for fishName, actionName in pairs(self.SellFishActions) do
		if (self.FishCounts[fishName] or 0) > 0 then
			self:SetStatus("Selling " .. fishName)

			pcall(function()
				dialogueRemote:FireServer("Action", actionName, daniel)
			end)

			task.wait(0.15)
		end
	end
end

