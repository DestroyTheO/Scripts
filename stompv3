local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local playersFolder = Workspace:WaitForChild("Players")

---------------------------------------------------------------------
-- SETTINGS
---------------------------------------------------------------------

local Y_OFFSET = 1
local STOMP_INTERVAL = 0.1

---------------------------------------------------------------------
-- REMOTES
---------------------------------------------------------------------

local AdminEvent = ReplicatedStorage
    :WaitForChild("NewAdminRemotes")
    :WaitForChild("AdminAction")

local MainEvent = ReplicatedStorage
    :WaitForChild("MainRemotes")
    :WaitForChild("MainRemoteEvent")

---------------------------------------------------------------------
-- STATE
---------------------------------------------------------------------

local currentTarget = nil
local teleportedToCurrent = false
local stompTimer = 0

local waitingForRespawn = false

---------------------------------------------------------------------
-- HELPERS
---------------------------------------------------------------------

local function getLocalRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
end

local function getTargetTorso(model)
    if not model then
        return nil
    end

    return model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(model)
    if not model then
        return nil
    end

    return model:FindFirstChildOfClass("Humanoid")
end

local function validTarget(model)
    if not model or not model.Parent then
        return false
    end

    if model.Name == LocalPlayer.Name then
        return false
    end

    -- NEVER target somebody already stomped
    if model:GetAttribute("Stomped") == true then
        return false
    end

    local humanoid = getHumanoid(model)
    local torso = getTargetTorso(model)

    return humanoid
        and humanoid.Health > 0
        and torso ~= nil
end

---------------------------------------------------------------------
-- NEXT TARGET
---------------------------------------------------------------------

local function getNextTarget()
    for _, model in ipairs(playersFolder:GetChildren()) do
        if model:IsA("Model") and validTarget(model) then
            return model
        end
    end

    return nil
end

---------------------------------------------------------------------
-- TARGET RESET
---------------------------------------------------------------------

local function clearTarget()
    currentTarget = nil
    teleportedToCurrent = false
    stompTimer = 0
end

---------------------------------------------------------------------
-- CHECK RESPAWNS
---------------------------------------------------------------------

local function allPlayersRespawned()
    local foundOtherPlayer = false

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            foundOtherPlayer = true

            local model = playersFolder:FindFirstChild(player.Name)

            if not model then
                return false
            end

            local humanoid = getHumanoid(model)
            local torso = getTargetTorso(model)

            if not humanoid
                or humanoid.Health <= 0
                or not torso
            then
                return false
            end
        end
    end

    return foundOtherPlayer
end

---------------------------------------------------------------------
-- KNOCK
---------------------------------------------------------------------

local function knockAll()
    pcall(function()
        AdminEvent:FireServer(
            "KnockAll",
            {}
        )
    end)
end

---------------------------------------------------------------------
-- STOMP
---------------------------------------------------------------------

local function stomp()
    pcall(function()
        MainEvent:FireServer("Stomp")
    end)
end

---------------------------------------------------------------------
-- TELEPORT ONCE
---------------------------------------------------------------------

local function teleportToTarget(model)
    local myRoot = getLocalRoot()
    local torso = getTargetTorso(model)

    if not myRoot or not torso then
        return false
    end

    -- Check once more before teleporting
    if model:GetAttribute("Stomped") == true then
        return false
    end

    local rx, ry, rz = myRoot.CFrame:ToEulerAnglesXYZ()

    -- INSTANT teleport above torso ONCE
    myRoot.CFrame =
        CFrame.new(
            torso.Position + Vector3.new(0, Y_OFFSET, 0)
        )
        * CFrame.Angles(rx, ry, rz)

    return true
end

---------------------------------------------------------------------
-- MAIN
---------------------------------------------------------------------

RunService.Heartbeat:Connect(function(dt)

    -----------------------------------------------------------------
    -- RESPAWN WAVE
    -----------------------------------------------------------------

    if not allPlayersRespawned() then
        waitingForRespawn = true

    elseif waitingForRespawn then
        waitingForRespawn = false

        clearTarget()

        -- Everyone has returned
        knockAll()

        print("[AutoStomp] Everyone respawned -> KnockAll")
    end

    -----------------------------------------------------------------
    -- FIND TARGET
    -----------------------------------------------------------------

    if not currentTarget then
        currentTarget = getNextTarget()
        teleportedToCurrent = false
        stompTimer = 0

        if not currentTarget then
            return
        end

        print("[AutoStomp] New target:", currentTarget.Name)
    end

    -----------------------------------------------------------------
    -- TARGET DISAPPEARED
    -----------------------------------------------------------------

    if not currentTarget.Parent then
        clearTarget()
        return
    end

    -----------------------------------------------------------------
    -- STOMPED -> IMMEDIATELY MOVE TO NEXT
    -----------------------------------------------------------------

    if currentTarget:GetAttribute("Stomped") == true then
        print("[AutoStomp] Finished:", currentTarget.Name)

        clearTarget()

        -- Find next target immediately
        currentTarget = getNextTarget()

        if currentTarget then
            print("[AutoStomp] Next target:", currentTarget.Name)
        end

        return
    end

    -----------------------------------------------------------------
    -- HEALTH CHECK
    -----------------------------------------------------------------

    local humanoid = getHumanoid(currentTarget)

    if not humanoid or humanoid.Health <= 0 then
        clearTarget()
        return
    end

    -----------------------------------------------------------------
    -- TELEPORT ONLY ONCE FOR THIS TARGET
    -----------------------------------------------------------------

    if not teleportedToCurrent then
        if teleportToTarget(currentTarget) then
            teleportedToCurrent = true
        else
            clearTarget()
            return
        end
    end

    -----------------------------------------------------------------
    -- STOMP WHILE WAITING FOR STOMPED ATTRIBUTE
    -----------------------------------------------------------------

    stompTimer += dt

    if stompTimer >= STOMP_INTERVAL then
        stompTimer = 0

        if currentTarget:GetAttribute("Stomped") ~= true then
            stomp()
        else
            clearTarget()
        end
    end
end)
