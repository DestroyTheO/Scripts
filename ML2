--========================================================
-- PET AUTOMATION
--========================================================

local SellDelay = 0.1
local EvolveDelay = 0.5

local SelectedSellFolders = {
    Basic = true,
    Rare = true,
    Advanced = true,
    Epic = true,
}

local SelectedEvolveFolders = {
    Unique = true,
}

local SpecificSellPetNames = {
    "Reactor Beast",
    "Plasma Ravager",
    "Titan Reactor",
}

local SelectedSpecificSellPets = {
    ["Reactor Beast"] = true,
    ["Plasma Ravager"] = true,
    ["Titan Reactor"] = true,
}

local SellingPets = setmetatable({}, { __mode = "k" })

local function ListToSet(List)
    local Set = {}

    if type(List) == "table" then
        for _, Value in ipairs(List) do
            Set[Value] = true
        end
    end

    return Set
end

local function IsProtectedPet(Pet)
    return string.lower(Pet.Name) == "moonlight"
end

local function ShouldSellPet(Pet)
    if not Pet or not Pet.Parent then
        return false
    end

    if IsProtectedPet(Pet) then
        return false
    end

    -- Sell everything in selected rarity folders OR specifically selected pet names.
    return SelectedSellFolders[Pet.Parent.Name] == true
        or SelectedSpecificSellPets[Pet.Name] == true
end

local function SellPet(Pet)
    if not AutoSell then
        return
    end

    if not Pet or not Pet.Parent then
        return
    end

    if not ShouldSellPet(Pet) then
        return
    end

    if SellingPets[Pet] then
        return
    end

    SellingPets[Pet] = true

    print("[Auto Sell]", Pet.Parent.Name, "->", Pet.Name)

    pcall(function()
        SellPetEvent:FireServer(
            "sellPet",
            Pet
        )
    end)

    task.delay(0.5, function()
        SellingPets[Pet] = nil
    end)
end

local function ScanSellFolders()
    if not AutoSell then
        return
    end

    task.spawn(function()
        for _, FolderName in ipairs(PetFolderNames) do
            local Folder = PetFolderObjects[FolderName]

            if Folder then
                for _, Pet in ipairs(Folder:GetChildren()) do
                    if not AutoSell then
                        return
                    end

                    if ShouldSellPet(Pet) then
                        SellPet(Pet)
                        task.wait(SellDelay)
                    end
                end
            end
        end
    end)
end

for _, FolderName in ipairs(PetFolderNames) do
    local Folder = PetFolderObjects[FolderName]

    Folder.ChildAdded:Connect(function(Pet)
        task.wait(0.15)

        if AutoSell and ShouldSellPet(Pet) then
            SellPet(Pet)
        end
    end)
end

task.spawn(function()
    while true do
        if AutoEvolve then
            local CheckedNames = {}

            for _, FolderName in ipairs(PetFolderNames) do
                if not AutoEvolve then
                    break
                end

                if SelectedEvolveFolders[FolderName] then
                    local Folder = PetFolderObjects[FolderName]

                    if Folder then
                        for _, Pet in ipairs(Folder:GetChildren()) do
                            if not AutoEvolve then
                                break
                            end

                            if not SelectedEvolveFolders[FolderName] then
                                break
                            end

                            if not CheckedNames[Pet.Name] then
                                CheckedNames[Pet.Name] = true

                                print("[Auto Evolve]", FolderName, "->", Pet.Name)

                                pcall(function()
                                    PetEvolveEvent:FireServer(
                                        "evolvePet",
                                        Pet.Name
                                    )
                                end)
                            end
                        end
                    end
                end
            end

            task.wait(EvolveDelay)
        else
            task.wait(0.1)
        end
    end
end)

