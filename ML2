-- AUTO OPEN CRYSTAL
--========================================================

local CrystalDelay = 0.5
local CrystalBulkAmount = 3

local MapCrystalsFolder = Workspace:WaitForChild("mapCrystalsFolder")
local CrystalNames = {}

local function RefreshCrystalNames()
    table.clear(CrystalNames)

    for _, Crystal in ipairs(MapCrystalsFolder:GetChildren()) do
        table.insert(CrystalNames, Crystal.Name)
    end

    table.sort(CrystalNames)
end

RefreshCrystalNames()

local CrystalName = table.find(CrystalNames, "Industrial Crystal")
    and "Industrial Crystal"
    or CrystalNames[1]

task.spawn(function()
    while true do
        if AutoOpenCrystal and CrystalName then
            pcall(function()
                OpenCrystalRemote:InvokeServer(
                    "openCrystalBulk",
                    CrystalName,
                    CrystalBulkAmount
                )
            end)

            task.wait(CrystalDelay)
        else
            task.wait(0.1)
        end
    end
end)

--========================================================
-- KEEP WEIGHT EQUIPPED
--========================================================

local ToolName = "Weight"

local Character = Player.Character
local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

local function GetWeight()
    if Character then
        local Equipped = Character:FindFirstChild(ToolName)

        if Equipped and Equipped:IsA("Tool") then
            return Equipped
        end
    end

    local Backpack = Player:FindFirstChild("Backpack")

    if Backpack then
        local Tool = Backpack:FindFirstChild(ToolName)

        if Tool and Tool:IsA("Tool") then
            return Tool
        end
    end

    return nil
end

local function KeepEquipped()
    if not AutoEquipWeight then
        return
    end

    if not Character or not Character.Parent then
        return
    end

    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    -- Already equipped
    local Equipped = Character:FindFirstChild(ToolName)

    if Equipped and Equipped:IsA("Tool") then
        return
    end

    local Tool = GetWeight()

    if Tool and Tool.Parent ~= Character then
        pcall(function()
            Humanoid:EquipTool(Tool)
        end)
    end
end

--========================================================
-- VOID PLATFORM
--========================================================

local VOID_Y = 1000
local MAX_DISTANCE = 30

local OriginalFallenPartsDestroyHeight =
    Workspace.FallenPartsDestroyHeight

local VoidPlatform
local CreatedVoidPlatform = false
local RootPart

local function CreateVoidPlatform()
    if VoidPlatform and VoidPlatform.Parent then
        return VoidPlatform
    end

    VoidPlatform = Workspace:FindFirstChild("VoidPlatform")

    if not VoidPlatform then
        VoidPlatform = Instance.new("Part")

        VoidPlatform.Name = "VoidPlatform"

        VoidPlatform.Size = Vector3.new(
            40,
            2,
            40
        )

        VoidPlatform.Anchored = true
        VoidPlatform.CanCollide = true
        VoidPlatform.Transparency = 0

        VoidPlatform.Position = Vector3.new(
            0,
            VOID_Y,
            0
        )

        VoidPlatform.Parent = Workspace

        CreatedVoidPlatform = true
    end

    return VoidPlatform
end

local function TeleportToVoidPlatform()
    if not VoidLock then
        return
    end

    local Platform = CreateVoidPlatform()

    if RootPart and RootPart.Parent and Platform then
        RootPart.CFrame =
            Platform.CFrame
            * CFrame.new(0, 4, 0)

        RootPart.AssemblyLinearVelocity = Vector3.zero
        RootPart.AssemblyAngularVelocity = Vector3.zero
    end
end

local function EnableVoidLock()
    VoidLock = true

    pcall(function()
        Workspace.FallenPartsDestroyHeight = 0 / 0
    end)

    CreateVoidPlatform()

    task.defer(TeleportToVoidPlatform)
end

local function DisableVoidLock()
    VoidLock = false

    pcall(function()
        Workspace.FallenPartsDestroyHeight =
            OriginalFallenPartsDestroyHeight
    end)

    if CreatedVoidPlatform then
        if VoidPlatform then
            VoidPlatform:Destroy()
        end

        VoidPlatform = nil
        CreatedVoidPlatform = false
    end
end

--========================================================
-- CHARACTER HANDLING
--========================================================

local function SetupCharacter(NewCharacter)
    Character = NewCharacter

    Humanoid =
        NewCharacter:WaitForChild("Humanoid")

    RootPart =
        NewCharacter:WaitForChild("HumanoidRootPart")

    Player:WaitForChild("Backpack")

    task.wait(0.25)

    if AutoEquipWeight then
        KeepEquipped()
    end

    if VoidLock then
        task.wait(0.25)
        TeleportToVoidPlatform()
    end
end

if Player.Character then
    task.spawn(
        SetupCharacter,
        Player.Character
    )
end

Player.CharacterAdded:Connect(function(NewCharacter)
    SetupCharacter(NewCharacter)
end)

--// Re-equip immediately if Weight is returned to Backpack
Player:WaitForChild("Backpack").ChildAdded:Connect(function(Item)
    if AutoEquipWeight and Item.Name == ToolName then
        task.defer(KeepEquipped)
    end
end)

--========================================================
-- HEARTBEAT
--========================================================

local LastWeightCheck = 0

RunService.Heartbeat:Connect(function()
    local Now = os.clock()

    --// Weight checker
    if AutoEquipWeight then
        if Now - LastWeightCheck >= 0.1 then
            LastWeightCheck = Now

            KeepEquipped()
        end
    end

    --// Void lock
    if VoidLock then
        if RootPart
            and RootPart.Parent
            and VoidPlatform
            and VoidPlatform.Parent
        then
            local Distance =
                (RootPart.Position - VoidPlatform.Position).Magnitude

            if Distance > MAX_DISTANCE then
                TeleportToVoidPlatform()
            end
        end
    end
end)

